  }

  /* log 面板：每行 = 一条真实记录 */
  .log-panel {
    border: 1px solid var(--hairline);
  }

  .log-head {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--hairline);
