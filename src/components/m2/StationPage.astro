---
// M2 变体 B — 地面站（Ground Station）纯版页面主体（docs/10 裁决：对照组，不融合年鉴元素）
// 双语组件：Props { locale }；叙事文案取 src/data/m2-station.copy.ts + home.ts/home.zh.ts（原型正式文案）
// mono 编号语言（MOD./STG./CAP./IND./城市代码/KM/UTC/坐标/时间戳）不翻译（docs/10 调性设计）
// 数据唯一来源 src/data/coverage.ts；装饰图形唯一来源 src/lib/arcfield.ts
import Base from '../../layouts/Base.astro';
import { cities, events, metrics } from '../../data/coverage';
import { arcBetween, generateArcfield, hashString, project } from '../../lib/arcfield';
import { stationCopy, type StationLocale } from '../../data/m2-station.copy';
import { hero as heroEn, platform as platformEn, industries as industriesEn, belief as beliefEn } from '../../data/home';
import { hero as heroZh, platform as platformZh, industries as industriesZh, belief as beliefZh } from '../../data/home.zh';

interface Props {
  locale: StationLocale;
}

const { locale } = Astro.props;
const c = stationCopy[locale];
const homeHero = locale === 'zh' ? heroZh : heroEn;
const homePlatform = locale === 'zh' ? platformZh : platformEn;
const homeIndustries = locale === 'zh' ? industriesZh : industriesEn;
const homeBelief = locale === 'zh' ? beliefZh : beliefEn;

// 字典模板替换（{n}/{asOf}/{km}/{from}/{to}）
const t = (s: string, vars: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

const fmt = (n: number) => n.toLocaleString('en-US');
const coord = (n: number) => n.toFixed(4).replace('-', '−');
// 里程表式补零（服务端与客户端 fmtPad 同款口径）
const pad = (n: number, len: number) =>
  String(Math.round(n)).padStart(len, '0').replace(/\B(?=(\d{3})+(?!\d))/g, ',');
const pad2 = (n: number) => String(n).padStart(2, '0');

const buildStamp = new Date().toISOString().slice(0, 16).replace('T', ' ');
const asOf = metrics.asOf;

/* ---------- 平面点阵地图（等距圆柱投影 1000×500） ---------- */
const MAP_W = 1000;
const MAP_H = 500;
const REGION_OF: Record<string, string> = {
  ID: 'sea', SG: 'sea', TH: 'sea', VN: 'sea', PH: 'sea', MY: 'sea',
  AE: 'mea', SA: 'mea', KE: 'mea', NG: 'mea',
  BR: 'latam', MX: 'latam',
};

const cityPts = cities.map((cty) => {
  const [x, y] = project(cty.lat, cty.lng, MAP_W, MAP_H);
  return {
    ...cty,
    x,
    y,
    region: REGION_OF[cty.country],
    probe: `${cty.code} ${cty.name.toUpperCase()} · ${coord(cty.lat)}, ${coord(cty.lng)} · ${cty.country}`,
  };
});
const ptByCode = Object.fromEntries(cityPts.map((cty) => [cty.code, cty]));

const consoleArcs = events.map((e) => {
  const a = ptByCode[e.from];
  const b = ptByCode[e.to];
  const lift = b.x >= a.x ? -0.25 : 0.25; // 拱向上（SVG y 轴向下）
  return {
    ...e,
    d: arcBetween(a.x, a.y, b.x, b.y, lift),
    region: a.region,
    probe: `ARC ${e.from}→${e.to} · ${fmt(e.km)} KM · ${e.utc}`,
  };
});

const totalKm = events.reduce((s, e) => s + e.km, 0);
const maxKm = Math.max(...events.map((e) => e.km));

// 经纬网（30° 网格 = 测量基准图元）
const gratX = [-150, -120, -90, -60, -30, 0, 30, 60, 90, 120, 150].map((lng) => ((lng + 180) / 360) * MAP_W);
const gratY = [-60, -30, 0, 30, 60].map((lat) => ((90 - lat) / 180) * MAP_H);

/* ---------- 可操作覆盖台：分区读数（构建时预计算；label 取字典，顺序锁死） ---------- */
const regions = [
  { id: 'all', label: c.coverage.regions[0] },
  { id: 'sea', label: c.coverage.regions[1] },
  { id: 'mea', label: c.coverage.regions[2] },
  { id: 'latam', label: c.coverage.regions[3] },
].map((r) => {
  const cs = r.id === 'all' ? cityPts : cityPts.filter((cty) => cty.region === r.id);
  const es = r.id === 'all' ? consoleArcs : consoleArcs.filter((e) => e.region === r.id);
  return { ...r, nodes: cs.length, deliveries: es.length, km: es.reduce((s, e) => s + e.km, 0) };
});

/* ---------- Hero log 流（12 城 plot + 12 条真实交付记录，构建时注入；raw feed 保持英文 mono） ---------- */
const logLines = [
  ...cityPts.map((cty) => `+ NODE ${cty.code} · ${cty.name.toUpperCase()} · ${coord(cty.lat)}, ${coord(cty.lng)} · ${cty.country}`),
  ...events.map((e) => `» ARC ${e.from}→${e.to} · ${fmt(e.km)} KM · ${e.utc}`),
  `EOF · ${cities.length + events.length} RECORDS · STANDBY`,
];

/* ---------- 信任数字（specimen；label/unit 取字典，顺序与 metrics 锁死） ---------- */
const specs = [
  { ...c.telemetry.specs[0], value: metrics.citiesCovered, display: fmt(metrics.citiesCovered) },
  { ...c.telemetry.specs[1], value: metrics.countries, display: fmt(metrics.countries) },
  { ...c.telemetry.specs[2], value: metrics.tasksCompleted, display: fmt(metrics.tasksCompleted) },
];

/* ---------- 流程区：用第一条真实交付事件做端到端 trace（弧=事件，端点=城市，刻度=校验） ---------- */
const trace = events[0]; // JKT→SIN
const traceFrom = ptByCode[trace.from];
const traceTo = ptByCode[trace.to];
const traceProbe = `TRACE ${trace.from}→${trace.to} · ${fmt(trace.km)} KM · ${trace.utc}`;
const PIPE = { x1: 70, x2: 930, y: 190, lift: -0.18 };
const pipeD = arcBetween(PIPE.x1, PIPE.y, PIPE.x2, PIPE.y, PIPE.lift);
// 二次贝塞尔 t=0.5 中点（verify 刻度位置）
const pipeCy = PIPE.y + (PIPE.x2 - PIPE.x1) * PIPE.lift;
const pipeMidY = 0.25 * PIPE.y + 0.5 * pipeCy + 0.25 * PIPE.y;
const pipeMidX = (PIPE.x1 + PIPE.x2) / 2;

const stages = [
  {
    id: 'STG-01 / COLLECT',
    body: c.pipeline.stages[0],
    param: `ORIGIN ${trace.from} · ${coord(traceFrom.lat)}, ${coord(traceFrom.lng)}`,
  },
  {
    id: 'STG-02 / VERIFY',
    body: c.pipeline.stages[1],
    param: `TIMESTAMP ${trace.utc} · UTC`,
  },
  {
    id: 'STG-03 / DELIVER',
    body: c.pipeline.stages[2],
    param: `DEST ${trace.to} · ${fmt(trace.km)} KM VERIFIED`,
  },
];

/* ---------- MOD-05 CAPABILITIES：六能力 = 六台子仪器（原型 platform.features） ----------
   微图形种子 = 能力英文 title（两语言同种子同图形，确定性可复现——弧场宪法） */
const CAP_FIG = { w: 220, h: 120, count: 7 };
const capUnits = homePlatform.features.map((f, i) => {
  const seed = platformEn.features[i].title;
  return {
    id: `CAP-${pad2(i + 1)}`,
    title: f.title,
    body: f.description,
    seed,
    hex: hashString(seed).toString(16).toUpperCase().padStart(8, '0'),
    paths: generateArcfield({ width: CAP_FIG.w, height: CAP_FIG.h, count: CAP_FIG.count, amplitude: 0.22, seed }),
  };
});

/* ---------- MOD-06 SECTORS：行业索引行（原型 industries.items，Mapping 首位） ----------
   行图形种子 = 行业 key（en/zh 数据文件 key 相同）；mono 数据行 = 该图形的真实生成参数 */
const IND_FIG = { w: 160, h: 72, count: 5 };
const indRows = homeIndustries.items.map((it, i) => ({
  id: `IND-${pad2(i + 1)}`,
  label: it.label,
  desc: it.description,
  key: it.key,
  hex: hashString(it.key).toString(16).toUpperCase().padStart(8, '0'),
  data: `IDX ${it.key.toUpperCase()} · SEED 0x${hashString(it.key).toString(16).toUpperCase().padStart(8, '0')} · FIELD ${pad2(IND_FIG.count)} ARCS · GEN ARCFIELD`,
  paths: generateArcfield({ width: IND_FIG.w, height: IND_FIG.h, count: IND_FIG.count, amplitude: 0.2, seed: it.key }),
}));

const MOD_COUNT = 6;
---

<Base noindex lang={locale} title={c.pageTitle} description={homeHero.description}>
  <div class="station">
    <!-- 页缘 ruler 刻度列（随滚动更新读数；三图元宪法：刻度=测量基准） -->
    <div class="ruler ruler-left" aria-hidden="true">
      <span id="depth-readout" class="ruler-readout mono-caption">DEPTH 000%</span>
    </div>
    <div class="ruler ruler-right" aria-hidden="true">
      <span id="mod-readout" class="ruler-readout mono-caption">MOD-01 / {pad2(MOD_COUNT)}</span>
    </div>

    <!-- proof-of-life 探针卡（全站共用，JS 定位；键盘 focus 同样触发） -->
    <div id="probe" class="probe mono-caption" hidden></div>

    <main id="main">
      <!-- SECTION: MOD-01 / UPLINK — hero 开机序列 -->
      <section id="mod-01" class="mod mod-hero shell" data-mod="MOD-01">
        <header class="mod-head">
          <span class="mod-id mono-caption">MOD-01 / UPLINK</span>
          <span class="mod-rule" aria-hidden="true"></span>
          <span class="mod-status mono-caption"><i class="lamp" aria-hidden="true"></i>LINK OK</span>
        </header>

        <p class="hero-status mono-caption">
          <span id="hero-status-text">ARCLINK GROUND STATION · LINK ESTABLISHED · {buildStamp} UTC</span><span class="caret" aria-hidden="true"></span>
        </p>

        <h1 class="hero-title">
          {c.hero.title.map((line) => (
            <span class="hero-line"><span class="hero-line-inner">{line}</span></span>
          ))}
        </h1>

        <div class="hero-deck">
          <div class="hero-copy">
            <p class="hero-sub">{homeHero.description}</p>
            <div id="hero-log" class="log-panel" aria-label="Delivery log">
              <p class="log-head mono-caption">DELIVERY LOG · {logLines.length - 1} RECORDS</p>
              <div class="log-viewport">
                <ul id="hero-log-list" class="log-list">
                  {logLines.map((line) => (
                    <li class="log-line mono-caption">{line}</li>
                  ))}
                </ul>
              </div>
            </div>
            <p class="hero-cue mono-caption">{c.hero.cue}</p>
          </div>

          <div id="globe-wrap" class="globe-wrap">
            <canvas id="globe-canvas" class="globe-canvas" aria-hidden="true"></canvas>
            <svg
              id="hero-map"
              class="globe-fallback"
              viewBox={`0 0 ${MAP_W} ${MAP_H}`}
              role="img"
              aria-label={`Flat coverage map: ${cities.length} city nodes and ${events.length} delivery arcs`}
            >
              {gratX.map((x) => (
                <line class="grat" x1={x} y1="0" x2={x} y2={MAP_H} />
              ))}
              {gratY.map((y) => (
                <line class="grat" x1="0" y1={y} x2={MAP_W} y2={y} />
              ))}
              {consoleArcs.map((a) => (
                <path class="h-arc" d={a.d} />
              ))}
              {cityPts.map((cty) => (
                <g class="map-dot-g" data-probe={cty.probe} tabindex="0" role="img" aria-label={cty.probe} data-lat={cty.lat} data-lng={cty.lng}>
                  <circle class="dot-hit" cx={cty.x} cy={cty.y} r="14" />
                  <circle class="map-dot" cx={cty.x} cy={cty.y} r="4" data-lat={cty.lat} data-lng={cty.lng} />
                </g>
              ))}
            </svg>
            <p class="globe-tag mono-caption">{cities.length} NODES · {c.hero.globeTagLegend}</p>
          </div>
        </div>
      </section>

      <!-- SECTION: MOD-02 / TELEMETRY — 信任数字（specimen 式） -->
      <section id="mod-02" class="mod shell" data-mod="MOD-02">
        <header class="mod-head">
          <span class="mod-id mono-caption">MOD-02 / TELEMETRY</span>
          <span class="mod-rule" aria-hidden="true"></span>
          <span class="mod-status mono-caption"><i class="lamp" aria-hidden="true"></i>AS OF {asOf}</span>
        </header>

        <h2 class="mod-title rise">{c.telemetry.title}</h2>

        <div class="spec-grid rise">
          {specs.map((s) => (
            <div class="spec">
              <span class="spec-label mono-caption">{s.label}</span>
              <span class="spec-num" data-value={s.value}>{s.display}</span>
              <span class="spec-unit mono-caption">{s.unit}</span>
            </div>
          ))}
          <div class="spec spec-spark">
            <span class="spec-label mono-caption">{t(c.telemetry.sparkLabel, { n: events.length })}</span>
            <svg class="spark" viewBox="0 0 372 84" role="img" aria-label={`Kilometres per delivery, last ${events.length} records`}>
              <line class="grat" x1="0" y1="78.5" x2="372" y2="78.5" />
              {events.map((e, i) => {
                const h = Math.max(3, (e.km / maxKm) * 66);
                return (
                  <rect
                    class="spark-bar"
                    x={i * 31 + 2}
                    y={78 - h}
                    width="22"
                    height={h}
                    data-probe={`ARC ${e.from}→${e.to} · ${fmt(e.km)} KM · ${e.utc}`}
                    tabindex="0"
                    role="img"
                    aria-label={`${e.from} to ${e.to}, ${fmt(e.km)} kilometres, ${e.utc}`}
                  />
                );
              })}
            </svg>
            <span class="spec-unit mono-caption">{t(c.telemetry.sparkSum, { km: fmt(totalKm) })}</span>
          </div>
        </div>

        <p class="spec-note mono-caption rise">{t(c.telemetry.note, { asOf, n: events.length })}</p>
      </section>

      <!-- 幕间 1（疏，display 声） -->
      <section class="interstice shell">
        <p class="interstice-line rise">{c.interstice1.line}</p>
        <p class="interstice-cap mono-caption rise">{t(c.interstice1.cap, { asOf })}</p>
      </section>

      <!-- SECTION: MOD-03 / PIPELINE — 流程（采集→验证→交付），一条真实事件的端到端 trace -->
      <section id="mod-03" class="mod shell" data-mod="MOD-03">
        <header class="mod-head">
          <span class="mod-id mono-caption">MOD-03 / PIPELINE</span>
          <span class="mod-rule" aria-hidden="true"></span>
          <span class="mod-status mono-caption"><i class="lamp" aria-hidden="true"></i>TRACE {trace.from}→{trace.to}</span>
        </header>

        <h2 class="mod-title rise">{c.pipeline.title}</h2>
        <p class="mod-sub rise">{t(c.pipeline.sub, { from: traceFrom.name, to: traceTo.name })}</p>

        <figure class="pipe-fig rise" aria-label={traceProbe}>
          <svg viewBox="0 0 1000 250" role="img" aria-label={`Delivery trace from ${traceFrom.name} to ${traceTo.name}`}>
            <line class="grat" x1="0" y1="232.5" x2="1000" y2="232.5" />
            {Array.from({ length: 21 }, (_, i) => (
              <line class="grat" x1={i * 50} y1="228" x2={i * 50} y2="237" />
            ))}
            <path id="pipe-path" class="pipe-path" d={pipeD} />
            <g data-probe={traceFrom.probe} tabindex="0" role="img" aria-label={traceFrom.probe}>
              <circle class="dot-hit" cx={PIPE.x1} cy={PIPE.y} r="16" />
              <circle class="pipe-dot" cx={PIPE.x1} cy={PIPE.y} r="5" />
            </g>
            <g data-probe={`QC CHECKPOINT · ${trace.utc}`} tabindex="0" role="img" aria-label={`QC checkpoint, ${trace.utc}`}>
              <circle class="dot-hit" cx={pipeMidX} cy={pipeMidY} r="16" />
              <path
                class="pipe-tick"
                d={`M ${pipeMidX} ${pipeMidY - 8} L ${pipeMidX + 7} ${pipeMidY} L ${pipeMidX} ${pipeMidY + 8} L ${pipeMidX - 7} ${pipeMidY} Z`}
              />
            </g>
            <g data-probe={traceTo.probe} tabindex="0" role="img" aria-label={traceTo.probe}>
              <circle class="dot-hit" cx={PIPE.x2} cy={PIPE.y} r="16" />
              <circle class="pipe-dot" cx={PIPE.x2} cy={PIPE.y} r="5" />
            </g>
            <text class="pipe-label" x={PIPE.x1} y="218" text-anchor="start">{trace.from} {coord(traceFrom.lat)}, {coord(traceFrom.lng)}</text>
            <text class="pipe-label" x={pipeMidX} y={pipeMidY - 18} text-anchor="middle">QC {trace.utc.slice(11)}</text>
            <text class="pipe-label" x={PIPE.x2} y="218" text-anchor="end">{trace.to} +{fmt(trace.km)} KM</text>
          </svg>
        </figure>

        <div class="stage-grid">
          {stages.map((s) => (
            <article class="stage lit rise" data-probe={traceProbe} tabindex="0">
              <header class="stage-head">
                <i class="lamp" aria-hidden="true"></i>
                <span class="mono-caption">{s.id}</span>
              </header>
              <p class="stage-body">{s.body}</p>
              <p class="stage-param mono-caption">{s.param}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- 幕间 2（疏） -->
      <section class="interstice shell">
        <p class="interstice-line rise">{c.interstice2.line}</p>
        <p class="interstice-cap mono-caption rise">{c.interstice2.cap}</p>
      </section>

      <!-- SECTION: MOD-04 / COVERAGE — 可操作覆盖台 + CTA -->
      <section id="mod-04" class="mod shell" data-mod="MOD-04">
        <header class="mod-head">
          <span class="mod-id mono-caption">MOD-04 / COVERAGE</span>
          <span class="mod-rule" aria-hidden="true"></span>
          <span class="mod-status mono-caption"><i class="lamp" aria-hidden="true"></i>INTERACTIVE</span>
        </header>

        <h2 class="mod-title rise">{c.coverage.title}</h2>

        <div class="console rise">
          <div id="console-map-wrap" class="console-map-wrap">
            <span id="ch-x" class="aim-line aim-line-x" aria-hidden="true"></span>
            <span id="ch-y" class="aim-line aim-line-y" aria-hidden="true"></span>
            <svg
              id="console-map"
              viewBox={`0 0 ${MAP_W} ${MAP_H}`}
              role="img"
              aria-label={`Interactive coverage map: ${cities.length} city nodes, ${events.length} delivery arcs, filter by region`}
            >
              {gratX.map((x) => (
                <line class="grat" x1={x} y1="0" x2={x} y2={MAP_H} />
              ))}
              {gratY.map((y) => (
                <line class="grat" x1="0" y1={y} x2={MAP_W} y2={y} />
              ))}
              {consoleArcs.map((a) => (
                <g class="c-arc-g" data-region={a.region} data-probe={a.probe} tabindex="0" role="img" aria-label={a.probe}>
                  <path class="c-arc-hit" d={a.d} />
                  <path class="c-arc" d={a.d} />
                </g>
              ))}
              {cityPts.map((cty) => (
                <g class="c-dot-g" data-region={cty.region} data-probe={cty.probe} tabindex="0" role="img" aria-label={cty.probe}>
                  <circle class="dot-hit" cx={cty.x} cy={cty.y} r="14" />
                  <circle class="c-dot" cx={cty.x} cy={cty.y} r="4.5" />
                </g>
              ))}
            </svg>
            <span class="console-tag mono-caption">{c.coverage.consoleTag}</span>
          </div>

          <aside class="console-side">
            <div class="region-group" role="group" aria-label="Filter coverage by region">
              {regions.map((r, i) => (
                <button
                  class:list={['region-btn', 'mono-caption', i === 0 && 'active']}
                  data-region={r.id}
                  data-nodes={r.nodes}
                  data-deliveries={r.deliveries}
                  data-km={r.km}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  <span>{r.label}</span>
                  <span class="region-count">{pad2(r.deliveries)} ARC</span>
                </button>
              ))}
            </div>

            <dl class="readouts">
              <div class="readout">
                <dt class="mono-caption">{c.coverage.readouts.nodes}</dt>
                <dd id="r-nodes" class="readout-num">{pad(regions[0].nodes, 3)}</dd>
              </div>
              <div class="readout">
                <dt class="mono-caption">{c.coverage.readouts.deliveries}</dt>
                <dd id="r-del" class="readout-num">{pad(regions[0].deliveries, 3)}</dd>
              </div>
              <div class="readout">
                <dt class="mono-caption">{c.coverage.readouts.km}</dt>
                <dd id="r-km" class="readout-num">{pad(regions[0].km, 6)}</dd>
              </div>
            </dl>
            <p class="console-note mono-caption">{t(c.coverage.consoleNote, { n: events.length, asOf })}</p>

            <div class="cta-row">
              <a class="cta cta-primary" href="/">{c.coverage.ctaPrimary}</a>
              <a class="cta cta-ghost" href="/">{c.coverage.ctaSecondary}</a>
            </div>
            <p class="net-line mono-caption">
              <i class="lamp" aria-hidden="true"></i>NETWORK: {cities.length} NODES NOMINAL · DATA AS OF {asOf}
            </p>
          </aside>
        </div>
      </section>

      <!-- SECTION: MOD-05 / CAPABILITIES — 六能力 = 六台子仪器（原型 platform.features） -->
      <section id="mod-05" class="mod shell" data-mod="MOD-05">
        <header class="mod-head">
          <span class="mod-id mono-caption">MOD-05 / CAPABILITIES</span>
          <span class="mod-rule" aria-hidden="true"></span>
          <span class="mod-status mono-caption"><i class="lamp" aria-hidden="true"></i>{pad2(capUnits.length)} UNITS NOMINAL</span>
        </header>

        <h2 class="mod-title rise">{c.capabilities.title}</h2>
        <p class="mod-sub rise">{homePlatform.description}</p>

        <div class="cap-grid">
          {capUnits.map((u) => (
            <article class="cap rise" tabindex="0">
              <header class="cap-head">
                <span class="cap-chip mono-caption">{u.id}</span>
                <span class="cap-run mono-caption"><i class="lamp" aria-hidden="true"></i>RDY</span>
              </header>
              <svg class="cap-fig" viewBox={`0 0 ${CAP_FIG.w} ${CAP_FIG.h}`} aria-hidden="true">
                {u.paths.map((d, j) => (
                  <path class="cap-arc" d={d} pathLength="1" style={`animation-delay:${(j * 0.06).toFixed(2)}s`} />
                ))}
              </svg>
              <h3 class="cap-title">{u.title}</h3>
              <p class="cap-body">{u.body}</p>
              <p class="cap-seed mono-caption">SEED 0x{u.hex} · FIELD {pad2(CAP_FIG.count)} ARCS</p>
            </article>
          ))}
        </div>
        <p class="cap-hint mono-caption rise">{c.capabilities.hint}</p>
      </section>

      <!-- SECTION: MOD-06 / SECTORS — 行业索引（原型 industries.items，Mapping 首位） -->
      <section id="mod-06" class="mod shell" data-mod="MOD-06">
        <header class="mod-head">
          <span class="mod-id mono-caption">MOD-06 / SECTORS</span>
          <span class="mod-rule" aria-hidden="true"></span>
          <span class="mod-status mono-caption"><i class="lamp" aria-hidden="true"></i>INDEX {pad2(indRows.length)} ROWS</span>
        </header>

        <h2 class="mod-title rise">{c.sectors.title}</h2>
        <p class="mod-sub rise">{homeIndustries.heading}</p>

        <ol class="ind-list">
          {indRows.map((row) => (
            <li class="ind-row rise" tabindex="0">
              <div class="ind-line">
                <span class="ind-no mono-caption">{row.id}</span>
                <span class="ind-label">{row.label}</span>
                <span class="ind-rule" aria-hidden="true"></span>
                <svg class="ind-fig" viewBox={`0 0 ${IND_FIG.w} ${IND_FIG.h}`} aria-hidden="true">
                  {row.paths.map((d, j) => (
                    <path class="cap-arc" d={d} pathLength="1" style={`animation-delay:${(j * 0.06).toFixed(2)}s`} />
                  ))}
                </svg>
              </div>
              <div class="ind-reveal">
                <div class="ind-reveal-inner">
                  <p class="ind-desc">{row.desc}</p>
                  <p class="ind-data mono-caption">{row.data}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
        <p class="cap-hint mono-caption rise">{c.sectors.hint}</p>
      </section>

      <!-- 幕间 3（疏）：belief.manifesto 三句，display-m 逐行 -->
      <section class="interstice interstice-manifesto shell">
        {homeBelief.manifesto.map((line) => (
          <p class="interstice-line manifesto-line rise">{line}</p>
        ))}
        <p class="interstice-cap mono-caption rise">{c.manifestoCap}</p>
      </section>
    </main>

    <!-- SECTION: colophon — 一行 mono 页脚 -->
    <footer id="colophon" class="colophon">
      <p class="mono-caption shell">
        ARCLINK GROUND STATION · VARIANT M2/STATION · BUILD {buildStamp} UTC · DATA AS OF {asOf} ·
        {cities.length} NODES / {events.length} ARCS · {pad2(MOD_COUNT)} MODULES · SET IN INTER + MONO
      </p>
    </footer>
  </div>
</Base>

<style>
  /* ========== 基底：仪器室环境光（#030b1d 唯一底色，蓝只做信号 ≤10%） ========== */
  .station {
    background: var(--color-bg);
    color: var(--color-text-on-dark);
    min-height: 100vh;
    overflow-x: clip;
  }

  .mod {
    padding-block: calc(var(--space-9) * 1.4);
  }

  /* ---------- 状态灯（蓝 = 活的数据） ---------- */
  .lamp {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-bright);
    margin-right: var(--space-2);
    flex: none;
  }

  /* ---------- 面板头 MOD-n（编号 + hairline + 状态灯） ---------- */
  .mod-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .mod-id {
    color: rgba(255, 255, 255, 0.7);
  }

  .mod-rule {
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  .mod-status {
    display: inline-flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.4);
  }

  .mod-title {
    font-size: var(--text-display-m);
    font-weight: 620;
    letter-spacing: var(--tracking-tight);
    line-height: 1.02;
    margin: 0 0 var(--space-6);
    max-width: 22ch;
  }

  .mod-sub {
    color: var(--color-text-muted-on-dark);
    font-size: 1.0625rem;
    max-width: 52ch;
    margin: 0 0 var(--space-7);
  }

  /* ---------- 页缘 ruler 刻度列 ---------- */
  .ruler {
    position: fixed;
    top: 0;
    bottom: 0;
    width: 30px;
    z-index: 60;
    pointer-events: none;
  }

  .ruler-left { left: 0; }
  .ruler-right { right: 0; }

  .ruler::before,
  .ruler::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
  }

  .ruler::before {
    width: 7px;
    background: repeating-linear-gradient(to bottom, var(--hairline) 0 1px, transparent 1px 14px);
  }

  .ruler::after {
    width: 13px;
    background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.28) 0 1px, transparent 1px 98px);
  }

  .ruler-left::before, .ruler-left::after { left: 8px; }
  .ruler-right::before, .ruler-right::after { right: 8px; }

  .ruler-readout {
    position: absolute;
    writing-mode: vertical-rl;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    white-space: nowrap;
  }

  .ruler-left .ruler-readout { left: 4px; bottom: 18px; transform: rotate(180deg); }
  .ruler-right .ruler-readout { right: 4px; top: 18px; }

  /* ---------- proof-of-life 探针卡 ---------- */
  .probe {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    max-width: 340px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: var(--color-bg-navy);
    color: var(--color-text-on-dark);
    pointer-events: none;
    will-change: transform;
  }

  /* ========== MOD-01 HERO：开机序列 ========== */
  .mod-hero {
    min-height: 96vh;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-6);
  }

  .mod-hero .mod-head { margin-bottom: var(--space-7); }

  .hero-status {
    display: flex;
    align-items: baseline;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 var(--space-6);
    min-height: 1.4em;
  }

  .caret {
    display: inline-block;
    width: 0.55em;
