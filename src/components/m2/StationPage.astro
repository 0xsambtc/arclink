  }

  .interstice-line {
    font-size: var(--text-display-m);
    font-weight: 620;
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    margin: 0 auto var(--space-5);
    max-width: 24ch;
  }

  .interstice-cap { color: rgba(255, 255, 255, 0.4); margin: 0; }

  /* 幕间 3：宣言三句逐行（display-m 声，行距放疏） */
  .interstice-manifesto .manifesto-line {
    max-width: 30ch;
    margin-bottom: var(--space-6);
  }

  .interstice-manifesto .interstice-cap { margin-top: var(--space-7); }

  /* ========== MOD-03 PIPELINE ========== */
  .pipe-fig {
    margin: 0 0 var(--space-7);
  }

  .pipe-fig svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .pipe-path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .pipe-tick {
    fill: var(--color-bg);
    stroke: var(--color-accent-bright);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .pipe-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.06em;
    fill: rgba(255, 255, 255, 0.55);
  }

  .stage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .stage {
    border: 1px solid var(--hairline);
    padding: var(--space-5) var(--space-5) var(--space-6);
    cursor: crosshair;
  }

  .stage-head {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-5);
    color: rgba(255, 255, 255, 0.7);
  }

  .stage .lamp { background: rgba(255, 255, 255, 0.12); }
  .stage.lit .lamp { background: var(--color-accent-bright); }

  .stage-body {
    margin: 0 0 var(--space-5);
    color: var(--color-text-muted-on-dark);
    font-size: 0.9875rem;
  }

  .stage-param {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-4);
  }

  /* ========== MOD-04 COVERAGE：可操作覆盖台 ========== */
  .console {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: var(--space-7);
    align-items: stretch;
  }

  .console-map-wrap {
    position: relative;
    border: 1px solid var(--hairline);
    padding: var(--space-4);
    overflow: hidden;
    cursor: crosshair;
  }

  .console-map-wrap svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .aim-line {
    position: absolute;
    background: rgba(52, 120, 255, 0.3);
    opacity: 0;
    pointer-events: none;
    will-change: transform;
  }

  .aim-line-x { left: 0; right: 0; top: 0; height: 1px; }
  .aim-line-y { top: 0; bottom: 0; left: 0; width: 1px; }
  .console-map-wrap.aim .aim-line { opacity: 1; }

  .c-arc {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0.55;
    vector-effect: non-scaling-stroke;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .c-arc-g:hover .c-arc, .c-arc-g:focus-visible .c-arc { opacity: 1; stroke: var(--color-accent-bright); }

  .c-dot-g .c-dot { transition: opacity var(--duration-base) var(--ease-out); }
  .c-dot-g:hover .c-dot, .c-dot-g:focus-visible .c-dot { fill: #ffffff; }

  .c-arc-g.dim .c-arc { opacity: 0.06; }
  .c-dot-g.dim .c-dot { opacity: 0.18; }
  .c-arc-g.dim, .c-dot-g.dim { pointer-events: none; }

  .console-tag {
    display: block;
    margin-top: var(--space-3);
    color: rgba(255, 255, 255, 0.4);
  }

  .console-side {
    display: flex;
    flex-direction: column;
  }

  .region-group {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline);
  }

  .region-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--hairline);
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    text-align: left;
    transition: color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .region-btn:last-child { border-bottom: 0; }

  .region-btn:hover { color: var(--color-text-on-dark); background: rgba(255, 255, 255, 0.06); }

  .region-btn.active {
    color: var(--color-text-on-dark);
    background: rgba(37, 99, 235, 0.12);
    box-shadow: inset 2px 0 0 var(--color-accent-bright);
  }

  .region-count { color: rgba(255, 255, 255, 0.4); }
  .region-btn.active .region-count { color: var(--color-accent-bright); }

  .readouts {
    margin: var(--space-6) 0 0;
    border-block: 1px solid var(--hairline);
  }

  .readout {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--space-4) 0;
  }

  .readout + .readout { border-top: 1px solid var(--hairline); }

  .readout dt { color: rgba(255, 255, 255, 0.4); }

  .readout-num {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums slashed-zero;
    font-size: 1.75rem;
    line-height: 1;
  }

  .console-note {
    color: rgba(255, 255, 255, 0.4);
    margin: var(--space-4) 0 0;
  }

  .cta-row {
    display: flex;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-7);
    flex-wrap: wrap;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 var(--space-6);
    border: 1px solid;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .cta-primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-text-on-dark);
  }

  .cta-primary:hover { background: var(--color-accent-bright); border-color: var(--color-accent-bright); }

  .cta-ghost {
    border-color: rgba(255, 255, 255, 0.4);
    color: var(--color-text-on-dark);
  }

  .cta-ghost:hover { border-color: var(--color-accent-bright); background: rgba(37, 99, 235, 0.08); }

  .net-line {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.4);
    margin: var(--space-4) 0 0;
  }

  /* ========== MOD-05 CAPABILITIES：六台子仪器 ========== */
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .cap {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline);
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .cap-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--space-4);
  }

  .cap-run {
    display: inline-flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.4);
  }

  .cap .lamp { background: rgba(255, 255, 255, 0.12); }
  .cap:hover .lamp, .cap:focus-visible .lamp { background: var(--color-accent-bright); }
  .cap:hover .cap-run, .cap:focus-visible .cap-run { color: rgba(255, 255, 255, 0.7); }

  .cap-fig {
    width: 100%;
    height: auto;
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }

  /* 弧场微图形：默认静置；hover/focus 时按 delay 逐条重描（"仪器运转"），
     fill-mode both + pathLength=1 归一化 → 无 JS 时静态可见，reduced-motion 由 global.css 全局压平 */
  .cap-arc {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0.45;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .cap:hover .cap-arc,
  .cap:focus-visible .cap-arc,
  .ind-row:hover .cap-arc,
  .ind-row:focus .cap-arc,
  .ind-row:focus-within .cap-arc {
    stroke: var(--color-accent-bright);
    opacity: 0.9;
    animation: cap-run 0.8s var(--ease-out) both;
  }

  @keyframes cap-run {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  .cap-title {
    font-size: 1.125rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
  }

  .cap-body {
    margin: 0 0 var(--space-5);
    color: var(--color-text-muted-on-dark);
    font-size: 0.9875rem;
  }

  .cap-seed {
    margin: auto 0 0;
    color: rgba(255, 255, 255, 0.4);
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-4);
  }

  .cap-hint {
    color: rgba(255, 255, 255, 0.4);
    margin: var(--space-5) 0 0;
  }

  /* ========== MOD-06 SECTORS：行业索引行 ========== */
  .ind-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }

  .ind-row {
    border-bottom: 1px solid var(--hairline);
    padding-block: var(--space-5);
  }

  .ind-line {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
  }

  .ind-no { color: rgba(255, 255, 255, 0.4); }

  .ind-label {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 620;
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
  }

  .ind-rule {
    height: 1px;
    background: var(--hairline);
  }

  .ind-fig {
    width: 120px;
    height: auto;
    opacity: 0.6;
  }

  .ind-row:hover .ind-fig, .ind-row:focus .ind-fig, .ind-row:focus-within .ind-fig { opacity: 1; }

  /* hover/focus 展开：grid-rows 0fr→1fr（纯 CSS，无 JS 依赖；触屏 tap = focus 同样触发） */
  .ind-reveal {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease-out);
  }

  .ind-reveal-inner { overflow: hidden; min-height: 0; }

  .ind-row:hover .ind-reveal,
  .ind-row:focus .ind-reveal,
  .ind-row:focus-within .ind-reveal {
    grid-template-rows: 1fr;
  }

  .ind-desc {
    margin: var(--space-4) 0 var(--space-2);
    color: var(--color-text-muted-on-dark);
    max-width: 60ch;
  }

  .ind-data {
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
  }

  /* ========== colophon ========== */
  .colophon {
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-6);
  }

  .colophon p {
    margin: 0;
    color: rgba(255, 255, 255, 0.4);
  }

  /* ========== 中文排版（[lang="zh"]）：大字不紧字距，display 字号降一档、行高放宽 ========== */
  :global(html[lang='zh']) .hero-title {
    font-size: clamp(3.25rem, 9vw, 8rem);
    letter-spacing: 0;
    line-height: 1.12;
  }

  :global(html[lang='zh']) .mod-title,
  :global(html[lang='zh']) .interstice-line {
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    letter-spacing: 0;
    line-height: 1.18;
  }

  :global(html[lang='zh']) .ind-label { letter-spacing: 0; }

  /* ========== 响应式 ========== */
  @media (max-width: 1100px) {
    .hero-deck { grid-template-columns: 1fr; }
    .globe-wrap { justify-self: start; }
    .spec-grid { grid-template-columns: 1fr 1fr; }
    .spec:nth-child(odd) { border-left: 0; padding-left: 0; }
    .spec { border-top: 1px solid var(--hairline); }
    .spec:nth-child(-n + 2) { border-top: 0; }
    .console { grid-template-columns: 1fr; }
    .cap-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 760px) {
    .ruler { display: none; }
    .mod { padding-block: var(--space-9); }
    .mod-hero { min-height: 0; }
    .hero-status { white-space: normal; }
    .spec-grid { grid-template-columns: 1fr; }
    .spec { border-left: 0; padding-left: 0; padding-right: 0; }
    .spec:nth-child(2) { border-top: 1px solid var(--hairline); }
    .stage-grid { grid-template-columns: 1fr; }
    .interstice { padding-block: calc(var(--space-9) * 1.2); text-align: left; }
    .interstice-line { margin-inline: 0; }
    .cta-row { flex-direction: column; align-items: stretch; }
    .cap-grid { grid-template-columns: 1fr; }
    .ind-line { grid-template-columns: auto auto 1fr; }
    .ind-fig { display: none; }
    /* 移动端不初始化 globe：静态 SVG 点阵图即 fallback（CSS 默认态） */
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import createGlobe from 'cobe';

  gsap.registerPlugin(ScrollTrigger);

  const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as HTMLElement | null;
  const $$ = (s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as HTMLElement[];

  const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const desktop = window.matchMedia('(min-width: 761px)').matches;

  /* ============ proof-of-life 探针（hover + 键盘 focus，任何模式都可用） ============ */
  const probe = $('#probe')!;
  let probeOn = false;

  function placeProbe(x: number, y: number) {
    const pw = probe.offsetWidth;
    const ph = probe.offsetHeight;
    let px = x + 16;
    let py = y + 18;
    if (px + pw > innerWidth - 8) px = x - pw - 12;
    if (py + ph > innerHeight - 8) py = y - ph - 12;
    probe.style.transform = `translate3d(${px}px, ${py}px, 0)`;
  }

  function openProbe(text: string, x: number, y: number) {
    probe.textContent = text;
    probe.hidden = false;
    probeOn = true;
    placeProbe(x, y);
  }

  function closeProbe() {
    probe.hidden = true;
    probeOn = false;
  }

  document.addEventListener('pointerover', (e) => {
    const t = (e.target as Element).closest?.('[data-probe]') as HTMLElement | null;
    if (t) openProbe(t.dataset.probe!, e.clientX, e.clientY);
    else if (probeOn) closeProbe();
  });
  document.addEventListener('pointermove', (e) => {
    if (probeOn) placeProbe(e.clientX, e.clientY);
  });
  document.addEventListener('focusin', (e) => {
    const t = (e.target as Element).closest?.('[data-probe]') as HTMLElement | null;
    if (t) {
      const r = t.getBoundingClientRect();
      openProbe(t.dataset.probe!, r.right, r.top);
    }
  });
  document.addEventListener('focusout', closeProbe);

  /* ============ 页缘 ruler 读数（滚动深度 + 当前 MOD / 总模块数） ============ */
  const MOD_TOTAL = $$('[data-mod]').length;
  const depthEl = $('#depth-readout');
  let depthTick = false;
  function updDepth() {
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.round((scrollY / max) * 100) : 0;
    if (depthEl) depthEl.textContent = `DEPTH ${String(p).padStart(3, '0')}%`;
    depthTick = false;
  }
  addEventListener(
    'scroll',
    () => {
      if (!depthTick) {
        depthTick = true;
        requestAnimationFrame(updDepth);
      }
    },
    { passive: true }
  );
  updDepth();

  const modEl = $('#mod-readout');
  const modIO = new IntersectionObserver(
    (es) =>
      es.forEach((en) => {
        if (en.isIntersecting && modEl)
          modEl.textContent = `${(en.target as HTMLElement).dataset.mod!} / ${String(MOD_TOTAL).padStart(2, '0')}`;
      }),
    { rootMargin: '-40% 0px -55% 0px' }
  );
  $$('[data-mod]').forEach((s) => modIO.observe(s));

  /* ============ 里程表式逐位跳变（stepped，不平滑插值） ============ */
  function fmtPad(v: number, len: number) {
    return String(Math.max(0, Math.round(v)))
      .padStart(len, '0')
      .replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  const stepState = new WeakMap<Element, number>();
  function stepTo(el: HTMLElement | null, target: number, len: number) {
    if (!el) return;
    const from = stepState.get(el) ?? target;
    stepState.set(el, target);
    if (!motionOK) {
      el.textContent = fmtPad(target, len);
      return;
    }
    const o = { v: from };
    gsap.to(o, {
      v: target,
      duration: 0.6,
      ease: 'steps(12)',
      overwrite: true,
      onUpdate: () => (el.textContent = fmtPad(o.v, len)),
    });
  }

  /* ============ 可操作覆盖台：选区域 → 弧线重排 + 读数刷新 ============ */
  const consoleMap = $('#console-map');
  const regionBtns = $$('.region-btn');
  const dotGs = consoleMap ? $$('.c-dot-g', consoleMap) : [];
  const arcGs = consoleMap ? $$('.c-arc-g', consoleMap) : [];
  const rNodes = $('#r-nodes');
  const rDel = $('#r-del');
  const rKm = $('#r-km');
  let arcLens: Map<Element, number> | null = null;

  function setRegion(btn: HTMLElement) {
    regionBtns.forEach((b) => {
      b.classList.toggle('active', b === btn);
      b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
    });
    const reg = btn.dataset.region!;
    dotGs.forEach((d) => d.classList.toggle('dim', reg !== 'all' && d.dataset.region !== reg));
    const active: HTMLElement[] = [];
    arcGs.forEach((a) => {
      const on = reg === 'all' || a.dataset.region === reg;
      a.classList.toggle('dim', !on);
      if (on) active.push(a);
    });
    stepTo(rNodes, +btn.dataset.nodes!, 3);
    stepTo(rDel, +btn.dataset.deliveries!, 3);
    stepTo(rKm, +btn.dataset.km!, 6);
    if (motionOK) {
      if (!arcLens) {
        arcLens = new Map();
        arcGs.forEach((g) => {
          const p = g.querySelector('.c-arc') as SVGPathElement;
          arcLens!.set(g, p.getTotalLength());
        });
      }
      active.forEach((g, i) => {
        const p = g.querySelector('.c-arc') as SVGPathElement;
        const L = arcLens!.get(g)!;
        gsap.fromTo(
          p,
          { strokeDasharray: L, strokeDashoffset: L },
          { strokeDashoffset: 0, duration: 0.7, delay: i * 0.05, ease: 'power2.out', overwrite: true }
        );
      });
    }
  }
  regionBtns.forEach((b) => b.addEventListener('click', () => setRegion(b)));

  /* ============ 覆盖台十字准星（transform-only） ============ */
  const aimWrap = $('#console-map-wrap');
  const chX = $('#ch-x');
  const chY = $('#ch-y');
  if (aimWrap && chX && chY) {
    aimWrap.addEventListener('pointermove', (e) => {
      const r = aimWrap.getBoundingClientRect();
      chX.style.transform = `translate3d(0, ${e.clientY - r.top}px, 0)`;
      chY.style.transform = `translate3d(${e.clientX - r.left}px, 0, 0)`;
    });
    aimWrap.addEventListener('pointerenter', () => aimWrap.classList.add('aim'));
    aimWrap.addEventListener('pointerleave', () => aimWrap.classList.remove('aim'));
  }

  /* ============ cobe globe：桌面 + motion 允许时懒初始化；否则静态 SVG 点阵图 ============ */
  const globeCanvas = $('#globe-canvas') as HTMLCanvasElement | null;
  const cityMarkers = $$('#hero-map .map-dot').map((d) => ({
    location: [+d.dataset.lat!, +d.dataset.lng!] as [number, number],
    size: 0.07,
  }));
  // 逐城 plot 状态：hero 时间线驱动 n → rAF 逐帧截取
  const markerState = { n: motionOK ? 0 : cityMarkers.length };
  let phi = 0;
  let globeVisible = true;

  function initGlobe() {
    if (!globeCanvas) return;
    const wrapEl = globeCanvas.parentElement as HTMLElement;
    const size = Math.min(wrapEl.clientWidth, 560);
    globeCanvas.style.width = `${size}px`;
    globeCanvas.style.height = `${size}px`;
    const globe = createGlobe(globeCanvas, {
      devicePixelRatio: 2,
      width: size * 2,
      height: size * 2,
      phi: 0,
      theta: 0.2,
      dark: 1,
      diffuse: 1.2,
      mapSamples: 16000,
      mapBrightness: 4,
      baseColor: [0.05, 0.09, 0.16],
      markerColor: [0.2, 0.47, 1],
      glowColor: [0.08, 0.16, 0.33],
      markers: cityMarkers.slice(0, Math.round(markerState.n)),
    });
    // cobe v2 无 onRender：自建 rAF 循环驱动旋转与逐城 plot（离屏时暂停更新）
    const tick = () => {
      if (globeVisible) {
        phi += 0.003;
        globe.update({ phi, markers: cityMarkers.slice(0, Math.round(markerState.n)) });
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    wrapEl.classList.add('globe-live');
    const vio = new IntersectionObserver((es) => {
      globeVisible = es.some((e) => e.isIntersecting);
    });
    vio.observe(globeCanvas);
  }

  if (globeCanvas && desktop && motionOK) {
    const gio = new IntersectionObserver(
      (es) => {
        if (es.some((e) => e.isIntersecting)) {
          gio.disconnect();
          initGlobe();
        }
      },
      { rootMargin: '200px' }
    );
    // 观察可见的 wrap 而非 display:none 的 canvas（隐藏元素不触发 intersection）
    gio.observe(globeCanvas.parentElement ?? globeCanvas);
  }

  /* ============ 动效编排（全部在 matchMedia 条件内；初始隐藏态由 gsap.set 设置） ============ */
  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    /* ---- HERO 开机序列：刻度 draw-in → 状态行 type-on → globe 升起逐城 plot + log 追加 → 大字 rise ---- */
    const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    gsap.set('.ruler', { scaleY: 0, transformOrigin: '50% 0%' });
    heroTl.to('.ruler', { scaleY: 1, duration: 0.5, ease: 'power2.out' }, 0);

    const heroRule = $('#mod-01 .mod-rule');
    if (heroRule) {
      gsap.set(heroRule, { scaleX: 0, transformOrigin: '0 50%' });
      heroTl.to(heroRule, { scaleX: 1, duration: 0.5, ease: 'power2.out' }, 0.1);
    }

    const statusEl = $('#hero-status-text');
    if (statusEl) {
      const full = statusEl.textContent ?? '';
      statusEl.textContent = '';
      const st = { i: 0 };
      heroTl.to(
        st,
        {
          i: full.length,
          duration: 1.1,
          ease: 'none',
          snap: 'i',
          onUpdate: () => (statusEl.textContent = full.slice(0, Math.round(st.i))),
        },
        0.3
      );
    }

    gsap.set('.hero-line-inner', { yPercent: 112 });
    heroTl.to('.hero-line-inner', { yPercent: 0, duration: 0.9, stagger: 0.12 }, 0.55);

    gsap.set(['.hero-sub', '.hero-cue', '.log-panel', '.globe-tag'], { autoAlpha: 0, y: 18 });
    heroTl.to(['.hero-sub', '.log-panel'], { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.1 }, 0.85);

    gsap.set('#globe-wrap', { autoAlpha: 0, y: 26 });
    heroTl.to('#globe-wrap', { autoAlpha: 1, y: 0, duration: 0.8 }, 0.7);
    heroTl.to(['.globe-tag', '.hero-cue'], { autoAlpha: 1, y: 0, duration: 0.5 }, 1.3);

    // log 逐行追加（每行 = 一条数据记录出现，动效之"因"）+ 传送带位移（transform-only）
    const logLines = $$('#hero-log .log-line');
    const logList = $('#hero-log-list');
    const LINE_H = 22;
    const VISIBLE = 9;
    gsap.set(logLines, { autoAlpha: 0 });
    logLines.forEach((ln, i) => {
      const at = 1.0 + i * 0.11;
      heroTl.to(ln, { autoAlpha: 1, duration: 0.18, ease: 'none' }, at);
      if (i >= VISIBLE && logList) heroTl.set(logList, { y: -(i - VISIBLE + 1) * LINE_H }, at);
    });

    // globe 逐城 plot 与 log 同步（stepped：一次一城）
    heroTl.to(
      markerState,
      { n: cityMarkers.length, duration: cityMarkers.length * 0.11, ease: `steps(${cityMarkers.length})` },
      1.0
    );

    /* ---- 各 MOD / 幕间进场：hairline draw → 内容 rise（开机有序；新增 MOD-05/06 与幕间 3 同语言） ---- */
    $$('.mod:not(#mod-01), .interstice').forEach((sec) => {
      const rule = sec.querySelector('.mod-rule');
      const items = $$('.rise', sec);
      if (rule) gsap.set(rule, { scaleX: 0, transformOrigin: '0 50%' });
      gsap.set(items, { autoAlpha: 0, y: 26 });
      ScrollTrigger.create({
        trigger: sec,
        start: 'top 72%',
        once: true,
        onEnter: () => {
          const tl = gsap.timeline();
          if (rule) tl.to(rule, { scaleX: 1, duration: 0.5, ease: 'power2.out' }, 0);
          tl.to(items, { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.09 }, 0.15);
        },
      });
    });

    /* ---- 信任数字：里程表 stepped countup ---- */
    $$('.spec-num').forEach((el) => {
      const target = +el.dataset.value!;
      const len = String(target).length;
      el.textContent = fmtPad(0, len);
      ScrollTrigger.create({
        trigger: el,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          const o = { v: 0 };
          gsap.to(o, {
            v: target,
            duration: 1.4,
            ease: 'steps(24)',
            onUpdate: () => (el.textContent = fmtPad(o.v, len)),
          });
        },
      });
    });

    /* ---- 流程 trace：scroll 驱动描边推进，阶段灯依次点亮 ---- */
    const pipe = $('#pipe-path') as unknown as SVGPathElement | null;
    if (pipe) {
      const L = pipe.getTotalLength();
      gsap.set(pipe, { strokeDasharray: L, strokeDashoffset: L });
      const stageEls = $$('#mod-03 .stage');
      stageEls.forEach((s) => s.classList.remove('lit'));
      ScrollTrigger.create({
        trigger: '#mod-03 .pipe-fig',
        start: 'top 78%',
        end: 'bottom 45%',
        scrub: 0.4,
        onUpdate: (self) => {
          gsap.set(pipe, { strokeDashoffset: L * (1 - self.progress) });
          stageEls.forEach((s, i) => s.classList.toggle('lit', self.progress >= (i + 1) / 3 - 0.02));
        },
      });
    }
  });
</script>
