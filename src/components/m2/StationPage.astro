  }

  .log-viewport {
    height: 198px; /* 9 行 × 22px */
    overflow: hidden;
    padding: 0 var(--space-4);
  }

  .log-list {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
