  .log-line {
    line-height: 22px;
    height: 22px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgba(255, 255, 255, 0.7);
  }

  .log-line:hover { color: var(--color-text-on-dark); }

  /* globe / 静态点阵图 fallback */
  .globe-wrap {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 560px;
  }

  .globe-canvas {
    display: none;
    width: 100%;
    aspect-ratio: 1;
  }

  .globe-fallback {
    display: block;
    width: 100%;
    height: auto;
  }

  .globe-wrap.globe-live .globe-canvas { display: block; margin-inline: auto; }
  .globe-wrap.globe-live .globe-fallback { display: none; }

  .globe-tag {
    display: block;
    margin-top: var(--space-3);
    color: rgba(255, 255, 255, 0.4);
    text-align: right;
  }

  /* ---------- 共用 SVG 图元 ---------- */
  .grat {
    stroke: var(--hairline);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .dot-hit, .c-arc-hit {
    fill: transparent;
    stroke: transparent;
  }

  .c-arc-hit {
    fill: none;
    stroke-width: 12;
  }

  .map-dot, .c-dot, .pipe-dot {
    fill: var(--color-accent-bright);
  }

  .h-arc {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0.3;
    vector-effect: non-scaling-stroke;
  }

  svg g[data-probe] { cursor: crosshair; outline-offset: 3px; }

  /* ========== MOD-02 TELEMETRY：specimen ========== */
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr) 1.3fr;
    border-block: 1px solid var(--hairline);
  }

  .spec {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-6);
    border-left: 1px solid var(--hairline);
  }

  .spec:first-child { border-left: 0; padding-left: 0; }

  .spec-label { color: rgba(255, 255, 255, 0.4); }

  .spec-num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums slashed-zero;
    font-size: clamp(3rem, 5.5vw, 4.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .spec-unit { color: rgba(255, 255, 255, 0.4); }

  .spark {
    width: 100%;
    max-width: 372px;
    height: auto;
    margin-top: auto;
  }

  .spark-bar {
    fill: rgba(255, 255, 255, 0.35);
    cursor: crosshair;
  }

  .spark-bar:hover, .spark-bar:focus-visible {
    fill: var(--color-accent-bright);
  }

  .spec-note {
    color: rgba(255, 255, 255, 0.4);
    margin: var(--space-5) 0 0;
    max-width: 90ch;
  }

  /* ========== 幕间 manifesto（疏） ========== */
  .interstice {
    padding-block: calc(var(--space-9) * 1.9);
