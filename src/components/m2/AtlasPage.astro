    letter-spacing: -0.02em;
  }

  .wm-fill {
    fill: var(--color-text-on-dark);
  }

  /* 字腔内的 12 条真实交付弧（非等比缩放用 non-scaling-stroke 保持线号一致） */
  .wm-arc {
    fill: none;
    stroke: var(--color-accent-bright);
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 0; /* 无 JS / 减动效：静态全绘 */
  }

  /* 配色A纪律：#147dfd 冷纸上 3.58:1 —— 仅限大字与图形描边（此处为字腔内描边，合规） */
  .theme-paper .wm-arc {
    stroke: var(--color-brand-blue);
  }

  /* 移动端回退实心字标（S2 降级） */
  .hero-title-fallback {
    display: none;
    font-size: clamp(3.5rem, 14vw, 9rem);
    font-weight: 680;
    letter-spacing: var(--tracking-tight);
    line-height: 0.94;
  }

  .hero-plate-cap {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-3);
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-3);
    color: var(--color-text-muted-on-dark);
  }

  .hero-bottom {
    position: relative;
    z-index: 2;
    align-items: end;
    margin-top: auto;
    padding-top: var(--space-8);
    row-gap: var(--space-6);
  }

  .hero-intro {
    grid-column: 1 / 6;
  }

  .hero-deck {
    margin: 0 0 var(--space-5);
    max-width: 46ch;
    font-size: var(--lede-size);
    line-height: 1.6;
    color: var(--color-text-muted-on-dark);
  }

  .hero-jump {
    color: var(--color-accent-bright);
    text-decoration: none;
    border-bottom: 1px solid rgba(52, 120, 255, 0.45);
    padding-bottom: 2px;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .hero-jump:hover {
    border-color: var(--color-accent-bright);
  }

  /* log 插页骑 SEC.00/01 页界（comp-print 胆量时刻②）：负 margin 压过节界，SEC.01 --sec-pt 留身位 */
  .hero-log {
    grid-column: 8 / 13;
    z-index: 3;
    margin-bottom: calc(-1 * var(--space-8));
    padding: var(--space-4) var(--space-5);
  }

  .hero-log-title {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted-on-dark);
  }

  .log-lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .log-line {
    display: flex;
    gap: var(--space-3);
    padding: 5px 0;
    border-top: 1px solid var(--hairline);
    color: var(--color-text-soft-on-dark);
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }

  .log-line:first-child {
    border-top: 0;
  }

  .log-line.is-live {
    color: var(--color-accent-bright);
  }

  .log-idx {
    color: var(--color-text-muted-on-dark);
  }

  .log-line.is-live .log-idx {
    color: var(--color-accent-bright);
  }

  /* ============ SEC.01 INDEX — specimen 页（缺陷1/6；QA修复 第3条：归档槽 CSS 随槽位一并删除） ============ */
  .sec-index {
    --sec-pt: 128px;
    --sec-pb: 120px;
  }

  .index-head {
    align-items: end;
    row-gap: var(--space-6);
  }

  .index-intro {
    grid-column: 1 / 7;
  }

  /* FIG.03 刻度图归位数据：作为 IDX.04 行内附件（缺陷6） */
  .fig-ticks {
    margin: 0;
    width: 100%;
    max-width: 320px;
  }

  .ticks {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    height: 88px;
    padding: var(--space-4) var(--space-4) var(--space-3);
  }

  .tick {
    display: block;
    flex: 1;
    max-width: 16px;
    background: var(--color-accent);
  }

  .tick:hover {
    background: var(--color-accent-bright);
  }

  .spec-list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    border-bottom: 1px solid var(--hairline);
  }

  /* 缺陷6修复：数字列成为行主体（specimen），label 缩为引题，note 右对齐 */
  .spec-row {
    position: relative;
    display: grid;
    grid-template-columns: 90px minmax(0, 0.6fr) minmax(0, 1.7fr) minmax(0, 0.9fr);
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-6) 0;
  }

  .spec-idx {
    color: var(--color-text-muted-on-dark);
  }

  .spec-label {
    font-size: var(--support-size);
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  /* 缺陷2/6修复：数字升 display-l 族，左对齐 —— 数字本身是版面事件 */
  .spec-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: clamp(3.25rem, 7vw, 6.5rem);
    font-weight: 440;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .spec-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
    align-self: end;
  }

  .spec-note {
    color: var(--color-text-muted-on-dark);
    text-align: right;
  }

  .spec-footnote {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted-on-dark);
  }

  /* ============ SEC.02 METHOD — verso 页：右轴 + 图版左出血 + 阶梯三相（缺陷1） ============ */
  .sec-method {
    --sec-pt: 112px;
    --sec-pb: 112px;
    position: relative;
  }

  .method-head {
    row-gap: var(--space-2);
  }

  /* 缺陷1修复：SEC.02 标题右置 col 7-12 右对齐（verso 翻页感） */
  .method-title {
    grid-column: 7 / 13;
    text-align: right;
  }

  .method-lede {
    grid-column: 8 / 13;
    max-width: none;
  }

  /* 图版左出血：订进书脊轨（comp-print §3），右缘收在 col 9 */
  .fig-method {
    margin: var(--space-8) 25% 0 var(--bleed);
    border-left: 0;
  }

  .fig-body-method {
    padding: var(--space-6) var(--space-6) var(--space-4) max(var(--shell-gutter), calc((100vw - var(--shell-max)) / 2));
  }

  .fig-body-method svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .method-base {
    stroke: var(--hairline);
    stroke-width: 1;
  }

  .method-arc {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }

  .method-ring {
    fill: none;
    stroke: rgba(255, 255, 255, 0.25);
    stroke-width: 1;
  }

  /* ============ 纸面主题（Paper Atlas）— 配色方案 A「NORTH PAPER」冷纸（缺陷5修复，prop-palette 逐 token 采纳） ============
     概念：把纸的色温调到与品牌墨水同一侧 —— #f3f5f9 是带 2–3% 藏青倾向的冷白（北窗光下的白纸）。
     纪律：#147dfd（--color-brand-blue）冷纸上 3.58:1，仅限大字（≥24px bold）与图形描边（≥3:1），禁止小字。
     muted α.68→.78（正文过 7:1）、soft α.55→.66（小字过 4.5:1）—— 顺带修掉旧值 4.25:1 的 AA 违规。 */
  .atlas.theme-paper {
    --color-bg: #f3f5f9;
    --color-bg-deep: #eaeef5;
    --color-glow: #e3e9f2;
    --color-bg-navy: #0a1d33;
    --color-bg-navy-alt: #11294a;
    --color-text-on-dark: #0a1d33;
    --color-text-muted-on-dark: rgba(10, 29, 51, 0.78);
    --color-text-soft-on-dark: rgba(10, 29, 51, 0.66);
    --color-border-on-dark: rgba(10, 29, 51, 0.15);
    --hairline: rgba(10, 29, 51, 0.15);
    --color-accent: #1a55d0;
    --color-accent-bright: #2160e8;
    --color-accent-deep: #123f9e;
    /* 图版页反转：纸面版中"插页"变为深色（surface↔ink 在主题作用域内互换） */
    --color-surface: #0a1d33;
    --color-brand-ink: #f3f5f9;
    --hairline-on-light: rgba(243, 245, 249, 0.2);
    --color-text-muted-on-light: rgba(243, 245, 249, 0.7);
    /* 纸面无辉光：降为一次极浅墨影（critique-creativity：印刷品没有辉光，物理谬误修正） */
    --glow-accent: 0 1px 2px rgba(10, 29, 51, 0.1);
    --glow-accent-strong: 0 2px 6px rgba(10, 29, 51, 0.14);
    --crop-ink: rgba(10, 29, 51, 0.45);
  }

  /* 图版页专用亮蓝（prop-palette：藏青底上小字 #6b93f0 = 5.71:1；hover 再提一档） */
  .theme-paper .sec-coverage {
    --color-accent: #6b93f0;
    --color-accent-bright: #9dbcff;
  }

  /* 第二纸种（冷白）= 纸张层次，比阴影诚实（comp-print 0.5） */
  .theme-paper .tipped {
    background: #fafbfd;
  }

  /* QA修复 第4条：纸面地球本就浅色，不上暗面板 */
  .theme-paper .fig-body-hero {
    background: none;
  }

  /* 纸面主题装订沟阴影（深色主题没有"沟"） */
  .theme-paper .spine::after {
    content: '';
    position: absolute;
    right: -24px;
    top: 0;
    bottom: 0;
    width: 24px;
    background: linear-gradient(90deg, rgba(10, 29, 51, 0.05), transparent);
    pointer-events: none;
  }

  /* S1：纸面主题反色跨页四边出血色边（整版实地印刷）；QA5 的压页内阴影仅深色主题需要，此处归零 */
  .theme-paper .sec-coverage {
    border-top: 3px solid var(--color-accent-deep);
    border-bottom: 3px solid var(--color-accent-deep);
    box-shadow: none;
  }

  .theme-paper .method-ring {
    stroke: rgba(10, 29, 51, 0.24);
  }

  .method-dot {
    fill: var(--color-accent-bright);
  }

  .m-label {
    fill: var(--color-text-on-dark);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .m-note {
    fill: var(--color-text-muted-on-dark);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
  }

  .m-flow {
    fill: var(--color-accent-bright);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  /* 三相说明阶梯下落：阶梯方向 = 管线流向，构图复述内容（comp-print §3） */
  .method-cols {
    margin-top: var(--space-7);
    row-gap: var(--space-6);
  }

  .phase-1 {
    grid-column: 1 / 5;
  }

  .phase-2 {
    grid-column: 5 / 9;
    margin-top: 40px;
  }

  .phase-3 {
    grid-column: 9 / 13;
    margin-top: 80px;
  }

  .phase-tag {
    margin: 0 0 var(--space-3);
    color: var(--color-accent-bright);
  }

  .phase-body {
    margin: 0;
    font-size: var(--support-size);
    line-height: 1.6;
    color: var(--color-text-muted-on-dark);
  }

  /* QA修复 第5条：节末右下 mono 预告行 —— 下一页整版实地印刷的物理暗示 */
  .method-next {
    margin: var(--space-7) 0 0;
    text-align: right;
    color: var(--color-text-soft-on-dark);
  }

  /* 右页边竖排 marginalia（≥1200px；verso 页的活页边） */
  .method-marginalia {
    display: none;
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
    writing-mode: vertical-rl;
    color: var(--color-text-soft-on-dark);
  }

  /* ============ SEC.03 COVERAGE — 中央跨页（缺陷4/S4）：反色插页升格为年鉴中央跨页 ============ */
  /* position: relative 且不设 z-index：mega 数字的 mix-blend 需要在根层叠上下文中取整页 backdrop */
  .sec-coverage {
    --sec-pt: 144px;
    --sec-pb: 0px;
    position: relative;
    background: var(--color-surface);
    color: var(--color-brand-ink);
    --crop-ink: rgba(10, 29, 51, 0.4);
    /* QA修复 第5条：白页突变保留（插页本应突变），但给足物理暗示 ——
       顶缘 3px 出血色边（对应纸面版既有出血边）+ 顶缘约 10px 内阴影模拟压页 */
    border-top: 3px solid var(--color-accent-deep);
    box-shadow: inset 0 10px 12px -4px rgba(2, 8, 20, 0.3);
  }

  .theme-paper .sec-coverage {
    --crop-ink: rgba(243, 245, 249, 0.45);
  }

  .sec-coverage .sec-head {
    border-color: var(--hairline-on-light);
    color: var(--color-text-muted-on-light);
  }

  .sec-coverage .reg-cross circle,
  .sec-coverage .reg-cross path {
    stroke: var(--color-text-muted-on-light);
  }

  .sec-coverage .sec-lede {
    color: var(--color-text-muted-on-light);
  }

  .sec-coverage .fig {
    border-color: var(--hairline-on-light);
  }

  .sec-coverage .fig-cap {
    border-color: var(--hairline-on-light);
    color: var(--color-text-muted-on-light);
  }

  /* 缺陷4修复：本节标题落右轴 col 7-12，标题块叠印图版上缘（负 margin 压进图版留白区） */
  .cov-intro {
    position: relative;
    z-index: 2;
    row-gap: var(--space-2);
    margin-bottom: calc(-1 * var(--space-8));
  }

  .cov-title {
    grid-column: 7 / 13;
    text-align: right;
  }

  .cov-lede {
    grid-column: 8 / 13;
    max-width: none;
  }

  /* S4 满版跨页舞台：100vw 出血，浮卡与骑线巨数的定位基准 */
  .cov-stage {
    position: relative;
    width: 100vw;
    margin-inline: var(--bleed);
    margin-top: var(--space-7);
  }

  .fig-plate {
    margin: 0;
    border-inline: 0;
    display: flex;
    flex-direction: column;
  }

  .fig-body-plate {
    flex: 1;
    display: flex;
    align-items: center;
    padding: var(--space-6) 0 var(--space-5);
  }

  .fig-body-plate svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* S1 语法：跨页图注在书口（右缘竖排），不在图下 */
  .fig-cap--spine {
    position: absolute;
    top: var(--space-6);
    right: 12px;
    display: block;
    border: 0;
    padding: 0;
    writing-mode: vertical-rl;
  }

  /* S4 骑线巨数：下半身骑出反色图版、压进下一节底色；difference 两主题通吃（folio 同款机制） */
  .cov-mega {
    position: absolute;
    right: max(var(--shell-gutter), calc((100vw - var(--shell-max)) / 2));
    bottom: 0;
    z-index: 5;
    margin: 0;
    transform: translateY(50%);
    text-align: right;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .cov-mega-num {
    display: block;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: clamp(4rem, 11vw, 10rem);
    font-weight: 440;
    letter-spacing: -0.03em;
    line-height: 0.9;
  }

  .cov-mega-label {
    display: block;
    margin-top: var(--space-2);
  }

  .grat-line {
    stroke: var(--hairline-on-light);
    stroke-width: 0.75;
  }

  .grat-label {
    fill: var(--color-text-muted-on-light);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  .cov-arc-g,
  .cov-dot-g {
    transition: opacity var(--duration-base) var(--ease-out);
    outline-offset: 3px;
  }

  .cov-arc-g.is-dim,
  .cov-dot-g.is-dim {
    opacity: 0.12;
    pointer-events: none;
  }

  /* S4：出血放大后图元跟上 —— 印刷图版线号，不是 dashboard 细线 */
  .cov-arc {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  .cov-hit {
    fill: none;
    stroke: transparent;
    stroke-width: 14;
    pointer-events: stroke;
  }

  .cov-arc-g:hover .cov-arc,
  .cov-arc-g:focus .cov-arc {
    stroke: var(--color-accent-bright);
    stroke-width: 2.6;
  }

  .cov-dot {
    fill: var(--color-accent);
  }

  .cov-ring {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0.3;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .cov-dot-g:hover .cov-ring,
  .cov-dot-g:focus .cov-ring {
    opacity: 1;
  }

  .cov-label {
    fill: var(--color-brand-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* S4：覆盖台 = 插页浮卡，叠在地图左下大西洋空区（z3；移动端回落文档流） */
  .console {
    position: absolute;
    left: max(var(--shell-gutter), calc((100vw - var(--shell-max)) / 2));
    bottom: var(--space-9);
    z-index: 3;
    width: 360px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--hairline-on-light);
    padding: var(--space-5);
    transform: rotate(-0.6deg);
    box-shadow: 0 14px 44px rgba(2, 8, 20, 0.2);
  }

  .console-title {
    margin: 0;
    color: var(--color-text-muted-on-light);
  }

  .region-btns {
    display: flex;
    flex-direction: column;
  }

  .region-btn {
    text-align: left;
    background: none;
    border: 0;
    border-top: 1px solid var(--hairline-on-light);
    padding: var(--space-3) var(--space-2);
    color: var(--color-brand-ink);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .region-btn:last-child {
    border-bottom: 1px solid var(--hairline-on-light);
  }

  /* QA1：hover 提色仅限非 active 钮，避免 active 蓝底上叠蓝字 */
  .region-btn:not([aria-pressed='true']):hover {
    color: var(--color-accent);
  }

  /* QA修复 第1条：active = accent 实底钮，前景恒白（不得再用 --color-text-on-dark，纸面下它是墨色）
     深色主题：#2563eb 白字 5.1:1 ✓ */
  .region-btn[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-text-on-accent);
  }

  /* QA1：纸面反色跨页内 accent 被提亮为 #6b93f0（白字不足 4.5:1）——active 钮底改 accent-deep（#123f9e，白字 9.4:1） */
  .theme-paper .sec-coverage .region-btn[aria-pressed='true'] {
    background: var(--color-accent-deep);
  }

  .readouts {
    margin: 0;
  }

  .readouts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    border-top: 1px solid var(--hairline-on-light);
    padding: var(--space-2) 0;
  }

  .readouts dt {
    color: var(--color-text-muted-on-light);
  }

  .readouts dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .readout-record {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: auto 0 0;
    border-top: 1px solid var(--hairline-on-light);
    padding-top: var(--space-3);
  }

  .readout-record-label {
    color: var(--color-text-muted-on-light);
  }

  #record-line {
    color: var(--color-accent);
    min-height: 2.4em;
  }

  /* ============ SEC.04 CAPABILITIES — 能力图版 + S5 打样台 ============ */
  .sec-capabilities {
    /* S4 骑线巨数下半身落在本节顶部，--sec-pt 放大留身位 */
    --sec-pt: 200px;
    --sec-pb: 128px;
  }

  .cap-head {
    align-items: start;
    row-gap: var(--space-6);
  }

