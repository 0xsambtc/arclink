---
// M2 变体 A —「勘测年鉴」融合版（docs/10 裁决：甲·年鉴主调 + 乙·地面站两个 signature）
// 页面主体组件：Props = { locale }；叙事文案全部来自 src/data/m2-atlas.copy.ts（en/zh 同构），
// mono 编号语言（SEC./FIG./IDX./PH./CAP./IND.、城市代码、KM/UTC/坐标）不翻译，双语共用。
// 数据唯一来源 = src/data/coverage.ts；图形唯一来源 = src/lib/arcfield.ts
// 宣言（提案首行）：页面上的任何元素，要么是排版系统本身（字、网格、编号、细线），
// 要么是带真实出处（城市·坐标·时间戳·口径）的编号图版（FIG.）；两者都不是——删。
import { cities, events, metrics, cityByCode } from '../../data/coverage';
import { arcBetween, generateArcfield, hashString, mulberry32, project } from '../../lib/arcfield';
import { atlasCopy } from '../../data/m2-atlas.copy';

interface Props {
  locale: 'en' | 'zh';
  /** 色调主题：dark=深色年鉴（默认）；paper=纸面年鉴（同一页面另一套 token，docs/10 色调探索） */
  theme?: 'dark' | 'paper';
}

const { locale, theme = 'dark' } = Astro.props;
const t = atlasCopy[locale];

const MAP_W = 1000;
const MAP_H = 500;

const fmtNum = (n: number) => n.toLocaleString('en-US');
const fmtLat = (lat: number) => `${Math.abs(lat).toFixed(4)}°${lat >= 0 ? 'N' : 'S'}`;
const fmtLng = (lng: number) => `${Math.abs(lng).toFixed(4)}°${lng >= 0 ? 'E' : 'W'}`;
const shortUtc = (utc: string) => `${utc.slice(5, 16).replace('T', ' ')}Z`; // 2026-07-14T09:32Z → 07-14 09:32Z
// 字典占位符注入（{n}/{r}/{m} → 构建时数字）
const fmt = (s: string, vals: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (_, k: string) => String(vals[k] ?? ''));

// —— 区域划分（可操作覆盖台，地面站 signature 2；区域叙事名来自字典）——
const regionOf: Record<string, string> = {
  ID: 'sea', SG: 'sea', TH: 'sea', VN: 'sea', PH: 'sea', MY: 'sea',
  AE: 'me', SA: 'me',
  KE: 'africa', NG: 'africa',
  BR: 'latam', MX: 'latam',
};
const regionDefs = (['all', 'sea', 'me', 'africa', 'latam'] as const).map((id) => ({
  id,
  label: t.coverage.regions[id],
}));

// —— 城市 → 平面投影点（arcfield.project，等距圆柱）——
const cityPts = cities.map((c) => {
  const [x, y] = project(c.lat, c.lng, MAP_W, MAP_H);
  return {
    ...c,
    x,
    y,
    region: regionOf[c.country],
    record: `${c.name.toUpperCase()} — ${c.code} · ${fmtLat(c.lat)} ${fmtLng(c.lng)} · ${c.country}`,
  };
});
const ptByCode = Object.fromEntries(cityPts.map((p) => [p.code, p]));

// —— 交付事件 → 弧线（arcBetween，lift 由记录种子确定，同种子同输出）——
const eventArcs = events.map((e, i) => {
  const a = ptByCode[e.from];
  const b = ptByCode[e.to];
  const r = mulberry32(hashString(`${e.from}-${e.to}-${e.utc}`))();
  const d = arcBetween(a.x, a.y, b.x, b.y, -(0.12 + r * 0.12));
  return {
    ...e,
    i,
    d,
    regions: [...new Set([a.region, b.region])].join(' '),
    caption: `${e.from} ↔ ${e.to} · ${fmtNum(e.km)} KM · ${e.utc}`,
    short: `${e.from} ↔ ${e.to} · ${fmtNum(e.km)} KM · ${shortUtc(e.utc)}`,
  };
});

const totalKm = events.reduce((s, e) => s + e.km, 0);
const maxKm = Math.max(...events.map((e) => e.km));
const lastUtc = events.map((e) => e.utc).sort().at(-1) ?? '';

// —— 区域读数（覆盖台侧栏，构建时预计算）——
const regionStats = Object.fromEntries(
  regionDefs.map((rg) => {
    const evs = rg.id === 'all' ? eventArcs : eventArcs.filter((e) => e.regions.split(' ').includes(rg.id));
    const nodes = rg.id === 'all' ? cityPts : cityPts.filter((p) => p.region === rg.id);
    const kmSum = evs.reduce((s, e) => s + e.km, 0);
    return [
      rg.id,
      {
        label: rg.label,
        nodes: String(nodes.length),
        records: String(evs.length),
        km: `${fmtNum(kmSum)} KM`,
        kmNum: kmSum, // S4 mega 读数 countUp 用数值
        last: evs.map((e) => e.utc).sort().at(-1) ?? '—',
      },
    ];
  })
);

// —— 图版裁切（全图 1000×500 → 覆盖区域 + 图边留白）——
// 缺陷4/S4：水平留白 70 → 130，经纬网延伸出城市簇、画到满版跨页的物理屏缘
const xs = cityPts.map((p) => p.x);
const ys = cityPts.map((p) => p.y);
const vb = {
  x: Math.min(...xs) - 130,
  y: Math.min(...ys) - 70,
  w: Math.max(...xs) - Math.min(...xs) + 260,
  h: Math.max(...ys) - Math.min(...ys) + 125,
};

// —— S2 整版字标图版：12 条真实 eventArcs 的地图坐标变换进字标包围盒（critique-creativity S2）——
const WM_W = 1000;
const WM_H = 192;
const wmBox = {
  x: Math.min(...xs) - 24,
  y: Math.min(...ys) - 56,
  w: Math.max(...xs) - Math.min(...xs) + 48,
  h: Math.max(...ys) - Math.min(...ys) + 96,
};
const wmTransform = `scale(${(WM_W / wmBox.w).toFixed(4)} ${(WM_H / wmBox.h).toFixed(4)}) translate(${(-wmBox.x).toFixed(1)} ${(-wmBox.y).toFixed(1)})`;
const viewBox = `${vb.x.toFixed(0)} ${vb.y.toFixed(0)} ${vb.w.toFixed(0)} ${vb.h.toFixed(0)}`;
const gratLng = [-120, -90, -60, -30, 0, 30, 60, 90, 120, 150]
  .map((lng) => ({ lng, x: ((lng + 180) / 360) * MAP_W }))
  .filter((g) => g.x > vb.x && g.x < vb.x + vb.w);
const gratLat = [30, 0, -30]
  .map((lat) => ({ lat, y: ((90 - lat) / 180) * MAP_H }))
  .filter((g) => g.y > vb.y && g.y < vb.y + vb.h);
const lngLabel = (lng: number) => (lng === 0 ? '0°' : `${Math.abs(lng)}°${lng > 0 ? 'E' : 'W'}`);
const labeledMeridians = [-90, 0, 60, 120];

// 城市代码标签的手动避让（SEA 簇密集）
const labelPos: Record<string, { dx: number; dy: number; anchor: 'start' | 'end' }> = {
  JKT: { dx: 7, dy: 12, anchor: 'start' },
  SIN: { dx: 8, dy: 5, anchor: 'start' },
  BKK: { dx: -3, dy: -9, anchor: 'end' },
  SGN: { dx: 8, dy: -5, anchor: 'start' },
  MNL: { dx: 8, dy: 2, anchor: 'start' },
  KUL: { dx: -8, dy: 2, anchor: 'end' },
  DXB: { dx: 8, dy: -5, anchor: 'start' },
  RUH: { dx: -8, dy: 5, anchor: 'end' },
  NBO: { dx: 8, dy: 9, anchor: 'start' },
  LOS: { dx: -8, dy: 5, anchor: 'end' },
  SAO: { dx: 8, dy: 7, anchor: 'start' },
  MEX: { dx: -8, dy: -7, anchor: 'end' },
};

// —— SEC.01 规格表（specimen；label/note 叙事来自字典）——
const specimenValues = [metrics.citiesCovered, metrics.countries, metrics.tasksCompleted, totalKm];
const specimenRows = t.index.rows.map((row, i) => ({
  idx: `IDX.${String(i + 1).padStart(2, '0')}`,
  label: row.label,
  value: specimenValues[i],
  note: fmt(row.note, { n: events.length }),
}));

// —— SEC.02 工程图版（采集 → 验证 → 交付；图内 mono 标签不翻译，正文来自字典）——
const methodY = 150;
const phases = [
  { n: 'PH.01', name: 'COLLECT', x: 110, note: 'FIELD CAPTURE · GNSS + UTC TIMESTAMP', body: t.method.phases[0] },
  { n: 'PH.02', name: 'VERIFY', x: 450, note: 'DUAL-SOURCE MATCH · CHECKSUM', body: t.method.phases[1] },
  { n: 'PH.03', name: 'DELIVER', x: 790, note: 'SIGNED MANIFEST · SLA HANDOFF', body: t.method.phases[2] },
];
const methodArcs = [
  { d: arcBetween(110, methodY, 450, methodY, -0.26), label: 'RAW TRACE', lx: 280, ly: 96 },
  { d: arcBetween(450, methodY, 790, methodY, -0.26), label: 'VERIFIED PACKET', lx: 620, ly: 96 },
];
const exemplar = eventArcs[0];

// —— SEC.04 平台能力（六图版卡片：FIG 重编号 06–11，字标图版占用 FIG.01；缺陷7：viewBox 高 130→170）——
const capPlates = t.capabilities.features.map((f, i) => ({
  ...f,
  cap: `CAP.${String(i + 1).padStart(2, '0')}`,
  fig: `FIG.${String(i + 6).padStart(2, '0')}`,
  paths: generateArcfield({ width: 260, height: 170, count: 7, amplitude: 0.3, seed: f.seed }),
}));

// —— S5 打样台默认图版（无 JS 降级态；客户端脚本以同一 generateArcfield 重算）——
const proofPaths = generateArcfield({ width: 260, height: 150, count: 9, amplitude: 0.3, seed: 'ARCLINK' });

// —— SEC.05 行业索引（Obys 式行式档案；Mapping 首位；QA修复 第7条：description 常显不再 hover 门控；
// 每行弧场肉眼可辨差异 —— count=3+index、amplitude=0.15+index*0.06，种子仍为行业 key）——
const industryRows = t.industries.items.map((it, i) => ({
  ...it,
  ind: `IND.${String(i + 1).padStart(2, '0')}`,
  paths: generateArcfield({ width: 240, height: 130, count: 3 + i, amplitude: 0.15 + i * 0.06, seed: it.key }),
}));

const buildDate = new Date().toISOString().slice(0, 10);
const globePayload = { cities: cities.map((c) => ({ lat: c.lat, lng: c.lng })) };
const heroStatus = `ARCLINK ANNUAL — SEC.00 / FRONTISPIECE · INIT ${fmtLat(cityByCode.SIN.lat)} ${fmtLng(cityByCode.SIN.lng)} · LINK UP · ${metrics.citiesCovered} NODES`;
const defaultRecord = eventArcs.find((e) => e.utc === lastUtc)?.caption ?? eventArcs[0].caption;
const megaSuffix = t.press.megaSuffix; // inline 脚本 define:vars 用
---

<main id="main" class:list={['atlas', theme === 'paper' && 'theme-paper']}>
  <!-- ============ SEC.00 / FRONTISPIECE — 整版字标图版（S2）+ 右上档案地球（S3 归档素材） ============ -->
  <section class="sec sec-hero" data-folio="00" data-secname="FRONTISPIECE">
    <div class="shell hero-shell">
      <p class="hero-status mono-caption"><span class="js-status">{heroStatus}</span></p>

      <!-- cobe 地球降级为右上小型档案图版（懒加载/移动端降级逻辑保留）；
           QA修复 第3条：跨节 FLIP/槽位删除 —— 滚动离开 hero 时在原图框内收缩归档 + ARCHIVED 图章原地盖下 -->
      <figure class="hero-figure">
        <div class="fig-frame-border" aria-hidden="true"><span class="crops" aria-hidden="true"></span></div>
        <div class="fig-body-hero">
          <div class="globe-wrap">
            <canvas id="hero-globe" role="img" aria-label={fmt(t.aria.globe, { n: metrics.citiesCovered })}></canvas>
          </div>
          <svg class="hero-map-fallback" viewBox={viewBox} role="img" aria-label={fmt(t.aria.mapFallback, { n: metrics.citiesCovered })}>
            <g aria-hidden="true">
              {gratLng.map((g) => (
                <line class="grat-line-dark" x1={g.x} y1={vb.y} x2={g.x} y2={vb.y + vb.h} />
              ))}
              {gratLat.map((g) => (
                <line class="grat-line-dark" x1={vb.x} y1={g.y} x2={vb.x + vb.w} y2={g.y} />
              ))}
            </g>
            {cityPts.map((p) => (
              <g transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
                <circle class="fb-dot" r="3" />
                <text
                  class="fb-label"
                  x={labelPos[p.code].dx}
                  y={labelPos[p.code].dy}
                  text-anchor={labelPos[p.code].anchor}
                >
                  {p.code}
                </text>
              </g>
            ))}
          </svg>
        </div>
        <figcaption class="hero-figcaption mono-caption">
          <span>{fmt(t.press.globePlate, { n: metrics.citiesCovered })}</span>
          <!-- QA修复 第2条：蓝点含义标注（mono 编号语言，双语共用） -->
          <span>{fmt(t.press.markerNote, { n: metrics.citiesCovered })}</span>
          <span>AS OF {metrics.asOf}</span>
        </figcaption>
        <!-- QA修复 第3条：归档图章原地盖在图框角；无 JS / 减动效 = 直接呈现终态（CSS rotate -4°） -->
        <p class="archive-stamp mono-caption" aria-hidden="true">{fmt(t.press.stamp, { d: metrics.asOf })}</p>
      </figure>

      <!-- S2 整版字标图版：ARCLINK 巨字即 FIG.01，12 条真实交付弧线在字腔内部描画（clipPath 内 <text> 用页面 Inter，无需转曲） -->
      <figure class="hero-plate">
        <span class="crops" aria-hidden="true"></span>
        <h1 class="hero-title" aria-label="ARCLINK">
          <span class="wm-mask">
            <svg class="wm-svg" viewBox={`0 0 ${WM_W} ${WM_H}`} preserveAspectRatio="xMidYMax meet" aria-hidden="true">
              <defs>
                <clipPath id="wm-clip">
                  <text class="wm-clip-text" x="0" y={WM_H - 16} textLength={WM_W} lengthAdjust="spacingAndGlyphs">ARCLINK</text>
                </clipPath>
              </defs>
              <g clip-path="url(#wm-clip)">
                <rect class="wm-fill" width={WM_W} height={WM_H} />
                <g transform={wmTransform}>
                  {eventArcs.map((e) => (
                    <path class="wm-arc" d={e.d} pathLength="1" vector-effect="non-scaling-stroke" />
                  ))}
                </g>
              </g>
            </svg>
          </span>
          <span class="hero-title-fallback" aria-hidden="true">ARCLINK</span>
        </h1>
        <figcaption class="hero-plate-cap mono-caption">
          <span>{t.press.wordmark}</span>
          <span>AS OF {metrics.asOf}</span>
        </figcaption>
      </figure>

      <div class="hero-bottom grid-12">
        <div class="hero-intro">
          <p class="hero-deck">{t.hero.deck}</p>
          <div class="hero-links">
            <a class="hero-jump mono-caption" href="#coverage">{t.hero.jump}</a>
          </div>
        </div>
        <!-- 插页构件：log 卡骑 SEC.00/01 页界（comp-print 胆量时刻②） -->
        <aside class="hero-log tipped" aria-label={t.aria.log}>
          <p class="hero-log-title mono-caption">{t.hero.logTitle} ({events.length})</p>
          <ol class="log-lines">
            {eventArcs.map((e) => (
              <li class="log-line mono-caption" title={e.caption}>
                <span class="log-idx">R.{String(e.i + 1).padStart(2, '0')}</span>
                <span>{e.short}</span>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ SEC.01 / INDEX — 信任数字 specimen（缺陷6；QA修复 第3条：归档槽位删除，归档在 hero 原位完成） ============ -->
  <section class="sec sec-index" data-folio="01" data-secname="INDEX">
    <div class="shell">
      <header class="sec-head mono-caption" data-reveal>
        <span>SEC.01 / INDEX</span>
        <svg class="reg-cross" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="3.6" /><path d="M6 0v12M0 6h12" /></svg>
      </header>

      <div class="index-head grid-12">
        <div class="index-intro">
          <h2 class="sec-title" data-reveal>{t.index.title}</h2>
          <p class="sec-lede" data-reveal>{t.index.lede}</p>
        </div>
      </div>

      <ol class="spec-list">
        {specimenRows.map((row, i) => (
          <li class="spec-row">
            <span class="row-rule" aria-hidden="true"></span>
            <span class="spec-idx mono-caption">{row.idx}</span>
            <span class="spec-label">{row.label}</span>
            <span class="spec-value"><span class="spec-num" data-count={row.value}>{fmtNum(row.value)}</span></span>
            <span class="spec-side">
              {i === 3 && (
                <figure class="fig fig-ticks">
                  <div class="ticks" role="img" aria-label={fmt(t.aria.ticks, { r: events.length, m: fmtNum(maxKm) })}>
                    {eventArcs.map((e) => (
                      <span
                        class="tick"
                        style={`height:${Math.round(8 + (e.km / maxKm) * 56)}px`}
                        title={`R.${String(e.i + 1).padStart(2, '0')} · ${e.caption}`}
                      ></span>
                    ))}
                  </div>
                  <figcaption class="fig-cap mono-caption">
                    <span>FIG.03 — KM PER RECORD</span>
                    <span>MAX {fmtNum(maxKm)} KM</span>
                  </figcaption>
                </figure>
              )}
              <span class="spec-note mono-caption">{row.note}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="spec-footnote mono-caption" data-reveal>
        AS OF {metrics.asOf} UTC — {t.index.footnote}
      </p>
    </div>
  </section>

  <!-- ============ SEC.02 / METHOD — verso 页：右轴标题 + 图版左出血 + 阶梯三相（缺陷1） ============ -->
  <section class="sec sec-method" data-folio="02" data-secname="METHOD">
    <div class="shell">
      <header class="sec-head sec-head--verso mono-caption" data-reveal>
        <span>SEC.02 / METHOD</span>
        <svg class="reg-cross" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="3.6" /><path d="M6 0v12M0 6h12" /></svg>
      </header>
      <div class="method-head grid-12">
        <h2 class="sec-title method-title" data-reveal>{t.method.title}</h2>
        <p class="sec-lede method-lede" data-reveal>{t.method.lede}</p>
      </div>

      <figure class="fig fig-method" data-reveal>
        <div class="fig-body-method">
          <svg viewBox="0 0 900 250" role="img" aria-label={t.aria.methodFig}>
            <line class="method-base" x1="60" y1={methodY} x2="840" y2={methodY} aria-hidden="true" />
            {methodArcs.map((a) => (
              <g aria-hidden="true">
                <path class="method-arc" d={a.d} />
                <text class="m-flow" x={a.lx} y={a.ly} text-anchor="middle">{a.label}</text>
              </g>
            ))}
            {phases.map((ph) => (
              <g>
                <circle class="method-ring" cx={ph.x} cy={methodY} r="16" />
                <circle class="method-dot" cx={ph.x} cy={methodY} r="6" />
                <text class="m-label" x={ph.x} y={methodY + 38} text-anchor="middle">{ph.n} — {ph.name}</text>
                <text class="m-note" x={ph.x} y={methodY + 56} text-anchor="middle">{ph.note}</text>
              </g>
            ))}
          </svg>
        </div>
        <figcaption class="fig-cap mono-caption">
          <span>FIG.04 — METHOD DIAGRAM</span>
          <span>EXEMPLAR RECORD: {exemplar.caption}</span>
        </figcaption>
      </figure>

      <div class="method-cols grid-12">
        {phases.map((ph, i) => (
          <div class={`phase phase-${i + 1}`} data-reveal>
            <p class="phase-tag mono-caption">{ph.n} — {ph.name}</p>
            <p class="phase-body">{ph.body}</p>
          </div>
        ))}
      </div>
      <!-- QA修复 第5条：节末右下 mono 预告行 —— 为下一节反色跨页的突变给足物理暗示 -->
      <p class="method-next mono-caption" data-reveal>{t.method.next}</p>
      <p class="method-marginalia mono-caption" aria-hidden="true">{t.press.methodMarginalia}</p>
    </div>
  </section>

  <!-- ============ SEC.03 / COVERAGE — 中央跨页（S4/缺陷4）：满版出血图版 + 浮卡覆盖台 + 骑线巨数 ============ -->
  <section class="sec sec-coverage" id="coverage" data-folio="03" data-secname="COVERAGE">
    <div class="shell">
      <header class="sec-head mono-caption" data-reveal>
        <span>SEC.03 / COVERAGE — PLATE</span>
        <svg class="reg-cross" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="3.6" /><path d="M6 0v12M0 6h12" /></svg>
      </header>
      <!-- 缺陷4：本节标题落右轴（col 7-12），标题块叠印图版上缘 -->
      <div class="cov-intro grid-12">
        <h2 class="sec-title cov-title" data-reveal>{t.coverage.title}</h2>
        <p class="sec-lede cov-lede" data-reveal>{t.coverage.lede}</p>
      </div>

      <div class="cov-stage">
        <figure class="fig fig-plate" data-reveal>
          <span class="crops" aria-hidden="true"></span>
          <div class="fig-body-plate">
            <svg id="cov-plate" viewBox={viewBox} role="img" aria-label={fmt(t.aria.plate, { n: metrics.citiesCovered, r: events.length })}>
              <g aria-hidden="true">
                {gratLng.map((g) => (
                  <line class="grat-line" x1={g.x} y1={vb.y} x2={g.x} y2={vb.y + vb.h} />
                ))}
                {gratLat.map((g) => (
                  <line class="grat-line" x1={vb.x} y1={g.y} x2={vb.x + vb.w} y2={g.y} />
                ))}
                {gratLng.filter((g) => labeledMeridians.includes(g.lng)).map((g) => (
