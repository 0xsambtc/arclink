<!-- 可操作覆盖台（功能而非动效：不依赖 motion 偏好；无 JS 时默认 ALL 全量可见）
     S4 增补：切区域时 mega 读数滚动 + match 弧线 dashoffset 重放（减动效时直接呈现终值） -->
<script is:inline define:vars={{ regionStats, megaSuffix }}>
  const plate = document.getElementById('cov-plate');
  const buttons = Array.from(document.querySelectorAll('.region-btn'));
  if (plate && buttons.length) {
    const mega = document.getElementById('cov-mega-num');
    const megaLabel = document.getElementById('cov-mega-label');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;

    const setMega = (to) => {
      if (!mega) return;
      const from = Number((mega.textContent || '0').replace(/,/g, '')) || 0;
      if (reduced) {
        mega.textContent = to.toLocaleString('en-US');
        return;
      }
      cancelAnimationFrame(raf);
      const t0 = performance.now();
      const dur = 700;
      const step = (now) => {
        const p = Math.min(1, (now - t0) / dur);
        const e = 1 - Math.pow(1 - p, 3);
        mega.textContent = Math.round(from + (to - from) * e).toLocaleString('en-US');
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    const replayArcs = (id) => {
      if (reduced) return;
      plate.querySelectorAll('.cov-arc-g').forEach((g) => {
        const match = id === 'all' || g.dataset.regions.split(' ').includes(id);
        if (!match) return;
        const p = g.querySelector('.cov-arc');
        if (!p) return;
        const len = p.getTotalLength();
        p.style.transition = 'none';
        p.style.strokeDasharray = String(len);
        p.style.strokeDashoffset = String(len);
        void p.getBoundingClientRect();
        p.style.transition = 'stroke-dashoffset 0.9s cubic-bezier(0.22, 0.61, 0.36, 1)';
        p.style.strokeDashoffset = '0';
      });
    };

    const setRegion = (id) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.region === id)));
      plate.querySelectorAll('[data-regions]').forEach((el) => {
        const match = id === 'all' || el.dataset.regions.split(' ').includes(id);
        el.classList.toggle('is-dim', !match);
      });
      const s = regionStats[id];
      document.getElementById('ro-region').textContent = s.label;
      document.getElementById('ro-nodes').textContent = s.nodes;
      document.getElementById('ro-records').textContent = s.records;
      document.getElementById('ro-km').textContent = s.km;
      document.getElementById('ro-last').textContent = s.last;
      if (megaLabel) megaLabel.textContent = `${s.label} — ${megaSuffix}`;
      setMega(s.kmNum);
      replayArcs(id);
    };
    buttons.forEach((b) => b.addEventListener('click', () => setRegion(b.dataset.region)));

    // Proof of life：hover / focus 任一图元 → 侧栏读出真实记录（城市/km/UTC）
    const line = document.getElementById('record-line');
    plate.querySelectorAll('[data-record]').forEach((el) => {
      const show = () => { line.textContent = el.dataset.record; };
      el.addEventListener('mouseenter', show);
      el.addEventListener('focus', show);
    });
  }
</script>

<script>
  // Folio 页码 + 书脊轨（缺陷9）更新：同一个 IntersectionObserver 喂两处（非动效，reduced-motion 下同样工作）
  const folioNum = document.getElementById('folio-num');
  const spineSec = document.getElementById('spine-sec');
  const spineTicks = Array.from(document.querySelectorAll<HTMLElement>('.spine-tick'));
  const folioSecs = document.querySelectorAll<HTMLElement>('[data-folio]');
  if (folioNum && folioSecs.length) {
    const folioObs = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          const el = en.target as HTMLElement;
          const n = el.dataset.folio ?? '00';
          folioNum.textContent = n;
          if (spineSec) spineSec.textContent = `SEC.${n} / ${el.dataset.secname ?? ''}`;
          spineTicks.forEach((tk) => tk.classList.toggle('is-on', tk.dataset.tick === n));
        }),
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    folioSecs.forEach((s) => folioObs.observe(s));
  }
</script>

<script>
  // cobe globe：IntersectionObserver 懒初始化；移动端不初始化（CSS 显示静态 SVG 点阵）；
  // reduced-motion：不旋转、markers 全量直接呈现。
  import createGlobe from 'cobe';

  const figure = document.querySelector('.hero-figure');
  const canvas = document.getElementById('hero-globe') as HTMLCanvasElement | null;
  const dataEl = document.getElementById('atlas-data');

  if (figure && canvas && dataEl && !window.matchMedia('(max-width: 760px)').matches) {
    const payload = JSON.parse(dataEl.textContent || '{"cities":[]}');
    const markers = (payload.cities || []).map((c: { lat: number; lng: number }) => ({
      location: [c.lat, c.lng] as [number, number],
      size: 0.06,
    }));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        figure.classList.add('globe-on');
        const size = canvas.offsetWidth || 520;
        let phi = 4.4;
        const t0 = performance.now();
        // 纸面主题：冷纸浅色地球（配色方案 A「NORTH PAPER」：暖米调 → 冷灰蓝调）；深色主题不变
        const paper = !!canvas.closest('.theme-paper');
        const globe = createGlobe(canvas, {
          devicePixelRatio: 2,
          width: size * 2,
          height: size * 2,
          phi,
          theta: 0.2,
          dark: paper ? 0 : 1,
          diffuse: 1.2,
          mapSamples: 16000,
          // QA修复 第4条：暗色主题 mapBrightness 4→6、baseColor 提亮，球体轮廓在 #030b1d 上可辨（纸面不变）
          mapBrightness: paper ? 1.6 : 6,
          baseColor: paper ? [0.85, 0.87, 0.91] : [0.12, 0.18, 0.3],
          markerColor: paper ? [0.08, 0.49, 0.99] : [0.2, 0.47, 1],
          glowColor: paper ? [0.91, 0.93, 0.96] : [0.08, 0.16, 0.33],
          markers: reduced ? markers : [],
        });
        // cobe v2 无 onRender：自建 rAF 循环驱动旋转 + 开机序列逐城点亮（地面站 signature 1）
        // QA修复 第2条：marker 不再按切片突现 —— 每颗点按自身 age 从 0 缓动生长到 0.06
        // （约 600ms ease-out；age = now - (t0 + 900 + i*260)），到位后常驻、不消失
        if (!reduced) {
          const tick = () => {
            phi += 0.003;
            const now = performance.now();
            globe.update({
              phi,
              markers: markers
                .map((m: { location: [number, number]; size: number }, i: number) => {
                  const age = now - (t0 + 900 + i * 260);
                  const p = age <= 0 ? 0 : Math.min(1, age / 600);
                  return { location: m.location, size: 0.06 * (1 - Math.pow(1 - p, 3)) };
                })
                .filter((m: { size: number }) => m.size > 0),
            });
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { rootMargin: '160px' }
    );
    io.observe(figure);
  }
</script>

<script>
  // GSAP 编排 — 全部包在 prefers-reduced-motion: no-preference 内；
  // 初始隐藏态一律由 gsap.set 从 JS 设置（无 JS / reduced-motion 时内容直接可见）。
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const cleanups: Array<() => void> = [];

    // SEC.00 开机序列：mono 状态行 type-on（仅一次）
    const status = document.querySelector('.js-status');
    if (status) {
      const full = status.textContent ?? '';
      const st = { n: 0 };
      status.textContent = '';
      gsap.to(st, {
        n: full.length,
        duration: Math.min(2.4, full.length * 0.022),
        ease: 'none',
        delay: 0.05,
        onUpdate: () => {
          status.textContent = full.slice(0, Math.round(st.n));
        },
      });
    }

    // S2 字标图版入场：整块 mask 升起 + 字腔内 12 条真实交付弧描画（无 JS / 减动效时静态全绘）
    const wm = document.querySelector('.wm-svg');
    if (wm) {
      gsap.set(wm, { yPercent: 106 });
      gsap.to(wm, { yPercent: 0, duration: 1.0, ease: 'power3.out', delay: 0.25 });
      const wmArcs = gsap.utils.toArray<SVGPathElement>('.wm-arc');
      if (wmArcs.length) {
        gsap.set(wmArcs, { strokeDasharray: 1, strokeDashoffset: 1 });
        gsap.to(wmArcs, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut', stagger: 0.05, delay: 0.9 });
      }
    }

    // globe 图版浮现（QA修复 第3条：入场改作用于整只 figure —— 原位归档的收缩单独作用 .fig-body-hero，两支 tween 不抢同一元素）
    gsap.set('.hero-figure', { opacity: 0, scale: 0.96 });
    gsap.to('.hero-figure', { opacity: 1, scale: 1, duration: 1.1, ease: 'power2.out', delay: 0.8 });

    // 标语与跳转
    gsap.set(['.hero-deck', '.hero-links'], { opacity: 0, y: 18 });
    gsap.to(['.hero-deck', '.hero-links'], { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.12, delay: 1.5 });

    // 右侧 log 逐行追加 + 每 4s 轮转高亮（唯一不停的元素：ticker 本体是数据）
    const logTitle = document.querySelector('.hero-log-title');
    const lines = gsap.utils.toArray<HTMLElement>('.log-line');
    if (logTitle && lines.length) {
      gsap.set(logTitle, { opacity: 0 });
      gsap.to(logTitle, { opacity: 1, duration: 0.4, delay: 1.3 });
      gsap.set(lines, { opacity: 0, x: 14 });
      gsap.to(lines, { opacity: 1, x: 0, duration: 0.45, ease: 'power2.out', stagger: 0.28, delay: 1.4 });
      let live = 0;
      lines[0].classList.add('is-live');
      const cycle = window.setInterval(() => {
        lines[live].classList.remove('is-live');
        live = (live + 1) % lines.length;
        lines[live].classList.add('is-live');
      }, 4000);
      cleanups.push(() => window.clearInterval(cycle));
    }

    // 通用排版入场
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.set(el, { opacity: 0, y: 24 });
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 86%' },
      });
    });

    // 规格表 countUp
    document.querySelectorAll<HTMLElement>('.spec-num').forEach((el) => {
      const end = Number(el.dataset.count || '0');
      const st = { v: 0 };
      el.textContent = '0';
      gsap.to(st, {
        v: end,
        duration: 1.4,
        ease: 'power2.out',
        onUpdate: () => {
          el.textContent = Math.round(st.v).toLocaleString('en-US');
        },
        scrollTrigger: { trigger: el, start: 'top 85%' },
      });
    });

    // FIG.02 刻度条
    const ticks = gsap.utils.toArray<HTMLElement>('.tick');
    if (ticks.length) {
      gsap.set(ticks, { scaleY: 0, transformOrigin: '50% 100%' });
      gsap.to(ticks, {
        scaleY: 1,
        duration: 0.6,
        ease: 'power2.out',
        stagger: 0.04,
        scrollTrigger: { trigger: '.fig-ticks', start: 'top 82%' },
      });
    }

    // 描画：工程图版弧线 + 覆盖台弧线（stroke-dashoffset）
    gsap.utils.toArray<SVGPathElement>('.method-arc, .cov-arc').forEach((p) => {
      const len = p.getTotalLength();
      gsap.set(p, { strokeDasharray: len, strokeDashoffset: len });
      gsap.to(p, {
        strokeDashoffset: 0,
        duration: 1.2,
        ease: 'power2.inOut',
        scrollTrigger: { trigger: p.closest('.fig'), start: 'top 78%' },
      });
    });

    // 覆盖台节点点亮（内层 g，不占用外层 is-dim 的 opacity）
    const dotInners = gsap.utils.toArray<SVGGElement>('.cov-dot-inner');
    if (dotInners.length) {
      gsap.set(dotInners, { opacity: 0, scale: 0.5, transformOrigin: '50% 50%' });
      gsap.to(dotInners, {
        opacity: 1,
        scale: 1,
        duration: 0.5,
        ease: 'power2.out',
        stagger: 0.05,
        scrollTrigger: { trigger: '#cov-plate', start: 'top 80%' },
      });
    }

    // 动效动词分化（critique-creativity：删通用 fade-up，各内容类型专属动词）——
    // 表格行 = hairline 从 0 到 100% 划出（spec-row / idx-row 的 .row-rule，transform 纪律内）
    gsap.utils.toArray<HTMLElement>('.row-rule').forEach((el) => {
      gsap.set(el, { scaleX: 0, transformOrigin: '0 50%' });
      gsap.to(el, {
        scaleX: 1,
        duration: 0.6,
        ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    });

    // 缺陷7 + QA修复 第6条：能力卡弧场进入视口先描到 70%（终态交还 CSS，hover 全描由 CSS 承接）
    gsap.utils.toArray<HTMLElement>('.cap-card').forEach((card) => {
      const paths = card.querySelectorAll<SVGPathElement>('.cap-field path');
      if (!paths.length) return;
      gsap.set(paths, { strokeDashoffset: 1 });
      gsap.to(paths, {
        strokeDashoffset: 0.3,
        duration: 0.9,
        ease: 'power2.out',
        stagger: 0.06,
        scrollTrigger: { trigger: card, start: 'top 85%' },
        onComplete: () => gsap.set(paths, { clearProps: 'strokeDashoffset' }),
      });
    });

    // 刊末宣言：display-m 逐行升起（mask 结构与 hero 字标同语言；无 JS 时直接可见）
    const maniTexts = gsap.utils.toArray<HTMLElement>('.manifesto-text');
    if (maniTexts.length) {
      gsap.set(maniTexts, { yPercent: 112 });
      gsap.to(maniTexts, {
        yPercent: 0,
        duration: 0.9,
        ease: 'power3.out',
        stagger: 0.16,
        scrollTrigger: { trigger: '.manifesto-lines', start: 'top 80%' },
      });
    }

    return () => cleanups.forEach((fn) => fn());
  });

  // S3「原位归档」v3（QA修复 第3条）：跨节 FLIP 与 SEC.01 槽位删除 ——
  // 滚动离开 hero 时地球图版在原图框内收缩至 0.92 + ARCHIVED 图章原地盖下（保留原 1.3→1 / -6°→-4° 图章动效）；
  // hero 其余元素（LOG 面板 / hero 描述）不再淡至 0.16，全程全透明度可读；
  // 全程 transform/opacity；无 JS / 减动效时图章直接呈现 CSS 终态、图版不缩
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 761px)', () => {
    const bodyEl = document.querySelector<HTMLElement>('.fig-body-hero');
    const stampEl = document.querySelector<HTMLElement>('.archive-stamp');
    if (!bodyEl || !stampEl) return;

    gsap.set(stampEl, { opacity: 0, scale: 1.3, rotate: -6, transformOrigin: '80% 50%' });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '.sec-hero',
        start: 'top top',
        end: 'bottom 70%',
        scrub: true,
        invalidateOnRefresh: true,
      },
    });
    tl.to(bodyEl, { scale: 0.92, transformOrigin: '50% 50%', ease: 'none', duration: 1 }, 0)
      .to(stampEl, { opacity: 1, scale: 1, rotate: -4, ease: 'power2.out', duration: 0.2 }, 0.72);
  });
</script>

<script>
  // S5 打样台：seed → 9 条确定性弧线。arcfield 是纯 TS，客户端直接打包 import（零新依赖）。
  // 无 JS：面板显示服务端预生成的默认图版；减动效：新图形直接呈现不描画。
  import { generateArcfield } from '../../lib/arcfield';

  const proofInput = document.getElementById('proof-seed') as HTMLInputElement | null;
  const proofField = document.getElementById('proof-field');
  const proofCap = document.getElementById('proof-caption');
  const proofDl = document.getElementById('proof-download') as HTMLAnchorElement | null;

  if (proofInput && proofField && proofCap && proofDl) {
    const capTpl = proofCap.textContent ?? '';
    const proofReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let objUrl = '';
    let firstRender = true;

    const escapeXml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    // 下载文件：把图框 + 裁切角线 + caption 一并烘进 SVG（用户拿走带 ARCLINK 印刷 chrome 的个人图版）
    const buildSvg = (paths: string[], capText: string) => {
      const arcs = paths
        .map((p) => `<path d="${p}" fill="none" stroke="#2563eb" stroke-width="1.2"/>`)
        .join('');
      const crop = (x: number, y: number, sx: number, sy: number) =>
        `<path d="M ${x} ${y + 8 * sy} L ${x} ${y} L ${x + 8 * sx} ${y}" fill="none" stroke="#8b99b0" stroke-width="1"/>`;
      return (
        `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 214" width="600" height="428">` +
        `<rect width="300" height="214" fill="#030b1d"/>` +
        `<rect x="19.5" y="19.5" width="261" height="151" fill="none" stroke="rgba(255,255,255,0.28)"/>` +
        crop(12, 12, 1, 1) +
        crop(288, 12, -1, 1) +
        crop(12, 178, 1, -1) +
        crop(288, 178, -1, -1) +
        `<g transform="translate(20 20)">${arcs}</g>` +
        `<text x="20" y="196" font-family="ui-monospace, Menlo, monospace" font-size="8.5" letter-spacing="0.5" fill="#b9c3d5">${escapeXml(capText)}</text>` +
        `<text x="280" y="196" text-anchor="end" font-family="ui-monospace, Menlo, monospace" font-size="8.5" letter-spacing="0.5" fill="#b9c3d5">ARCLINK ANNUAL — EDITION 2026</text>` +
        `</svg>`
      );
    };

    const render = (seedRaw: string) => {
      const seed = (seedRaw.trim() || 'ARCLINK').slice(0, 48);
      const paths = generateArcfield({ width: 260, height: 150, count: 9, amplitude: 0.3, seed });
      const els = Array.from(proofField.querySelectorAll('path'));
      els.forEach((p, i) => {
        p.setAttribute('d', paths[i]);
        if (!proofReduced && !firstRender) {
          // 重描（pathLength=1 + dashoffset，transform/dashoffset 纪律内）
          p.style.transition = 'none';
          p.style.strokeDasharray = '1';
          p.style.strokeDashoffset = '1';
          void p.getBoundingClientRect();
          p.style.transition = `stroke-dashoffset 0.8s ${(0.05 * i).toFixed(2)}s cubic-bezier(0.22, 0.61, 0.36, 1)`;
          p.style.strokeDashoffset = '0';
        }
      });
      const capText = capTpl.replace(/«[^»]*»/, `«${seed.toUpperCase()}»`);
      proofCap.textContent = capText;
      if (objUrl) URL.revokeObjectURL(objUrl);
      objUrl = URL.createObjectURL(new Blob([buildSvg(paths, capText)], { type: 'image/svg+xml' }));
      proofDl.href = objUrl;
      const safe = seed.replace(/[^a-z0-9-_]+/gi, '-').toLowerCase().replace(/^-+|-+$/g, '') || 'arclink';
      proofDl.download = `arclink-proof-${safe}.svg`;
      firstRender = false;
    };

    let debounce = 0;
    proofInput.addEventListener('input', () => {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => render(proofInput.value), 220);
    });
    render(proofInput.value); // 初始化下载链接（不重描）
  }
</script>

