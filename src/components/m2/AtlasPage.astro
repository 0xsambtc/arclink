<!-- 可操作覆盖台（功能而非动效：不依赖 motion 偏好；无 JS 时默认 ALL 全量可见）
     S4 增补：切区域时 mega 读数滚动 + match 弧线 dashoffset 重放（减动效时直接呈现终值） -->
<script is:inline define:vars={{ regionStats, megaSuffix }}>
  const plate = document.getElementById('cov-plate');
  const buttons = Array.from(document.querySelectorAll('.region-btn'));
  if (plate && buttons.length) {
    const mega = document.getElementById('cov-mega-num');
    const megaLabel = document.getElementById('cov-mega-label');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;

    const setMega = (to) => {
      if (!mega) return;
      const from = Number((mega.textContent || '0').replace(/,/g, '')) || 0;
      if (reduced) {
        mega.textContent = to.toLocaleString('en-US');
        return;
      }
      cancelAnimationFrame(raf);
      const t0 = performance.now();
      const dur = 700;
      const step = (now) => {
        const p = Math.min(1, (now - t0) / dur);
        const e = 1 - Math.pow(1 - p, 3);
        mega.textContent = Math.round(from + (to - from) * e).toLocaleString('en-US');
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    const replayArcs = (id) => {
      if (reduced) return;
      plate.querySelectorAll('.cov-arc-g').forEach((g) => {
        const match = id === 'all' || g.dataset.regions.split(' ').includes(id);
        if (!match) return;
        const p = g.querySelector('.cov-arc');
        if (!p) return;
        const len = p.getTotalLength();
        p.style.transition = 'none';
        p.style.strokeDasharray = String(len);
        p.style.strokeDashoffset = String(len);
        void p.getBoundingClientRect();
        p.style.transition = 'stroke-dashoffset 0.9s cubic-bezier(0.22, 0.61, 0.36, 1)';
        p.style.strokeDashoffset = '0';
      });
    };

    const setRegion = (id) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.region === id)));
      plate.querySelectorAll('[data-regions]').forEach((el) => {
        const match = id === 'all' || el.dataset.regions.split(' ').includes(id);
        el.classList.toggle('is-dim', !match);
      });
      const s = regionStats[id];
      document.getElementById('ro-region').textContent = s.label;
      document.getElementById('ro-nodes').textContent = s.nodes;
      document.getElementById('ro-records').textContent = s.records;
      document.getElementById('ro-km').textContent = s.km;
      document.getElementById('ro-last').textContent = s.last;
      if (megaLabel) megaLabel.textContent = `${s.label} — ${megaSuffix}`;
      setMega(s.kmNum);
      replayArcs(id);
    };
    buttons.forEach((b) => b.addEventListener('click', () => setRegion(b.dataset.region)));

    // Proof of life：hover / focus 任一图元 → 侧栏读出真实记录（城市/km/UTC）
    const line = document.getElementById('record-line');
    plate.querySelectorAll('[data-record]').forEach((el) => {
      const show = () => { line.textContent = el.dataset.record; };
      el.addEventListener('mouseenter', show);
      el.addEventListener('focus', show);
    });
  }
</script>

<script>
  // Folio 页码 + 书脊轨（缺陷9）更新：同一个 IntersectionObserver 喂两处（非动效，reduced-motion 下同样工作）
  const folioNum = document.getElementById('folio-num');
  const spineSec = document.getElementById('spine-sec');
  const spineTicks = Array.from(document.querySelectorAll<HTMLElement>('.spine-tick'));
  const folioSecs = document.querySelectorAll<HTMLElement>('[data-folio]');
  if (folioNum && folioSecs.length) {
    const folioObs = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          const el = en.target as HTMLElement;
          const n = el.dataset.folio ?? '00';
          folioNum.textContent = n;
          if (spineSec) spineSec.textContent = `SEC.${n} / ${el.dataset.secname ?? ''}`;
          spineTicks.forEach((tk) => tk.classList.toggle('is-on', tk.dataset.tick === n));
        }),
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    folioSecs.forEach((s) => folioObs.observe(s));
  }
</script>

<script>
  // ============ FIG.02 LIVE FIELD PLATE 控制器（hero v3） ============
  // cobe 球（视觉底）+ 投影 DOM 覆盖 <button> 拾取（评审修正 #3）+ 日志↔球双向联动 + 底缘读出条。
  // 状态机（评审修正 #5）：IDLE(自转) / MARKER_LOCK(拾取冻结) / LOG_TWEEN(甩动) / RESUME_DELAY(800ms)。
  // 移动端（≤760）不初始化球：静态 SVG + 点日志行 → 读出条；reduced-motion：静态帧，交互仅高亮 + 读出。
  import createGlobe from 'cobe';
  import { gsap } from 'gsap';

  const plate = document.querySelector<HTMLElement>('.live-plate');
  const canvas = document.getElementById('hero-globe') as HTMLCanvasElement | null;
  const dataEl = document.getElementById('atlas-data');
  const overlay = plate?.querySelector<HTMLElement>('.globe-overlay') ?? null;
  const nodeBtns = Array.from(plate?.querySelectorAll<HTMLButtonElement>('.node-btn') ?? []);
  const logBtns = Array.from(plate?.querySelectorAll<HTMLButtonElement>('.log-btn') ?? []);
  const roIdx = plate?.querySelector<HTMLElement>('.lp-readout-idx') ?? null;
  const roMain = plate?.querySelector<HTMLElement>('.lp-readout-main') ?? null;
  // 无 JS 默认帧内容存底：reduced-motion（无轮转）下交互结束的回落帧
  const roDefault = { idx: roIdx?.textContent ?? '', text: roMain?.textContent ?? '' };

  // 读出条换帧：120ms 淡入 + 序号格 accent 闪一帧（评审修正 #9：hover 高频触发，禁打字机）
  const writeReadout = (idx: string, text: string) => {
    if (!roIdx || !roMain || (roMain.textContent === text && roIdx.textContent === idx)) return;
    roIdx.textContent = idx;
    roMain.textContent = text;
    for (const el of [roIdx, roMain]) {
      el.classList.remove('is-swap');
      void el.offsetWidth; // 重启 CSS 换帧动画
      el.classList.add('is-swap');
    }
  };
  // GSAP 编排脚本的 4s is-live 轮转经此事件喂读出条默认帧（评审修正 #6）
  document.addEventListener('lp:readout', (e) => {
    const d = (e as CustomEvent<{ idx: string; text: string }>).detail;
    if (!plate?.classList.contains('is-engaged')) writeReadout(d.idx, d.text);
  });

  const mobile = window.matchMedia('(max-width: 760px)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 移动端降级（规格 D）：marker 拾取禁用，点日志行 → 读出条更新（读出条 sticky 于图版底缘）
  if (mobile) {
    logBtns.forEach((b) => {
      b.addEventListener('click', () => writeReadout(b.dataset.idx ?? '', b.dataset.readout ?? ''));
    });
  }

  if (plate && canvas && overlay && dataEl && nodeBtns.length && !mobile) {
    const payload = JSON.parse(dataEl.textContent || '{"cities":[]}') as {
      cities: { lat: number; lng: number; code: string }[];
    };
    const cities = payload.cities;
    const byCode = new Map(cities.map((c, i) => [c.code, i]));

    /* ============ 球面 → 屏幕投影（与 cobe 2.0.1 dist 内部严格同构） ============
       cobe 内部管线（node_modules/cobe/dist/index.esm.js 的 U()/O()/W()，逐式抄录）：
         单位球向量  U(lat,lng) = [cos(lat)·cos(lng), sin(lat), −cos(lat)·sin(lng)]
         marker 实际半径 r = 0.8（球面 clip 半径）+ 0.05（markerElevation 默认）= 0.85
         旋转（phi = 经向自转，theta = 纬向倾角）后的相机系坐标：
           cx = cosφ·x + sinφ·z                        —— 屏幕横轴（clip，右为正）
           cy = sinφ·sinθ·x + cosθ·y − cosφ·sinθ·z     —— 屏幕纵轴（clip，上为正）
           cz = −sinφ·cosθ·x + sinθ·y + cosφ·cosθ·z    —— 视向深度（> 0 朝向观察者）
         方形画布、offset=0 时归一化屏幕坐标：sx = (1 + cx·r·S)/2，sy = (1 − cy·r·S)/2（S = scale）
       校准注记（评审修正 #4，实施前以 node 对 dist 源逐城实算复核）：
         ① 官方 rotate-to 公式 φ_target = π − (lng·π/180 − π/2) = 3π/2 − lng 代入上式：
            12 城 sx 全部 = 0.500000 且 cz > 0 —— 公式与着色器解析一致，直接采用；
         ② 球体轮廓 clip 半径 0.8 → 轮廓像素直径 = 0.8·S·画布宽；S = 1.08 时轮廓约占画布 86%，
            辉光（延伸至 clip ~0.92）恰好不裁边；
         ③ SIN 居中时 SIN–KUL 屏距 10.7px @ 480px 画布 —— 簇规则（< 18px）覆盖 SIN/KUL，JKT(30px) 独立。 */
    const TAU = Math.PI * 2;
    const SPEED = 0.003; // IDLE 角速度 rad/frame（沿旧版）
    const SCALE = 1.08; // cobe scale：格内读数感更足且辉光不裁边（校准注记②）
    const R_MARK = 0.85; // marker 抬升半径（cobe 内部常数）
    const Z_HIDE = 0.12; // 背面阈值：z ≤ 0.12 覆盖点隐藏（评审修正 #3）
    const HIT = 22; // 命中半径 px
    const HYST = 4; // 切换迟滞 px（评审修正 #5）
    const CLUSTER = 18; // 簇判定屏距 px（评审修正 #5）
    const norm = (a: number) => ((a % TAU) + TAU) % TAU;
    const unit = cities.map((c) => {
      const la = (c.lat * Math.PI) / 180;
      const lo = (c.lng * Math.PI) / 180;
      return [Math.cos(la) * Math.cos(lo), Math.sin(la), -Math.cos(la) * Math.sin(lo)];
    });
    const theta = 0.2;
    const rot = { phi: 4.4 }; // gsap tween 载体；常态 mod 2π（评审修正 #4）
    const spin = { v: 0 }; // 当前角速度（恢复自转时 400ms 缓入至 SPEED）
    // 投影缓存：归一化屏幕坐标 + 视向深度
    const sx = new Float64Array(cities.length);
    const sy = new Float64Array(cities.length);
    const zz = new Float64Array(cities.length);
    const projectAll = () => {
      const cp = Math.cos(rot.phi);
      const sp = Math.sin(rot.phi);
      const ct = Math.cos(theta);
      const st = Math.sin(theta);
      for (let i = 0; i < unit.length; i++) {
        const [x, y, z] = unit[i];
        zz[i] = -sp * ct * x + st * y + cp * ct * z;
        sx[i] = (1 + (cp * x + sp * z) * R_MARK * SCALE) / 2;
        sy[i] = (1 - (sp * st * x + ct * y - cp * st * z) * R_MARK * SCALE) / 2;
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((en) => en.isIntersecting)) return;
        io.disconnect();
        plate.classList.add('globe-on');
        const size = canvas.offsetWidth || 520;
        let boxW = overlay.clientWidth || size;
        let boxH = overlay.clientHeight || size;
        window.addEventListener('resize', () => {
          boxW = overlay.clientWidth || boxW;
          boxH = overlay.clientHeight || boxH;
        });
        const t0 = performance.now();
        // 纸面主题：冷纸浅色地球（配色方案 A「NORTH PAPER」）；深色主题不变（QA修复 第4条配色沿用）
        const paper = !!canvas.closest('.theme-paper');
        const scales = cities.map(() => ({ v: 1 })); // 每城 marker 交互缩放（gsap tween 载体）
        // 开机逐城生长沿旧版（age 起点 t0+900+i*260，600ms ease-out），到位后乘交互缩放，不消失
        const buildMarkers = (now: number) =>
          cities
            .map((c, i) => {
              const age = now - (t0 + 900 + i * 260);
              const p = reduced ? 1 : age <= 0 ? 0 : Math.min(1, age / 600);
              return { location: [c.lat, c.lng] as [number, number], size: 0.06 * (1 - Math.pow(1 - p, 3)) * scales[i].v };
            })
            .filter((m) => m.size > 0);
        const globe = createGlobe(canvas, {
          devicePixelRatio: 2,
          width: size * 2,
          height: size * 2,
          phi: rot.phi,
          theta,
          scale: SCALE,
          dark: paper ? 0 : 1,
          diffuse: 1.2,
          mapSamples: 16000,
          mapBrightness: paper ? 1.6 : 6,
          baseColor: paper ? [0.85, 0.87, 0.91] : [0.12, 0.18, 0.3],
          markerColor: paper ? [0.08, 0.49, 0.99] : [0.2, 0.47, 1],
          glowColor: paper ? [0.91, 0.93, 0.96] : [0.08, 0.16, 0.33],
          markers: reduced ? buildMarkers(t0) : [],
        });

        // 覆盖点逐帧落位：transform 平移（合成层，无 layout）；背面隐藏并退出 tab 序
        let overlayReady = false;
        const placeBtns = () => {
          for (let i = 0; i < nodeBtns.length; i++) {
            const b = nodeBtns[i];
            b.style.transform = `translate(${(sx[i] * boxW - 11).toFixed(1)}px, ${(sy[i] * boxH - 11).toFixed(1)}px)`;
            b.classList.toggle('is-back', zz[i] <= Z_HIDE);
          }
          if (!overlayReady) {
            overlayReady = true;
            overlay.classList.add('is-ready');
          }
        };

        // —— 状态机（评审修正 #5）：任何新交互 kill 上一支 tween，抢占关系单点裁决 ——
        type LpState = 'IDLE' | 'MARKER_LOCK' | 'LOG_TWEEN' | 'RESUME_DELAY';
        let state: LpState = 'IDLE';
        let activeMarker = -1; // 拾取锁定的城市 index
        let activeLog: HTMLButtonElement | null = null;
        let focusHeld = false; // 键盘 focus 持有期间指针判定不得抢占释放
        let resumeTimer = 0;
        let dwellTimer = 0;

        const litLines = () => {
          const code = activeMarker >= 0 ? cities[activeMarker].code : '';
          logBtns.forEach((b) => {
            const on = (code !== '' && (b.dataset.from === code || b.dataset.to === code)) || b === activeLog;
            b.closest('.log-line')?.classList.toggle('is-lit', on);
          });
        };
        const killMotion = () => {
          gsap.killTweensOf(rot);
          gsap.killTweensOf(spin);
          spin.v = 0;
          window.clearTimeout(dwellTimer);
          window.clearTimeout(resumeTimer);
        };
        const setScale = (i: number, v: number) => {
          if (reduced) scales[i].v = v;
          else gsap.to(scales[i], { v, duration: 0.28, ease: 'power2.out', overwrite: true });
        };
        // 日志联动的两端 marker 放大脉冲（back.out 过冲即脉冲感），锁定期常驻 1.6×
        const setScalePulse = (i: number) => {
          if (reduced) scales[i].v = 1.6;
          else gsap.to(scales[i], { v: 1.6, duration: 0.4, ease: 'back.out(2.2)', overwrite: true });
        };
        const clearLogScales = () => {
          if (!activeLog) return;
          const iF = byCode.get(activeLog.dataset.from ?? '') ?? -1;
          const iT = byCode.get(activeLog.dataset.to ?? '') ?? -1;
          if (iF >= 0) setScale(iF, 1);
          if (iT >= 0) setScale(iT, 1);
          activeLog = null;
        };
        // 密集群（SIN/KUL/JKT，校准注记③）：正面近邻 < 18px 计数 → 读出条簇显示（评审修正 #5）
        const clusterText = (i: number) => {
          let k = 0;
          for (let j = 0; j < cities.length; j++) {
            if (j === i || zz[j] <= Z_HIDE) continue;
            if (Math.hypot((sx[j] - sx[i]) * boxW, (sy[j] - sy[i]) * boxH) < CLUSTER) k++;
          }
          if (!k) return null;
          return (overlay.dataset.cluster ?? '{code} +{k}').replace('{code}', cities[i].code).replace('{k}', String(k));
        };

        const engageMarker = (i: number) => {
          if (activeMarker === i && state === 'MARKER_LOCK') return;
          killMotion();
          clearLogScales();
          if (activeMarker >= 0 && activeMarker !== i) setScale(activeMarker, 1);
          activeMarker = i;
          state = 'MARKER_LOCK'; // 拾取 → rotation 暂停（phi 冻结）
          plate.classList.add('is-engaged');
          setScale(i, 1.6); // 命中 marker 放大 1.6×（规格 A）
          nodeBtns.forEach((b, j) => b.classList.toggle('is-active', j === i));
          litLines(); // 含该城市的日志行 .is-lit
          writeReadout(cities[i].code, clusterText(i) ?? nodeBtns[i].dataset.readout ?? '');
          if (reduced) render();
        };

        const engageLog = (btn: HTMLButtonElement) => {
          if (activeLog === btn) return;
          killMotion();
          clearLogScales();
          if (activeMarker >= 0) {
            setScale(activeMarker, 1);
            nodeBtns[activeMarker].classList.remove('is-active');
            activeMarker = -1;
          }
          activeLog = btn;
          state = 'LOG_TWEEN';
          plate.classList.add('is-engaged');
          litLines();
          writeReadout(btn.dataset.idx ?? '', btn.dataset.readout ?? '');
          const iF = byCode.get(btn.dataset.from ?? '') ?? -1;
          const iT = byCode.get(btn.dataset.to ?? '') ?? -1;
          if (iF >= 0) setScalePulse(iF);
          if (iT >= 0) setScalePulse(iT);
          if (reduced) {
            render(); // reduced-motion：仅高亮 + 读出，不 tween 旋转（规格 C）
            return;
          }
          // 120ms dwell 后才发甩动 —— 快速扫过 12 行不触发 12 支 tween（评审修正 #5）
          dwellTimer = window.setTimeout(() => {
            if (activeLog !== btn || iF < 0) return;
            // 目标角 = cobe 官方 rotate-to（校准注记①）；phi 常态 mod 2π + 最短弧（评审修正 #4）
            const target = norm(1.5 * Math.PI - (cities[iF].lng * Math.PI) / 180);
            rot.phi = norm(rot.phi);
            const delta = ((((target - rot.phi + Math.PI) % TAU) + TAU) % TAU) - Math.PI;
            gsap.to(rot, { phi: rot.phi + delta, duration: 0.9, ease: 'power2.out', overwrite: true });
          }, 120);
        };

        // 交互移出 → RESUME_DELAY 800ms 后恢复自转（0 → SPEED 400ms 速度缓入，评审修正 #4）
        const release = () => {
          window.clearTimeout(dwellTimer);
          if (activeMarker >= 0) {
            setScale(activeMarker, 1);
            nodeBtns[activeMarker].classList.remove('is-active');
            activeMarker = -1;
          }
          clearLogScales();
          litLines();
          if (reduced) {
            state = 'IDLE';
            plate.classList.remove('is-engaged');
            restoreLive();
            render();
            return;
          }
          state = 'RESUME_DELAY';
          window.clearTimeout(resumeTimer);
          resumeTimer = window.setTimeout(() => {
            state = 'IDLE';
            plate.classList.remove('is-engaged');
            restoreLive();
            gsap.to(spin, { v: SPEED, duration: 0.4, ease: 'power1.in', overwrite: true });
          }, 800);
        };
        // 恢复后读出条立即回到当前 is-live 轮转行（reduced-motion 无轮转时回落最新记录帧）
        const restoreLive = () => {
          const liveBtn = plate.querySelector<HTMLElement>('.log-line.is-live .log-btn');
          if (liveBtn) writeReadout(liveBtn.dataset.idx ?? '', liveBtn.dataset.readout ?? '');
          else writeReadout(roDefault.idx, roDefault.text);
        };

        // —— 指针拾取：最近者胜 + 4px 迟滞；命中判定在 rAF 内逐帧执行 ——
        // （评审 A 缺陷①的修复：球转到静止指针下同样命中 / 转离同样脱离）
        let px = -1;
        let py = -1;
        let pointerIn = false;
        overlay.addEventListener('pointermove', (e) => {
          const r = overlay.getBoundingClientRect(); // 实时框：归档收缩 scale 后比例自动正确（评审 C）
          px = (e.clientX - r.left) / r.width;
          py = (e.clientY - r.top) / r.height;
          pointerIn = true;
          if (reduced) resolvePointer(); // 静态帧下无 rAF，命中判定跟随 pointermove
        });
        overlay.addEventListener('pointerleave', () => {
          pointerIn = false;
          if (!focusHeld && state === 'MARKER_LOCK') release();
        });
        const resolvePointer = () => {
          if (!pointerIn || focusHeld || state === 'LOG_TWEEN') return;
          let best = -1;
          let bestD = Infinity;
          for (let i = 0; i < cities.length; i++) {
            if (zz[i] <= Z_HIDE) continue;
            const d = Math.hypot((sx[i] - px) * boxW, (sy[i] - py) * boxH);
            if (d < bestD) {
              best = i;
              bestD = d;
            }
          }
          // 迟滞：已锁定目标仍在命中区附近且新目标未近出 4px → 保持，防 SIN/KUL 抖动（评审修正 #5）
          if (activeMarker >= 0 && best !== activeMarker && zz[activeMarker] > Z_HIDE) {
            const dCur = Math.hypot((sx[activeMarker] - px) * boxW, (sy[activeMarker] - py) * boxH);
            if (dCur <= HIT + HYST && bestD >= dCur - HYST) return;
          }
          if (bestD <= HIT) {
            if (best !== activeMarker) engageMarker(best);
          } else if (activeMarker >= 0 && state === 'MARKER_LOCK') {
            release();
          }
        };

        // 键盘可达：覆盖点 focus = 拾取，日志行 focus = 联动 —— 与 hover 同一事件路径（评审修正 #3）
        nodeBtns.forEach((b, i) => {
          b.addEventListener('focus', () => {
            focusHeld = true;
            engageMarker(i);
          });
          b.addEventListener('blur', () => {
            focusHeld = false;
            if (state === 'MARKER_LOCK') release();
          });
        });
        logBtns.forEach((b) => {
          const off = () => {
            if (activeLog === b) release();
          };
          b.addEventListener('mouseenter', () => engageLog(b));
          b.addEventListener('mouseleave', off);
          b.addEventListener('focus', () => {
            focusHeld = true;
            engageLog(b);
          });
          b.addEventListener('blur', () => {
            focusHeld = false;
            off();
          });
        });

        const render = () => {
          projectAll();
          globe.update({ phi: rot.phi, markers: buildMarkers(performance.now()) });
          placeBtns();
        };

        if (reduced) {
          // 静态帧：一次投影落位；后续交互仅触发单次 render（高亮 + 读出，无旋转）
          render();
          return;
        }
        const tick = () => {
          if (state === 'IDLE') rot.phi = norm(rot.phi + spin.v);
          render();
          resolvePointer();
          requestAnimationFrame(tick);
        };
        spin.v = SPEED;
        requestAnimationFrame(tick);
      },
      { rootMargin: '160px' }
    );
    io.observe(plate);
  }
</script>

<script>
  // GSAP 编排 — 全部包在 prefers-reduced-motion: no-preference 内；
  // 初始隐藏态一律由 gsap.set 从 JS 设置（无 JS / reduced-motion 时内容直接可见）。
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const cleanups: Array<() => void> = [];

    // SEC.00 开机序列：mono 状态行 type-on（仅一次）
    const status = document.querySelector('.js-status');
    if (status) {
      const full = status.textContent ?? '';
      const st = { n: 0 };
      status.textContent = '';
      gsap.to(st, {
        n: full.length,
        duration: Math.min(2.4, full.length * 0.022),
        ease: 'none',
        delay: 0.05,
        onUpdate: () => {
          status.textContent = full.slice(0, Math.round(st.n));
        },
      });
    }

    // S2 字标图版入场：整块 mask 升起 + 字腔内 12 条真实交付弧描画（无 JS / 减动效时静态全绘）
    const wm = document.querySelector('.wm-svg');
    if (wm) {
      gsap.set(wm, { yPercent: 106 });
      gsap.to(wm, { yPercent: 0, duration: 1.0, ease: 'power3.out', delay: 0.25 });
      const wmArcs = gsap.utils.toArray<SVGPathElement>('.wm-arc');
      if (wmArcs.length) {
        gsap.set(wmArcs, { strokeDasharray: 1, strokeDashoffset: 1 });
        gsap.to(wmArcs, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut', stagger: 0.05, delay: 0.9 });
      }
    }

    // FIG.02 活体图版浮现（入场作用于整只 figure；原位归档的收缩单独作用 .lp-body，两支 tween 不抢同一元素）
    gsap.set('.live-plate', { opacity: 0, scale: 0.98 });
    gsap.to('.live-plate', { opacity: 1, scale: 1, duration: 1.1, ease: 'power2.out', delay: 0.8 });

    // standfirst：deck 与同基线行的 SEC.03 跳转
    gsap.set(['.hero-deck', '.hero-jump'], { opacity: 0, y: 18 });
    gsap.to(['.hero-deck', '.hero-jump'], { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.12, delay: 1.5 });

    // 日志逐行追加 + 每 4s 轮转高亮（唯一不停的元素：ticker 本体是数据）；
    // hero v3（评审修正 #6）：读出条默认跟随轮转行（经 lp:readout 事件喂给图版控制器），
    // 交互期间（.live-plate.is-engaged）轮转暂停，RESUME_DELAY 结束后恢复
    const logTitle = document.querySelector('.lp-log-title');
    const lines = gsap.utils.toArray<HTMLElement>('.log-line');
    const plateEl = document.querySelector<HTMLElement>('.live-plate');
    if (logTitle && lines.length) {
      gsap.set(logTitle, { opacity: 0 });
      gsap.to(logTitle, { opacity: 1, duration: 0.4, delay: 1.3 });
      gsap.set(lines, { opacity: 0, x: 14 });
      gsap.to(lines, { opacity: 1, x: 0, duration: 0.45, ease: 'power2.out', stagger: 0.28, delay: 1.4 });
      let live = 0;
      const feedReadout = () => {
        const btn = lines[live].querySelector<HTMLElement>('.log-btn');
        if (btn) {
          document.dispatchEvent(
            new CustomEvent('lp:readout', { detail: { idx: btn.dataset.idx ?? '', text: btn.dataset.readout ?? '' } })
          );
        }
      };
      lines[0].classList.add('is-live');
      feedReadout();
      const cycle = window.setInterval(() => {
        if (plateEl?.classList.contains('is-engaged')) return; // 交互期间暂停轮转（评审修正 #6）
        lines[live].classList.remove('is-live');
        live = (live + 1) % lines.length;
        lines[live].classList.add('is-live');
        feedReadout();
      }, 4000);
      cleanups.push(() => window.clearInterval(cycle));
    }

    // 通用排版入场
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.set(el, { opacity: 0, y: 24 });
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 86%' },
      });
    });

    // 规格表 countUp
    document.querySelectorAll<HTMLElement>('.spec-num').forEach((el) => {
      const end = Number(el.dataset.count || '0');
      const st = { v: 0 };
      el.textContent = '0';
      gsap.to(st, {
        v: end,
        duration: 1.4,
        ease: 'power2.out',
        onUpdate: () => {
          el.textContent = Math.round(st.v).toLocaleString('en-US');
        },
        scrollTrigger: { trigger: el, start: 'top 85%' },
      });
    });

    // FIG.03 km 刻度条
    const ticks = gsap.utils.toArray<HTMLElement>('.tick');
    if (ticks.length) {
      gsap.set(ticks, { scaleY: 0, transformOrigin: '50% 100%' });
      gsap.to(ticks, {
        scaleY: 1,
        duration: 0.6,
        ease: 'power2.out',
        stagger: 0.04,
        scrollTrigger: { trigger: '.fig-ticks', start: 'top 82%' },
      });
    }

    // 描画：工程图版弧线 + 覆盖台弧线（stroke-dashoffset）
    gsap.utils.toArray<SVGPathElement>('.method-arc, .cov-arc').forEach((p) => {
      const len = p.getTotalLength();
      gsap.set(p, { strokeDasharray: len, strokeDashoffset: len });
      gsap.to(p, {
        strokeDashoffset: 0,
        duration: 1.2,
        ease: 'power2.inOut',
        scrollTrigger: { trigger: p.closest('.fig'), start: 'top 78%' },
      });
    });

    // 覆盖台节点点亮（内层 g，不占用外层 is-dim 的 opacity）
    const dotInners = gsap.utils.toArray<SVGGElement>('.cov-dot-inner');
    if (dotInners.length) {
      gsap.set(dotInners, { opacity: 0, scale: 0.5, transformOrigin: '50% 50%' });
      gsap.to(dotInners, {
        opacity: 1,
        scale: 1,
        duration: 0.5,
        ease: 'power2.out',
        stagger: 0.05,
        scrollTrigger: { trigger: '#cov-plate', start: 'top 80%' },
      });
    }

    // 动效动词分化（critique-creativity：删通用 fade-up，各内容类型专属动词）——
    // 表格行 = hairline 从 0 到 100% 划出（spec-row / idx-row 的 .row-rule，transform 纪律内）
    gsap.utils.toArray<HTMLElement>('.row-rule').forEach((el) => {
      gsap.set(el, { scaleX: 0, transformOrigin: '0 50%' });
      gsap.to(el, {
        scaleX: 1,
        duration: 0.6,
        ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    });

    // 刊末宣言：display-m 逐行升起（mask 结构与 hero 字标同语言；无 JS 时直接可见）
    const maniTexts = gsap.utils.toArray<HTMLElement>('.manifesto-text');
    if (maniTexts.length) {
      gsap.set(maniTexts, { yPercent: 112 });
      gsap.to(maniTexts, {
        yPercent: 0,
        duration: 0.9,
        ease: 'power3.out',
        stagger: 0.16,
        scrollTrigger: { trigger: '.manifesto-lines', start: 'top 80%' },
      });
    }

    return () => cleanups.forEach((fn) => fn());
  });

  // S3「原位归档」hero v3：滚动离开 hero 时图版主体两栏（.lp-body）收缩至 0.92 +
  // ARCHIVED 图章在读出条右端盖下（保留原 1.3→1 / -6°→-4° 图章动效）。
  // 评审修正 #7：收缩仅作用 .lp-body —— 图注头 / 读出条 / 外框不缩，骑线对齐在滚动中不破裂；
  // 全程 transform/opacity；无 JS / 减动效时图章直接呈现 CSS 终态、图版不缩
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 761px)', () => {
    const bodyEl = document.querySelector<HTMLElement>('.lp-body');
    const stampEl = document.querySelector<HTMLElement>('.archive-stamp');
    if (!bodyEl || !stampEl) return;

    gsap.set(stampEl, { opacity: 0, scale: 1.3, rotate: -6, transformOrigin: '80% 50%' });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '.sec-hero',
        start: 'top top',
        end: 'bottom 70%',
        scrub: true,
        invalidateOnRefresh: true,
      },
    });
    tl.to(bodyEl, { scale: 0.92, transformOrigin: '50% 50%', ease: 'none', duration: 1 }, 0)
      .to(stampEl, { opacity: 1, scale: 1, rotate: -4, ease: 'power2.out', duration: 0.2 }, 0.72);
  });
</script>

