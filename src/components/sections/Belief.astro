---
// Belief — "Our Belief" 白底信念区：左标题 / 中缝竖线 / 右三段正文（v0.2 结构，无折叠）
import { belief } from '../../data/home';
---

<section class="belief" id={belief.id} data-section={belief.id}>
  <div class="shell belief-grid">
    <div class="reveal">
      <p class="eyebrow">{belief.eyebrow}</p>
      <h2>{belief.heading}</h2>
    </div>
    <div class="belief-rule reveal" aria-hidden="true"></div>
    <div class="belief-copy reveal reveal-delay">
      {belief.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .belief {
    position: relative;
    overflow: hidden;
    padding: var(--space-9) 0 var(--space-8);
    color: var(--color-text-on-light);
    background: var(--color-surface);
  }

  /* 右下角装饰同心圆 — surface-tint 系叠圈，白底上仅作微弱纹理 */
  .belief::after {
    content: '';
    position: absolute;
    right: -140px;
    bottom: -230px;
    width: 490px;
    height: 490px;
    border: 1px solid var(--color-border-on-light);
    border-radius: 50%;
    box-shadow:
      0 0 0 35px var(--color-surface-tint),
      0 0 0 36px var(--color-border-on-light),
      0 0 0 70px var(--color-surface-tint),
      0 0 0 71px var(--color-border-on-light);
    pointer-events: none;
  }

  .belief-grid {
    display: grid;
    grid-template-columns: 1fr 1px 1.1fr;
    gap: 70px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  h2 {
    font-size: clamp(42px, 4vw, 54px);
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  /* 中缝竖线 */
  .belief-rule {
    height: 110px;
    background: var(--color-border-on-light);
  }

  .belief-copy p {
    font-size: 18px;
    line-height: 1.8;
    color: var(--color-text-muted-on-light);
    margin: 0;
  }

  .belief-copy p + p {
    margin-top: var(--space-5);
  }

  @media (max-width: 1120px) {
    .belief-grid {
      gap: var(--space-7);
    }
  }

  @media (max-width: 760px) {
    .belief {
      padding: var(--space-8) 0 var(--space-7);
    }
    .belief-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .belief-rule {
      display: none;
    }
    h2 {
      font-size: 38px;
    }
    .belief-copy p {
      font-size: 17px;
    }
  }
</style>
