---
// Hero — 深色首屏：左文案入场编排 + 右平面点阵世界地图与高拱辉光弧线（视觉基准：产品效果图）
// 地图为 Canvas 2D（点阵大陆缓存离屏 + 每帧弧网/节点/光点），数据内联即时初始化；无 JS 回落静态 SVG
import Button from '../ui/Button.astro';
import { hero } from '../../data/home';
---

<section class="hero" id="home" data-section="home" data-on-dark>
  <div class="hero-stars" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow intro-step" style="--d:0s">{hero.eyebrow}</p>
      <h1>
        {/* span 间显式空格：hline 为 display:block 不影响视觉，但保证 textContent/复制不粘连 */}
        <span class="hline intro-step" style="--d:0.08s">{hero.headline.pre}</span>{' '}
        <span class="hline hline-accent intro-step" style="--d:0.16s">{hero.headline.accent}</span>{' '}
        <span class="hline intro-step" style="--d:0.24s">{hero.headline.post}</span>
      </h1>
      <p class="hero-description intro-step" style="--d:0.34s">{hero.description}</p>
      <div class="hero-actions intro-step" style="--d:0.44s">
        <Button variant="primary" size="large" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label} <span aria-hidden="true">→</span></Button>
        <Button variant="outline" size="large" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</Button>
      </div>
    </div>
    <div class="network-graphic" role="img" aria-label="Global execution network across cities worldwide">
      {/* 效果图原图为底（public/brand/hero-globe.webp 裁自产品效果图；PM 供原始素材后可一键换高清）；
          叠加 canvas 只做星芒呼吸/脉冲——原图即无 JS 兜底 */}
      <img class="hero-art" src="/brand/hero-globe.webp" width="1003" height="763" alt="" decoding="async" />
      <canvas id="heroFx" class="fx-canvas" aria-hidden="true"></canvas>
    </div>
  </div>
  <!-- 底缘过渡线：中心凹陷（SVG 承担线），光点为 HTML 分层辉光（不受横向拉伸影响，永远正圆） -->
  <div class="hero-transition" aria-hidden="true">
    <svg class="ht-svg" viewBox="0 0 1440 100" preserveAspectRatio="none">
      <defs>
        <linearGradient id="htLine" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="var(--color-accent-bright)" stop-opacity="0"></stop>
          <stop offset="0.35" stop-color="var(--color-accent-bright)" stop-opacity="0.75"></stop>
          <stop offset="0.5" stop-color="var(--color-accent-bright)"></stop>
          <stop offset="0.65" stop-color="var(--color-accent-bright)" stop-opacity="0.75"></stop>
          <stop offset="1" stop-color="var(--color-accent-bright)" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="ht-line" d="M0 49 H548 C610 49 618 29 656 29 C684 29 702 47 720 51 C738 47 756 29 784 29 C822 29 830 49 892 49 H1440" vector-effect="non-scaling-stroke"></path>
    </svg>
    <span class="ht-orb"></span>
    <span class="ht-tail"></span>
    <span class="ht-tip"></span>
  </div>
</section>

<style>
  .hero {
    min-height: 790px;
    position: relative;
    overflow: hidden;
    padding-top: var(--header-h);
    color: var(--color-text-on-dark);
    background:
      radial-gradient(ellipse 620px 460px at 74% 42%, rgba(var(--color-accent-rgb), 0.16), transparent 70%),
      radial-gradient(circle at 75% 40%, var(--color-glow) 0, var(--color-bg) 45%, var(--color-bg-deep) 100%);
  }

  .hero-stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, rgba(var(--color-accent-bright-rgb), 0.7) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgba(var(--color-accent-bright-rgb), 0.45) 0 1px, transparent 1.5px);
    background-size: 137px 149px, 89px 101px;
    background-position: 0 0, 43px 67px;
    opacity: 0.12;
  }

  .hero-grid {
    min-height: 660px;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: var(--space-6);
    position: relative;
    z-index: 2;
  }

  .hero-copy {
    padding: var(--space-7) 0;
  }

  /* 三行标题（效果图版式）：中行 accent 一行放下 */
  h1 {
    font-size: clamp(44px, 3.75vw, 54px);
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-6);
  }

  .hline {
    display: block;
  }

  .hline-accent {
    color: var(--color-accent-bright);
  }

  .hero-description {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-text-muted-on-dark);
    max-width: 610px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  /* —— 首屏入场编排：逐元素 fadeUp（--d 为各自延迟），reduced-motion 直出 —— */
  @media (prefers-reduced-motion: no-preference) {
    .intro-step {
      opacity: 0;
      transform: translateY(26px);
      animation: hero-in var(--duration-ambient) var(--ease-out) var(--d, 0s) forwards;
    }
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* —— 地图区：canvas 铺满容器；未就绪前显示静态 SVG —— */
  .network-graphic {
    position: relative;
    height: 620px;
  }

  .hero-art {
    width: 100%;
    height: auto;
    display: block;
  }

  .fx-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }


  /* —— 底缘过渡线 —— */
  .hero-transition {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .ht-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ht-line {
    fill: none;
    stroke: url(#htLine);
    stroke-width: 1.5;
  }

  /* 中心亮珠：实心白核 + 蓝辉光（效果图：两肩俯冲汇聚处） */
  .ht-orb {
    position: absolute;
    left: 50%;
    bottom: 44px;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 6px rgba(255, 255, 255, 0.95),
      0 0 14px var(--color-accent-bright),
      0 0 30px rgba(var(--color-accent-bright-rgb), 0.5);
    animation: orb-breathe 3.6s ease-in-out infinite;
  }

  /* 亮珠下的垂线（铅垂结构）：向下渐弱 */
  .ht-tail {
    position: absolute;
    left: 50%;
    bottom: 19px;
    width: 1.5px;
    height: 26px;
    margin-left: -0.75px;
    background: linear-gradient(180deg, rgba(190, 216, 255, 0.9), rgba(var(--color-accent-bright-rgb), 0.3));
  }

  /* 垂线末端小尾点 */
  .ht-tip {
    position: absolute;
    left: 50%;
    bottom: 15px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: #fff;
    opacity: 0.9;
    box-shadow: 0 0 6px var(--color-accent-bright);
  }

  @keyframes orb-breathe {
    0%,
    100% {
      box-shadow:
        0 0 5px rgba(255, 255, 255, 0.9),
        0 0 12px var(--color-accent-bright),
        0 0 26px rgba(var(--color-accent-bright-rgb), 0.4);
    }
    50% {
      box-shadow:
        0 0 7px rgba(255, 255, 255, 1),
        0 0 18px var(--color-accent-bright),
        0 0 38px rgba(var(--color-accent-bright-rgb), 0.6);
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -98; /* 7+7 周期的整数倍，循环无相位跳变 */
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }

  @media (max-width: 1120px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .network-graphic {
      height: 460px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
    }
    .hero-grid {
      min-height: auto;
      padding: var(--space-8) 0 var(--space-6);
    }
    h1 {
      font-size: 45px;
    }
    .hero-description {
      font-size: 16px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .network-graphic {
      height: 340px;
    }
  }
</style>

<script>
  // hero 视觉 = 产品效果图原图（裁取羽化后直出），叠加层仅做"活"的部分：
  // 星芒呼吸光晕 + 脉冲扩散环，对位构建期从原图检测的 17 个节点坐标（归一化）。
  // reduced-motion 或叠加层任何失败 → 静态原图本身即完整视觉，零风险。
  const wrap = document.querySelector<HTMLElement>('.network-graphic');
  const canvas = document.getElementById('heroFx') as HTMLCanvasElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // [x, y, tier]；tier 0 = 主节点（更大光晕）。由 scripts 侧亮度峰值聚类产出，按簇大小排序
  const NODES: [number, number, number][] = [
    [0.3683, 0.4691, 0], [0.1452, 0.663, 0], [0.6013, 0.267, 0], [0.7435, 0.3757, 0],
    [0.0486, 0.3723, 1], [0.9155, 0.5855, 0], [0.6314, 0.5749, 1], [0.5155, 0.7042, 1],
    [0.4408, 0.3698, 1], [0.542, 0.1363, 1], [0.1704, 0.8214, 1], [0.7624, 0.9078, 1],
    [0.4669, 0.8737, 1], [0.0641, 0.6897, 1], [0.8152, 0.2731, 1], [0.2757, 0.1585, 1],
    [0.9448, 0.886, 1],
  ];

  function init() {
    if (!wrap || !canvas || reduced) return; // reduced：静态原图
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const art = wrap.querySelector<HTMLImageElement>('.hero-art')!;
    let W = 0;
    let H = 0;
    let bx = 0;
    let by = 0;
    let bw = 0;
    let bh = 0;
    const sync = () => {
      W = wrap.offsetWidth;
      H = wrap.offsetHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // 节点坐标对齐图片实际盒（容器高度可能大于图片）
      const wr = wrap.getBoundingClientRect();
      const ir = art.getBoundingClientRect();
      bx = ir.left - wr.left;
      by = ir.top - wr.top;
      bw = ir.width;
      bh = ir.height;
    };
    sync();

    // 呼吸光晕 sprite（径向渐变 + 正交细光线，与原图星芒同构，叠加时只做亮度呼吸）
    const makeSprite = (size: number) => {
      const c = document.createElement('canvas');
      c.width = size * dpr;
      c.height = size * dpr;
      const g = c.getContext('2d')!;
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      const m = size / 2;
      const halo = g.createRadialGradient(m, m, 0, m, m, m);
      halo.addColorStop(0, 'rgba(220, 238, 255, 0.55)');
      halo.addColorStop(0.3, 'rgba(120, 175, 255, 0.2)');
      halo.addColorStop(1, 'rgba(60, 120, 255, 0)');
      g.fillStyle = halo;
      g.fillRect(0, 0, size, size);
      return c;
    };
    const spriteBig = makeSprite(88);
    const spriteSmall = makeSprite(48);

    const t0 = performance.now();
    const draw = (now: number) => {
      if (ctx.getTransform().a !== dpr) sync();
      const t = now - t0;
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      for (let i = 0; i < NODES.length; i++) {
        const [nx, ny, tier] = NODES[i];
        const x = bx + nx * bw;
        const y = by + ny * bh;
        const phase = i * 1.37;
        const breathe = 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(t / 1300 + phase));
        const sprite = tier === 0 ? spriteBig : spriteSmall;
        const size = (tier === 0 ? 88 : 48) * (0.75 + 0.25 * breathe) * (bw / 700);
        ctx.globalAlpha = 0.35 + 0.5 * breathe;
        ctx.drawImage(sprite, x - size / 2, y - size / 2, size, size);
        // 脉冲扩散环（错峰）
        const p = (t / 2600 + i * 0.21) % 1;
        ctx.globalAlpha = 1;
        ctx.strokeStyle = `rgba(130, 180, 255, ${((1 - p) * (tier === 0 ? 0.4 : 0.26)).toFixed(3)})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(x, y, (4 + p * (tier === 0 ? 26 : 15)) * (bw / 700), 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    };

    let raf = 0;
    const loop = () => {
      draw(performance.now());
      raf = requestAnimationFrame(loop);
    };
    let resizeTimer = 0;
    new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(sync, 150);
    }).observe(wrap);
    raf = requestAnimationFrame(loop);
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        if (!raf) raf = requestAnimationFrame(loop);
      } else {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }).observe(wrap);
  }

  init();
</script>
