---
// Hero — 深色首屏：左文案入场编排 + 右平面点阵世界地图与高拱辉光弧线（视觉基准：产品效果图）
// 地图为 Canvas 2D（点阵大陆缓存离屏 + 每帧弧线/节点/光点），load 后懒初始化保 LCP；无 JS 回落静态 SVG
import Button from '../ui/Button.astro';
import { hero } from '../../data/home';
---

<section class="hero" id="home" data-section="home" data-on-dark>
  <div class="hero-stars" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow intro-step" style="--d:0s">{hero.eyebrow}</p>
      <h1>
        {/* span 间显式空格：hline 为 display:block 不影响视觉，但保证 textContent/复制不粘连 */}
        <span class="hline intro-step" style="--d:0.08s">{hero.headline.pre}</span>{' '}
        <span class="hline hline-accent intro-step" style="--d:0.16s">{hero.headline.accent}</span>{' '}
        <span class="hline intro-step" style="--d:0.24s">{hero.headline.post}</span>
      </h1>
      <p class="hero-description intro-step" style="--d:0.34s">{hero.description}</p>
      <div class="hero-actions intro-step" style="--d:0.44s">
        <Button variant="primary" size="large" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label} <span aria-hidden="true">→</span></Button>
        <Button variant="outline" size="large" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</Button>
      </div>
    </div>
    <div class="network-graphic" role="img" aria-label="Global execution network across cities worldwide">
      <canvas id="heroMap" class="map-canvas"></canvas>
      <svg class="network-svg network-fallback" viewBox="0 0 720 500" aria-hidden="true">
        <g class="map-dots" opacity=".58">
          <circle cx="115" cy="170" r="2"></circle><circle cx="135" cy="155" r="2"></circle><circle cx="150" cy="190" r="2"></circle><circle cx="175" cy="145" r="2"></circle><circle cx="195" cy="200" r="2"></circle><circle cx="210" cy="170" r="2"></circle><circle cx="250" cy="190" r="2"></circle><circle cx="295" cy="160" r="2"></circle><circle cx="315" cy="205" r="2"></circle><circle cx="335" cy="185" r="2"></circle><circle cx="360" cy="215" r="2"></circle><circle cx="390" cy="172" r="2"></circle><circle cx="420" cy="190" r="2"></circle><circle cx="450" cy="205" r="2"></circle><circle cx="475" cy="180" r="2"></circle><circle cx="500" cy="215" r="2"></circle><circle cx="530" cy="195" r="2"></circle><circle cx="560" cy="225" r="2"></circle><circle cx="585" cy="210" r="2"></circle><circle cx="610" cy="245" r="2"></circle><circle cx="180" cy="255" r="2"></circle><circle cx="220" cy="275" r="2"></circle><circle cx="265" cy="260" r="2"></circle><circle cx="310" cy="300" r="2"></circle><circle cx="355" cy="280" r="2"></circle><circle cx="400" cy="310" r="2"></circle><circle cx="450" cy="285" r="2"></circle><circle cx="510" cy="315" r="2"></circle><circle cx="565" cy="300" r="2"></circle>
        </g>
        <g class="network-lines">
          <path d="M110 300 Q220 90 350 250"></path><path d="M110 300 Q300 120 545 180"></path><path d="M175 155 Q340 55 495 225"></path><path d="M230 345 Q350 180 465 320"></path><path d="M350 250 Q480 80 610 275"></path><path d="M350 250 Q470 205 545 180"></path><path d="M465 320 Q560 170 655 330"></path><path d="M230 345 Q410 410 610 275"></path><path d="M495 225 Q600 165 670 250"></path>
        </g>
        <g class="network-points">
          <circle cx="110" cy="300" r="6"></circle><circle cx="175" cy="155" r="5"></circle><circle cx="230" cy="345" r="6"></circle><circle cx="350" cy="250" r="7"></circle><circle cx="465" cy="320" r="6"></circle><circle cx="495" cy="225" r="6"></circle><circle cx="545" cy="180" r="6"></circle><circle cx="610" cy="275" r="6"></circle><circle cx="655" cy="330" r="5"></circle><circle cx="670" cy="250" r="5"></circle>
        </g>
      </svg>
    </div>
  </div>
  <!-- 底缘过渡线：中心凹陷（SVG 承担线），光点为 HTML 分层辉光（不受横向拉伸影响，永远正圆） -->
  <div class="hero-transition" aria-hidden="true">
    <svg class="ht-svg" viewBox="0 0 1440 100" preserveAspectRatio="none">
      <defs>
        <linearGradient id="htLine" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="var(--color-accent-bright)" stop-opacity="0"></stop>
          <stop offset="0.35" stop-color="var(--color-accent-bright)" stop-opacity="0.75"></stop>
          <stop offset="0.5" stop-color="var(--color-accent-bright)"></stop>
          <stop offset="0.65" stop-color="var(--color-accent-bright)" stop-opacity="0.75"></stop>
          <stop offset="1" stop-color="var(--color-accent-bright)" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="ht-line" d="M0 50 H636 C678 50 694 71 720 71 C746 71 762 50 804 50 H1440" vector-effect="non-scaling-stroke"></path>
    </svg>
    <span class="ht-dot"></span>
  </div>
</section>

<style>
  .hero {
    min-height: 790px;
    position: relative;
    overflow: hidden;
    padding-top: var(--header-h);
    color: var(--color-text-on-dark);
    background:
      radial-gradient(ellipse 620px 460px at 74% 42%, rgba(var(--color-accent-rgb), 0.16), transparent 70%),
      radial-gradient(circle at 75% 40%, var(--color-glow) 0, var(--color-bg) 45%, var(--color-bg-deep) 100%);
  }

  .hero-stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, rgba(var(--color-accent-bright-rgb), 0.7) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgba(var(--color-accent-bright-rgb), 0.45) 0 1px, transparent 1.5px);
    background-size: 137px 149px, 89px 101px;
    background-position: 0 0, 43px 67px;
    opacity: 0.12;
  }

  .hero-grid {
    min-height: 660px;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: var(--space-6);
    position: relative;
    z-index: 2;
  }

  .hero-copy {
    padding: var(--space-7) 0;
  }

  /* 三行标题（效果图版式）：中行 accent 一行放下 */
  h1 {
    font-size: clamp(44px, 3.75vw, 54px);
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-6);
  }

  .hline {
    display: block;
  }

  .hline-accent {
    color: var(--color-accent-bright);
  }

  .hero-description {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-text-muted-on-dark);
    max-width: 610px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  /* —— 首屏入场编排：逐元素 fadeUp（--d 为各自延迟），reduced-motion 直出 —— */
  @media (prefers-reduced-motion: no-preference) {
    .intro-step {
      opacity: 0;
      transform: translateY(26px);
      animation: hero-in var(--duration-ambient) var(--ease-out) var(--d, 0s) forwards;
    }
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* —— 地图区：canvas 铺满容器；未就绪前显示静态 SVG —— */
  .network-graphic {
    position: relative;
    height: 620px;
  }

  .map-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
    pointer-events: none;
  }

  .map-canvas.is-ready {
    opacity: 1;
  }

  .network-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity var(--duration-ambient) var(--ease-out);
  }

  .network-graphic.has-map .network-fallback {
    opacity: 0;
  }

  .map-dots circle {
    fill: var(--color-accent);
  }

  .network-lines path {
    fill: none;
    stroke: var(--color-accent-bright);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 7 7;
    animation: dash 10s linear infinite;
    filter: drop-shadow(0 0 3px var(--color-accent-deep));
  }

  .network-points circle {
    fill: var(--color-text-on-dark);
    stroke: var(--color-accent-bright);
    stroke-width: 4;
    filter: drop-shadow(0 0 9px var(--color-accent-bright));
    animation: pulse 2.6s ease-in-out infinite;
  }

  /* 节点错相位闪烁（避免机械齐闪） */
  .network-points circle:nth-child(2n) {
    animation-delay: 0.9s;
  }

  .network-points circle:nth-child(3n) {
    animation-delay: 1.7s;
  }

  /* —— 底缘过渡线 —— */
  .hero-transition {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .ht-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ht-line {
    fill: none;
    stroke: url(#htLine);
    stroke-width: 1.5;
  }

  /* 悬在凹口尖端的光点：白亮核 → 冷白内晕 → 蓝辉光大软晕（效果图的"坠饰"形态） */
  .ht-dot {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 56px;
    height: 56px;
    margin-left: -28px;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.95) 0 2.5px,
      rgba(190, 216, 255, 0.8) 5px,
      rgba(var(--color-accent-bright-rgb), 0.45) 10px,
      rgba(var(--color-accent-bright-rgb), 0.12) 21px,
      transparent 28px
    );
    animation: dot-breathe 3.6s ease-in-out infinite;
  }

  /* 纵向光芒（主）与横向光芒（弱）：镜头光斑语言，与地图枢纽同源 */
  .ht-dot::before,
  .ht-dot::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .ht-dot::before {
    width: 2px;
    height: 48px;
    background: linear-gradient(180deg, transparent, rgba(190, 216, 255, 0.8), transparent);
  }

  .ht-dot::after {
    width: 34px;
    height: 1.5px;
    background: linear-gradient(90deg, transparent, rgba(190, 216, 255, 0.55), transparent);
  }

  @keyframes dot-breathe {
    0%,
    100% {
      opacity: 0.75;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -98; /* 7+7 周期的整数倍，循环无相位跳变 */
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }

  @media (max-width: 1120px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .network-graphic {
      height: 460px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
    }
    .hero-grid {
      min-height: auto;
      padding: var(--space-8) 0 var(--space-6);
    }
    h1 {
      font-size: 45px;
    }
    .hero-description {
      font-size: 16px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .network-graphic {
      height: 340px;
    }
  }
</style>

<script>
  // 平面点阵世界地图 + 高拱辉光弧线（Canvas 2D）：
  // 点阵大陆一次性绘入离屏缓存（含边缘渐隐遮罩），每帧仅画弧线/流光/节点，开销极小。
  // 城市/弧线为网络覆盖示意（SEA 密集 + 全球枢纽），无数据声明，纯视觉层。
  import { MAP_GRID } from '../../data/world-dots';

  const wrap = document.querySelector<HTMLElement>('.network-graphic');
  const canvas = document.getElementById('heroMap') as HTMLCanvasElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  type City = { lat: number; lng: number; hub?: boolean };
  const CITIES: City[] = [
    { lat: 1.35, lng: 103.82, hub: true }, // Singapore（枢纽）
    { lat: 3.14, lng: 101.69 }, // Kuala Lumpur
    { lat: -6.2, lng: 106.85 }, // Jakarta
    { lat: 13.76, lng: 100.5 }, // Bangkok
    { lat: 14.6, lng: 120.98 }, // Manila
    { lat: 10.82, lng: 106.63 }, // Ho Chi Minh City
    { lat: 23.13, lng: 113.26 }, // Guangzhou
    { lat: 35.68, lng: 139.69, hub: true }, // Tokyo
    { lat: 37.57, lng: 126.98 }, // Seoul
    { lat: -33.87, lng: 151.21 }, // Sydney
    { lat: 19.08, lng: 72.88 }, // Mumbai
    { lat: 25.2, lng: 55.27, hub: true }, // Dubai
    { lat: 51.51, lng: -0.13, hub: true }, // London
    { lat: 52.52, lng: 13.4 }, // Berlin
    { lat: 37.77, lng: -122.42 }, // San Francisco
    { lat: 40.71, lng: -74.01, hub: true }, // New York
    { lat: -23.55, lng: -46.63 }, // São Paulo
    { lat: -1.29, lng: 36.82 }, // Nairobi
  ];
  // SEA 邻接靠节点表达，不拉短弧（密度失控=噪点）
  const ARC_PAIRS: [number, number][] = [
    [0, 3], [0, 4], [0, 7], [0, 9], [0, 10], [0, 11], [0, 14],
    [1, 5], [7, 14], [11, 12], [12, 15], [15, 16], [10, 17], [7, 9],
  ];

  function init() {
    if (!wrap || !canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let W = wrap.offsetWidth;
    let H = wrap.offsetHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.scale(dpr, dpr);

    // —— 投影：等距圆柱铺满容器宽（右缘微出血），边缘轻微下坠模拟俯视 ——
    let mapW = 0;
    let mapH = 0;
    let x0 = 0;
    let y0 = 0;
    let cx = 0;
    const computeLayout = () => {
      mapW = W * 1.06;
      mapH = mapW * (MAP_GRID.rows / MAP_GRID.cols) * 0.98;
      x0 = -W * 0.02;
      y0 = (H - mapH) * 0.52;
      cx = x0 + mapW / 2;
    };
    computeLayout();
    const sag = (x: number) => Math.pow((x - cx) / (mapW / 2), 2) * 24;
    const project = (lat: number, lng: number) => {
      const x = x0 + ((lng + 180) / 360) * mapW;
      const y = y0 + ((MAP_GRID.latTop - lat) / (MAP_GRID.latTop - MAP_GRID.latBottom)) * mapH + sag(x);
      return [x, y] as [number, number];
    };

    // —— 大陆点阵：绘入离屏缓存（亮度随光心衰减 + 微随机 + 城市簇微亮点），再套渐隐遮罩 ——
    // 大陆是底纹（安静的深蓝），弧线与节点才是主角——亮度层级即视线路径
    const off = document.createElement('canvas');
    const octx = off.getContext('2d')!;
    const glowXY = () => [W * 0.72, H * 0.45] as const;
    const paintOffscreen = () => {
      off.width = W * dpr;
      off.height = H * dpr;
      octx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const [glowX, glowY] = glowXY();
      const stepX = mapW / MAP_GRID.cols;
      const stepY = mapH / MAP_GRID.rows;
      let seed = 7;
      const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
      for (const [row, start, len] of MAP_GRID.runs) {
        for (let c = start; c < start + len; c++) {
          const x = x0 + (c + 0.5) * stepX;
          const y = y0 + (row + 0.5) * stepY + sag(x);
          const d = Math.hypot(x - glowX, y - glowY);
          const lit = Math.max(0, 1 - d / (W * 0.72));
          const alpha = 0.16 + lit * 0.5 + (rand() - 0.5) * 0.1;
          octx.fillStyle = `rgba(96, 146, 255, ${Math.max(0.06, Math.min(0.62, alpha)).toFixed(3)})`;
          octx.beginPath();
          octx.arc(x, y, 1.5, 0, Math.PI * 2);
          octx.fill();
        }
      }
      // 城市簇微亮点：节点周边略亮碎点，暗示密度
      for (const c of CITIES) {
        const [px, py] = project(c.lat, c.lng);
        const n = 6 + Math.floor(rand() * 5);
        for (let k = 0; k < n; k++) {
          const ang = rand() * Math.PI * 2;
          const rad = 6 + rand() * 20;
          octx.fillStyle = `rgba(150, 190, 255, ${(0.5 + rand() * 0.2).toFixed(3)})`;
          octx.beginPath();
          octx.arc(px + Math.cos(ang) * rad, py + Math.sin(ang) * rad, 1.2, 0, Math.PI * 2);
          octx.fill();
        }
      }
      // 渐隐遮罩：径向（光心）× 左缘线性（让位给文案区）
      octx.globalCompositeOperation = 'destination-in';
      const rg = octx.createRadialGradient(glowX, glowY, W * 0.1, glowX, glowY, W * 0.78);
      rg.addColorStop(0, 'rgba(0,0,0,1)');
      rg.addColorStop(0.72, 'rgba(0,0,0,0.85)');
      rg.addColorStop(1, 'rgba(0,0,0,0)');
      octx.fillStyle = rg;
      octx.fillRect(0, 0, W, H);
      const lg = octx.createLinearGradient(0, 0, W * 0.3, 0);
      lg.addColorStop(0, 'rgba(0,0,0,0.25)');
      lg.addColorStop(1, 'rgba(0,0,0,1)');
      octx.fillStyle = lg;
      octx.fillRect(0, 0, W, H);
      octx.globalCompositeOperation = 'source-over';
    };
    paintOffscreen();

    // —— 弧线：预采样为折线（画部分弧 = 入场生长；流光沿折线跑）；弧顶抖动防近平行"喷射" ——
    const N = 48;
    const buildArcs = () =>
      ARC_PAIRS.map(([a, b], i) => {
        const [ax, ay] = project(CITIES[a].lat, CITIES[a].lng);
        const [bx, by] = project(CITIES[b].lat, CITIES[b].lng);
        const mx = (ax + bx) / 2;
        const dist = Math.hypot(bx - ax, by - ay);
        const peak = Math.min(ay, by) - (dist * (0.3 + (i % 5) * 0.03) + 46);
        const pts: [number, number][] = [];
        for (let k = 0; k <= N; k++) {
          const t = k / N;
          const x = (1 - t) * (1 - t) * ax + 2 * (1 - t) * t * mx + t * t * bx;
          const y = (1 - t) * (1 - t) * ay + 2 * (1 - t) * t * peak + t * t * by;
          pts.push([x, y]);
        }
        return { pts, phase: (i * 0.37) % 1, born: 600 + i * 110 };
      });
    const buildNodes = () =>
      CITIES.map((c, i) => {
        const [x, y] = project(c.lat, c.lng);
        return { x, y, hub: Boolean(c.hub), phase: (i * 0.53) % 1, born: 500 + i * 90 };
      });
    let arcs = buildArcs();
    let nodes = buildNodes();

    const strokeArc = (pts: [number, number][], upTo: number, width: number, style: string) => {
      ctx.strokeStyle = style;
      ctx.lineWidth = width;
      ctx.beginPath();
      ctx.moveTo(pts[0][0], pts[0][1]);
      const last = Math.max(1, Math.floor(upTo * N));
      for (let k = 1; k <= last; k++) ctx.lineTo(pts[k][0], pts[k][1]);
      ctx.stroke();
    };

    const t0 = performance.now();
    const draw = (now: number) => {
      // 自愈：2D 上下文被浏览器重置（GPU 重启/休眠唤醒）后 transform 归零、离屏位图清空
      if (ctx.getTransform().a !== dpr) {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        paintOffscreen();
      }
      const t = now - t0;
      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(off, 0, 0, W, H);
      ctx.lineCap = 'round';

      for (const arc of arcs) {
        const grow = reduced ? 1 : Math.min(1, Math.max(0, (t - arc.born) / 900));
        if (grow <= 0) continue;
        const eased = 1 - Math.pow(1 - grow, 3);
        strokeArc(arc.pts, eased, 6.5, 'rgba(52, 120, 255, 0.20)');
        strokeArc(arc.pts, eased, 1.5, 'rgba(185, 212, 255, 0.85)');
        // 流光：沿弧线巡航的亮点 + 短尾
        if (!reduced && eased >= 1) {
          const p = (t / 4200 + arc.phase) % 1;
          const head = Math.floor(p * N);
          for (let tail = 0; tail < 6; tail++) {
            const k = head - tail;
            if (k < 0) break;
            const [x, y] = arc.pts[k];
            ctx.fillStyle = `rgba(220, 235, 255, ${(0.9 * (1 - tail / 6)).toFixed(3)})`;
            ctx.beginPath();
            ctx.arc(x, y, 1.9 - tail * 0.2, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }

      for (const node of nodes) {
        const grow = reduced ? 1 : Math.min(1, Math.max(0, (t - node.born) / 600));
        if (grow <= 0) continue;
        const breathe = reduced ? 1 : 0.82 + 0.18 * Math.sin((t / 1000) * 2.2 + node.phase * Math.PI * 2);
        // SEA 密集带非枢纽减档，让新加坡一枝独秀
        const r = (node.hub ? 10 : 5) * (1 - Math.pow(1 - grow, 3)) * breathe;
        const haloR = r * (node.hub ? 3.2 : 2.6);
        const halo = ctx.createRadialGradient(node.x, node.y, 0, node.x, node.y, haloR);
        halo.addColorStop(0, 'rgba(190, 216, 255, 0.9)');
        halo.addColorStop(0.25, 'rgba(120, 170, 255, 0.5)');
        halo.addColorStop(0.6, 'rgba(52, 120, 255, 0.18)');
        halo.addColorStop(1, 'rgba(52, 120, 255, 0)');
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(node.x, node.y, haloR, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
        ctx.beginPath();
        ctx.arc(node.x, node.y, Math.max(1.4, r * 0.32), 0, Math.PI * 2);
        ctx.fill();
        // 枢纽十字光芒（效果图的镜头光斑语言）
        if (node.hub) {
          const len = r * 3.4;
          const beam = ctx.createLinearGradient(node.x - len, node.y, node.x + len, node.y);
          beam.addColorStop(0, 'rgba(140, 180, 255, 0)');
          beam.addColorStop(0.5, `rgba(190, 216, 255, ${(0.5 * breathe).toFixed(3)})`);
          beam.addColorStop(1, 'rgba(140, 180, 255, 0)');
          ctx.strokeStyle = beam;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(node.x - len, node.y);
          ctx.lineTo(node.x + len, node.y);
          ctx.moveTo(node.x, node.y - len);
          ctx.lineTo(node.x, node.y + len);
          ctx.stroke();
        }
      }
    };

    let raf = 0;
    const loop = () => {
      draw(performance.now());
      raf = requestAnimationFrame(loop);
    };

    // 容器尺寸变化：重建 backing store 与全部几何（否则 CSS 拉伸致模糊）
    let resizeTimer = 0;
    new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (wrap.offsetWidth === W && wrap.offsetHeight === H) return;
        W = wrap.offsetWidth;
        H = wrap.offsetHeight;
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        computeLayout();
        paintOffscreen();
        arcs = buildArcs();
        nodes = buildNodes();
        if (reduced) draw(t0 + 60000);
      }, 200);
    }).observe(wrap);

    canvas.classList.add('is-ready');
    wrap.classList.add('has-map');
    if (reduced) {
      draw(t0 + 60000); // 静态成品帧
    } else {
      raf = requestAnimationFrame(loop);
      // 离屏暂停，回屏恢复（长页滚动不空转）
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          if (!raf) raf = requestAnimationFrame(loop);
        } else {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }).observe(wrap);
    }
  }

  if (document.readyState === 'complete') {
    window.setTimeout(init, 0);
  } else {
    window.addEventListener('load', () => window.setTimeout(init, 0), { once: true });
  }
</script>
