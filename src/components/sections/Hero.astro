---
// Hero — 深色首屏：左文案入场编排 + 右平面点阵世界地图与高拱辉光弧线（视觉基准：产品效果图）
// 地图为 Canvas 2D（点阵大陆缓存离屏 + 每帧弧网/节点/光点），数据内联即时初始化；无 JS 回落静态 SVG
import Button from '../ui/Button.astro';
import { hero } from '../../data/home';
---

<section class="hero" id="home" data-section="home" data-on-dark>
  <div class="hero-stars" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow intro-step" style="--d:0s">{hero.eyebrow}</p>
      <h1>
        {/* span 间显式空格：hline 为 display:block 不影响视觉，但保证 textContent/复制不粘连 */}
        <span class="hline intro-step" style="--d:0.08s">{hero.headline.pre}</span>{' '}
        <span class="hline hline-accent intro-step" style="--d:0.16s">{hero.headline.accent}</span>{' '}
        <span class="hline intro-step" style="--d:0.24s">{hero.headline.post}</span>
      </h1>
      <p class="hero-description intro-step" style="--d:0.34s">{hero.description}</p>
      <div class="hero-actions intro-step" style="--d:0.44s">
        <Button variant="primary" size="large" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label} <span aria-hidden="true">→</span></Button>
        <Button variant="outline" size="large" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</Button>
      </div>
    </div>
    <div class="network-graphic" role="img" aria-label="Global execution network across cities worldwide">
      <canvas id="heroMap" class="map-canvas"></canvas>
      <svg class="network-svg network-fallback" viewBox="0 0 720 500" aria-hidden="true">
        <g class="map-dots" opacity=".58">
          <circle cx="115" cy="170" r="2"></circle><circle cx="135" cy="155" r="2"></circle><circle cx="150" cy="190" r="2"></circle><circle cx="175" cy="145" r="2"></circle><circle cx="195" cy="200" r="2"></circle><circle cx="210" cy="170" r="2"></circle><circle cx="250" cy="190" r="2"></circle><circle cx="295" cy="160" r="2"></circle><circle cx="315" cy="205" r="2"></circle><circle cx="335" cy="185" r="2"></circle><circle cx="360" cy="215" r="2"></circle><circle cx="390" cy="172" r="2"></circle><circle cx="420" cy="190" r="2"></circle><circle cx="450" cy="205" r="2"></circle><circle cx="475" cy="180" r="2"></circle><circle cx="500" cy="215" r="2"></circle><circle cx="530" cy="195" r="2"></circle><circle cx="560" cy="225" r="2"></circle><circle cx="585" cy="210" r="2"></circle><circle cx="610" cy="245" r="2"></circle><circle cx="180" cy="255" r="2"></circle><circle cx="220" cy="275" r="2"></circle><circle cx="265" cy="260" r="2"></circle><circle cx="310" cy="300" r="2"></circle><circle cx="355" cy="280" r="2"></circle><circle cx="400" cy="310" r="2"></circle><circle cx="450" cy="285" r="2"></circle><circle cx="510" cy="315" r="2"></circle><circle cx="565" cy="300" r="2"></circle>
        </g>
        <g class="network-lines">
          <path d="M110 300 Q220 90 350 250"></path><path d="M110 300 Q300 120 545 180"></path><path d="M175 155 Q340 55 495 225"></path><path d="M230 345 Q350 180 465 320"></path><path d="M350 250 Q480 80 610 275"></path><path d="M350 250 Q470 205 545 180"></path><path d="M465 320 Q560 170 655 330"></path><path d="M230 345 Q410 410 610 275"></path><path d="M495 225 Q600 165 670 250"></path>
        </g>
        <g class="network-points">
          <circle cx="110" cy="300" r="6"></circle><circle cx="175" cy="155" r="5"></circle><circle cx="230" cy="345" r="6"></circle><circle cx="350" cy="250" r="7"></circle><circle cx="465" cy="320" r="6"></circle><circle cx="495" cy="225" r="6"></circle><circle cx="545" cy="180" r="6"></circle><circle cx="610" cy="275" r="6"></circle><circle cx="655" cy="330" r="5"></circle><circle cx="670" cy="250" r="5"></circle>
        </g>
      </svg>
    </div>
  </div>
  <!-- 底缘过渡线：中心凹陷（SVG 承担线），光点为 HTML 分层辉光（不受横向拉伸影响，永远正圆） -->
  <div class="hero-transition" aria-hidden="true">
    <svg class="ht-svg" viewBox="0 0 1440 100" preserveAspectRatio="none">
      <defs>
        <linearGradient id="htLine" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="var(--color-accent-bright)" stop-opacity="0"></stop>
          <stop offset="0.35" stop-color="var(--color-accent-bright)" stop-opacity="0.75"></stop>
          <stop offset="0.5" stop-color="var(--color-accent-bright)"></stop>
          <stop offset="0.65" stop-color="var(--color-accent-bright)" stop-opacity="0.75"></stop>
          <stop offset="1" stop-color="var(--color-accent-bright)" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="ht-line" d="M0 49 H548 C610 49 618 29 656 29 C684 29 702 47 720 51 C738 47 756 29 784 29 C822 29 830 49 892 49 H1440" vector-effect="non-scaling-stroke"></path>
    </svg>
    <span class="ht-orb"></span>
    <span class="ht-tail"></span>
    <span class="ht-tip"></span>
  </div>
</section>

<style>
  .hero {
    min-height: 790px;
    position: relative;
    overflow: hidden;
    padding-top: var(--header-h);
    color: var(--color-text-on-dark);
    background:
      radial-gradient(ellipse 620px 460px at 74% 42%, rgba(var(--color-accent-rgb), 0.16), transparent 70%),
      radial-gradient(circle at 75% 40%, var(--color-glow) 0, var(--color-bg) 45%, var(--color-bg-deep) 100%);
  }

  .hero-stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, rgba(var(--color-accent-bright-rgb), 0.7) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgba(var(--color-accent-bright-rgb), 0.45) 0 1px, transparent 1.5px);
    background-size: 137px 149px, 89px 101px;
    background-position: 0 0, 43px 67px;
    opacity: 0.12;
  }

  .hero-grid {
    min-height: 660px;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: var(--space-6);
    position: relative;
    z-index: 2;
  }

  .hero-copy {
    padding: var(--space-7) 0;
  }

  /* 三行标题（效果图版式）：中行 accent 一行放下 */
  h1 {
    font-size: clamp(44px, 3.75vw, 54px);
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-6);
  }

  .hline {
    display: block;
  }

  .hline-accent {
    color: var(--color-accent-bright);
  }

  .hero-description {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-text-muted-on-dark);
    max-width: 610px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  /* —— 首屏入场编排：逐元素 fadeUp（--d 为各自延迟），reduced-motion 直出 —— */
  @media (prefers-reduced-motion: no-preference) {
    .intro-step {
      opacity: 0;
      transform: translateY(26px);
      animation: hero-in var(--duration-ambient) var(--ease-out) var(--d, 0s) forwards;
    }
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* —— 地图区：canvas 铺满容器；未就绪前显示静态 SVG —— */
  .network-graphic {
    position: relative;
    height: 620px;
  }

  .map-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
    pointer-events: none;
  }

  .map-canvas.is-ready {
    opacity: 1;
  }

  .network-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity var(--duration-ambient) var(--ease-out);
  }

  .network-graphic.has-map .network-fallback {
    opacity: 0;
  }

  .map-dots circle {
    fill: var(--color-accent);
  }

  .network-lines path {
    fill: none;
    stroke: var(--color-accent-bright);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 7 7;
    animation: dash 10s linear infinite;
    filter: drop-shadow(0 0 3px var(--color-accent-deep));
  }

  .network-points circle {
    fill: var(--color-text-on-dark);
    stroke: var(--color-accent-bright);
    stroke-width: 4;
    filter: drop-shadow(0 0 9px var(--color-accent-bright));
    animation: pulse 2.6s ease-in-out infinite;
  }

  /* 节点错相位闪烁（避免机械齐闪） */
  .network-points circle:nth-child(2n) {
    animation-delay: 0.9s;
  }

  .network-points circle:nth-child(3n) {
    animation-delay: 1.7s;
  }

  /* —— 底缘过渡线 —— */
  .hero-transition {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .ht-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ht-line {
    fill: none;
    stroke: url(#htLine);
    stroke-width: 1.5;
  }

  /* 中心亮珠：实心白核 + 蓝辉光（效果图：两肩俯冲汇聚处） */
  .ht-orb {
    position: absolute;
    left: 50%;
    bottom: 44px;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 6px rgba(255, 255, 255, 0.95),
      0 0 14px var(--color-accent-bright),
      0 0 30px rgba(var(--color-accent-bright-rgb), 0.5);
    animation: orb-breathe 3.6s ease-in-out infinite;
  }

  /* 亮珠下的垂线（铅垂结构）：向下渐弱 */
  .ht-tail {
    position: absolute;
    left: 50%;
    bottom: 19px;
    width: 1.5px;
    height: 26px;
    margin-left: -0.75px;
    background: linear-gradient(180deg, rgba(190, 216, 255, 0.9), rgba(var(--color-accent-bright-rgb), 0.3));
  }

  /* 垂线末端小尾点 */
  .ht-tip {
    position: absolute;
    left: 50%;
    bottom: 15px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: #fff;
    opacity: 0.9;
    box-shadow: 0 0 6px var(--color-accent-bright);
  }

  @keyframes orb-breathe {
    0%,
    100% {
      box-shadow:
        0 0 5px rgba(255, 255, 255, 0.9),
        0 0 12px var(--color-accent-bright),
        0 0 26px rgba(var(--color-accent-bright-rgb), 0.4);
    }
    50% {
      box-shadow:
        0 0 7px rgba(255, 255, 255, 1),
        0 0 18px var(--color-accent-bright),
        0 0 38px rgba(var(--color-accent-bright-rgb), 0.6);
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -98; /* 7+7 周期的整数倍，循环无相位跳变 */
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }

  @media (max-width: 1120px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .network-graphic {
      height: 460px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
    }
    .hero-grid {
      min-height: auto;
      padding: var(--space-8) 0 var(--space-6);
    }
    h1 {
      font-size: 45px;
    }
    .hero-description {
      font-size: 16px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .network-graphic {
      height: 340px;
    }
  }
</style>

<script>
  // 平面点阵世界地图 + 穹顶辉光弧网（Canvas 2D，对齐产品效果图）：
  // 底图为构建期预计算的地理点阵（dotted-map diagonal 网格），一次性绘入离屏缓存；
  // 每帧仅画弧网/流光/节点（lighter 加色混合，交点自然增亮），多层描边代替 shadowBlur 保 60fps。
  // 城市/弧线为网络覆盖示意（SEA 密集 + 全球枢纽），无数据声明，纯视觉层。
  import { DOT_MAP } from '../../data/world-dots';

  const wrap = document.querySelector<HTMLElement>('.network-graphic');
  const canvas = document.getElementById('heroMap') as HTMLCanvasElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 与 scripts/gen-dotted-map.mjs 的 CITIES 严格同序；hub = 视觉枢纽（更大星芒）
  const CITY_META = [
    { hub: true }, {}, {}, {}, {}, {}, {}, { hub: true }, {},
    {}, {}, { hub: true }, { hub: true }, {}, {}, { hub: true }, {}, {},
  ];
  // 链式弧网：枢纽扇面 + 洲际接力（共享端点成穹顶网罩，非独立散弧）
  const ARC_PAIRS: [number, number][] = [
    [0, 2], [0, 3], [0, 7], [0, 9], [0, 10], [0, 11], [0, 14],
    [3, 6], [6, 7], [7, 8], [7, 14], [2, 9],
    [10, 11], [11, 12], [11, 17], [12, 13], [12, 15], [14, 15], [15, 16], [16, 17],
  ];

  function init() {
    if (!wrap || !canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let W = wrap.offsetWidth;
    let H = wrap.offsetHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.scale(dpr, dpr);

    // —— 布局：点阵铺满容器宽（微出血），边缘轻微下坠模拟俯视 ——
    let mapW = 0;
    let mapH = 0;
    let x0 = 0;
    let y0 = 0;
    let cx = 0;
    const computeLayout = () => {
      mapW = W * 1.06;
      mapH = mapW / DOT_MAP.aspect;
      x0 = -W * 0.02;
      y0 = (H - mapH) * 0.52;
      cx = x0 + mapW / 2;
    };
    computeLayout();
    const sag = (x: number) => Math.pow((x - cx) / (mapW / 2), 2) * 24;
    const at = (nx: number, ny: number) => {
      const x = x0 + nx * mapW;
      return [x, y0 + ny * mapH + sag(x)] as [number, number];
    };
    const cityPt = (i: number) => at(DOT_MAP.cityXY[i][0], DOT_MAP.cityXY[i][1]);

    let seed = 7;
    const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

    // —— 底图点阵：离屏缓存（亮度随光心衰减）+ 渐隐遮罩；~8% 点抽出作闪烁层 ——
    const off = document.createElement('canvas');
    const octx = off.getContext('2d')!;
    const glowXY = () => [W * 0.72, H * 0.42] as const;
    let twinkles: { x: number; y: number; base: number; phase: number }[] = [];
    const paintOffscreen = () => {
      off.width = W * dpr;
      off.height = H * dpr;
      octx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed = 7;
      twinkles = [];
      const [gx, gy] = glowXY();
      const d = DOT_MAP.dots;
      for (let i = 0; i < d.length; i += 2) {
        const [x, y] = at(d[i], d[i + 1]);
        const lit = Math.max(0, 1 - Math.hypot(x - gx, y - gy) / (W * 0.74));
        const alpha = Math.max(0.07, Math.min(0.6, 0.15 + lit * 0.45 + (rand() - 0.5) * 0.08));
        if (!reduced && rand() < 0.08) {
          twinkles.push({ x, y, base: alpha, phase: rand() * Math.PI * 2 });
          continue; // 闪烁点归动画层，不入静态缓存
        }
        octx.fillStyle = `rgba(96, 146, 255, ${alpha.toFixed(3)})`;
        octx.beginPath();
        octx.arc(x, y, 1.3, 0, Math.PI * 2);
        octx.fill();
      }
      // 渐隐遮罩：径向（光心）× 左缘线性（让位文案区）
      octx.globalCompositeOperation = 'destination-in';
      const rg = octx.createRadialGradient(gx, gy, W * 0.1, gx, gy, W * 0.8);
      rg.addColorStop(0, 'rgba(0,0,0,1)');
      rg.addColorStop(0.72, 'rgba(0,0,0,0.85)');
      rg.addColorStop(1, 'rgba(0,0,0,0)');
      octx.fillStyle = rg;
      octx.fillRect(0, 0, W, H);
      const lg = octx.createLinearGradient(0, 0, W * 0.3, 0);
      lg.addColorStop(0, 'rgba(0,0,0,0.25)');
      lg.addColorStop(1, 'rgba(0,0,0,1)');
      octx.fillStyle = lg;
      octx.fillRect(0, 0, W, H);
      octx.globalCompositeOperation = 'source-over';
    };
    paintOffscreen();

    // —— 节点辉光 sprite：预渲染（径向光晕 + 四芒星），每帧仅 drawImage ——
    const makeSprite = (size: number, star: number) => {
      const s = document.createElement('canvas');
      const S = size * dpr;
      s.width = S;
      s.height = S;
      const c = s.getContext('2d')!;
      c.setTransform(dpr, 0, 0, dpr, 0, 0);
      const m = size / 2;
      const halo = c.createRadialGradient(m, m, 0, m, m, m);
      halo.addColorStop(0, 'rgba(235, 245, 255, 0.95)');
      halo.addColorStop(0.12, 'rgba(190, 216, 255, 0.65)');
      halo.addColorStop(0.35, 'rgba(90, 150, 255, 0.22)');
      halo.addColorStop(1, 'rgba(52, 120, 255, 0)');
      c.fillStyle = halo;
      c.fillRect(0, 0, size, size);
      // 四芒星：两条正交渐变细线（效果图的镜头光斑语言）
      const beam = (vert: boolean) => {
        const L = m * star;
        const g = vert
          ? c.createLinearGradient(m, m - L, m, m + L)
          : c.createLinearGradient(m - L, m, m + L, m);
        g.addColorStop(0, 'rgba(190, 216, 255, 0)');
        g.addColorStop(0.5, 'rgba(240, 248, 255, 0.9)');
        g.addColorStop(1, 'rgba(190, 216, 255, 0)');
        c.strokeStyle = g;
        c.lineWidth = 1.2;
        c.beginPath();
        if (vert) {
          c.moveTo(m, m - L);
          c.lineTo(m, m + L);
        } else {
          c.moveTo(m - L, m);
          c.lineTo(m + L, m);
        }
        c.stroke();
      };
      beam(false);
      beam(true);
      return s;
    };
    const spriteHub = makeSprite(82, 0.98);
    const spriteDot = makeSprite(34, 0.8);

    // —— 弧网：预采样折线 + 每弧每层端部淡出渐变（0-1-1-0，交汇处自然亮心） ——
    const N = 64;
    // 多层描边代替 shadowBlur：外晕→内晕→白芯（lighter 混合下交点自动增亮）
    const LAYERS = [
      { w: 7.5, rgb: '37, 99, 235', a: 0.08 },
      { w: 4, rgb: '52, 120, 255', a: 0.14 },
      { w: 2, rgb: '120, 170, 255', a: 0.34 },
      { w: 1.05, rgb: '235, 245, 255', a: 0.85 },
    ];
    const buildArcs = () =>
      ARC_PAIRS.map(([a, b], i) => {
        const [ax, ay] = cityPt(a);
        const [bx, by] = cityPt(b);
        const mx = (ax + bx) / 2;
        const dist = Math.hypot(bx - ax, by - ay);
        // 穹顶包络：弧高随弦长分级（近弧矮、远弧高），共享同一高度函数聚成网罩
        const peak = Math.min(ay, by) - (dist * 0.3 + 58 + (i % 4) * 8);
        const pts: [number, number][] = [];
        for (let k = 0; k <= N; k++) {
          const t = k / N;
          const x = (1 - t) * (1 - t) * ax + 2 * (1 - t) * t * mx + t * t * bx;
          const y = (1 - t) * (1 - t) * ay + 2 * (1 - t) * t * peak + t * t * by;
          pts.push([x, y]);
        }
        const grads = LAYERS.map((L) => {
          const g = ctx.createLinearGradient(ax, ay, bx, by);
          g.addColorStop(0, `rgba(${L.rgb}, 0)`);
          g.addColorStop(0.09, `rgba(${L.rgb}, ${L.a})`);
          g.addColorStop(0.91, `rgba(${L.rgb}, ${L.a})`);
          g.addColorStop(1, `rgba(${L.rgb}, 0)`);
          return g;
        });
        return {
          pts,
          grads,
          born: 500 + i * 90,
          beamDur: 2600 + rand() * 2200,
          beamDelay: rand() * 4000,
        };
      });
    const buildNodes = () =>
      CITY_META.map((c, i) => {
        const [x, y] = cityPt(i);
        return { x, y, hub: Boolean(c.hub), phase: rand(), born: 400 + i * 80 };
      });
    let arcs = buildArcs();
    let nodes = buildNodes();

    const strokeArc = (pts: [number, number][], upTo: number, width: number, style: string | CanvasGradient) => {
      ctx.strokeStyle = style;
      ctx.lineWidth = width;
      ctx.beginPath();
      ctx.moveTo(pts[0][0], pts[0][1]);
      const last = Math.max(1, Math.floor(upTo * N));
      for (let k = 1; k <= last; k++) ctx.lineTo(pts[k][0], pts[k][1]);
      ctx.stroke();
    };

    const t0 = performance.now();
    const draw = (now: number) => {
      // 自愈：2D 上下文被浏览器重置（GPU 重启/休眠唤醒）后 transform 归零、离屏位图清空
      if (ctx.getTransform().a !== dpr) {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        paintOffscreen();
      }
      const t = now - t0;
      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(off, 0, 0, W, H);
      ctx.lineCap = 'round';

      // 底图呼吸：抽样点低频闪烁（Stripe twinkle 手法，仅 ~8% 点参与）
      for (const tw of twinkles) {
        const a = tw.base * (0.55 + 0.45 * Math.sin(t / 1400 + tw.phase));
        ctx.fillStyle = `rgba(120, 165, 255, ${a.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(tw.x, tw.y, 1.3, 0, Math.PI * 2);
        ctx.fill();
      }

      // 弧网 + 节点走加色混合：重叠即增亮，效果图的"交点更亮"免费获得
      ctx.globalCompositeOperation = 'lighter';

      for (const arc of arcs) {
        const grow = reduced ? 1 : Math.min(1, Math.max(0, (t - arc.born) / 1000));
        if (grow <= 0) continue;
        const eased = 1 - Math.pow(1 - grow, 3);
        for (let L = 0; L < LAYERS.length; L++) strokeArc(arc.pts, eased, LAYERS[L].w, arc.grads[L]);
        // 流光：渐变光束窗口（头亮尾淡）错峰巡航，非匀速跑马灯
        if (!reduced && eased >= 1) {
          const cyc = arc.beamDur * 1.9;
          const pos = ((t - arc.beamDelay) % cyc + cyc) % cyc / arc.beamDur;
          if (pos <= 1) {
            const ease = 1 - Math.pow(1 - pos, 2.2);
            const head = Math.floor(ease * N);
            const tail = Math.max(0, head - Math.floor(N * 0.16));
            if (head > tail) {
              const [hx, hy] = arc.pts[head];
              const [tx, ty] = arc.pts[tail];
              const g = ctx.createLinearGradient(tx, ty, hx, hy);
              g.addColorStop(0, 'rgba(90, 150, 255, 0)');
              g.addColorStop(0.6, 'rgba(150, 195, 255, 0.5)');
              g.addColorStop(1, 'rgba(245, 250, 255, 0.95)');
              ctx.strokeStyle = g;
              ctx.lineWidth = 2;
              ctx.beginPath();
              ctx.moveTo(tx, ty);
              for (let k = tail + 1; k <= head; k++) ctx.lineTo(arc.pts[k][0], arc.pts[k][1]);
              ctx.stroke();
            }
          }
        }
      }

      for (const node of nodes) {
        const grow = reduced ? 1 : Math.min(1, Math.max(0, (t - node.born) / 600));
        if (grow <= 0) continue;
        const appear = 1 - Math.pow(1 - grow, 3);
        const breathe = reduced ? 1 : 0.86 + 0.14 * Math.sin(t / 1000 + node.phase * Math.PI * 2);
        const size = (node.hub ? 82 : 34) * appear * breathe;
        const sprite = node.hub ? spriteHub : spriteDot;
        ctx.drawImage(sprite, node.x - size / 2, node.y - size / 2, size, size);
        // 白芯常驻
        ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
        ctx.beginPath();
        ctx.arc(node.x, node.y, node.hub ? 2.6 : 1.6, 0, Math.PI * 2);
        ctx.fill();
        // 脉冲环：从节点发射的扩散圆（间隔错峰）
        if (!reduced) {
          const p = (t / 2200 + node.phase) % 1;
          const r = (node.hub ? 7 : 4.5) + p * (node.hub ? 22 : 13);
          ctx.strokeStyle = `rgba(120, 170, 255, ${((1 - p) * 0.32 * appear).toFixed(3)})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(node.x, node.y, r, 0, Math.PI * 2);
          ctx.stroke();
        }
      }

      ctx.globalCompositeOperation = 'source-over';
    };

    let raf = 0;
    const loop = () => {
      draw(performance.now());
      raf = requestAnimationFrame(loop);
    };

    // 容器尺寸变化：重建 backing store 与全部几何（否则 CSS 拉伸致模糊）
    let resizeTimer = 0;
    new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (wrap.offsetWidth === W && wrap.offsetHeight === H) return;
        W = wrap.offsetWidth;
        H = wrap.offsetHeight;
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        computeLayout();
        paintOffscreen();
        arcs = buildArcs();
        nodes = buildNodes();
        if (reduced) draw(t0 + 60000);
      }, 200);
    }).observe(wrap);

    canvas.classList.add('is-ready');
    wrap.classList.add('has-map');
    if (reduced) {
      draw(t0 + 60000); // 静态成品帧
    } else {
      raf = requestAnimationFrame(loop);
      // 离屏暂停，回屏恢复（长页滚动不空转）
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          if (!raf) raf = requestAnimationFrame(loop);
        } else {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }).observe(wrap);
    }
  }

  // 立即初始化：底图为构建期预计算数据（无网络/解码等待），首帧即新视觉，杜绝兜底图闪现
  init();
</script>
