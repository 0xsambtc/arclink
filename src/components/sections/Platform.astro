---
// 深色平台能力区 — Linear 式卡片升级：1px 描边 + 顶部内发光代替阴影，统一极简标记替代杂项 glyph（docs/01）
import { platform } from '../../data/home';
---

<section class="platform" id="platform" data-section="platform">
  <div class="shell">
    <div class="platform-heading">
      <div class="reveal">
        <p class="eyebrow">{platform.eyebrow}</p>
        <h2>{platform.heading}</h2>
      </div>
      <p class="platform-description reveal reveal-delay">{platform.description}</p>
    </div>
    <div class="platform-grid">
      {
        platform.features.map((feature) => (
          <article class="feature-card reveal">
            <span class="feature-tick" aria-hidden="true"></span>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .platform {
    padding: var(--space-9) 0;
    color: var(--color-text-on-dark);
    background: linear-gradient(135deg, var(--color-bg-navy), var(--color-bg-navy-alt));
  }

  .platform-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-9);
    align-items: end;
  }

  .platform-heading h2 {
    font-size: 43px;
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    margin: 0;
    max-width: 580px;
  }

  .platform-description {
    color: var(--color-text-muted-on-dark);
    font-size: 17px;
    margin: 0;
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .feature-card {
    padding: 28px 20px;
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.035);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    min-height: 245px;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      background var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-bright);
    background: rgba(37, 99, 235, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .feature-tick {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-accent-bright);
    margin-bottom: var(--space-5);
    box-shadow: 0 0 8px rgba(52, 120, 255, 0.6);
  }

  .feature-card h3 {
    font-size: 16px;
    margin: 0 0 var(--space-3);
  }

  .feature-card p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-soft-on-dark);
    margin: 0;
  }

  @media (max-width: 1120px) {
    .platform-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .platform-heading {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      align-items: start;
    }
    .platform-heading h2 {
      font-size: 32px;
    }
    .platform-grid {
      grid-template-columns: 1fr;
    }
    .feature-card {
      min-height: auto;
    }
  }
</style>
