---
// 深色平台能力区 — Linear 式卡片：1px 描边 + 顶部内发光代替阴影
// 每卡一枚语义线性 icon（16 网格 / 1.5 stroke / currentColor，与"光"语言同源）
import { platform } from '../../data/home';

// icon 顺序与 platform.features 一一对应：任务清单 / 双人 / 图层 / 盾勾 / 折线
const ICONS = [
  '<path d="M5 8h6M5 11h4"/><rect x="3" y="3" width="12" height="12" rx="2"/><path d="M11.5 3V1.5M6.5 3V1.5"/>',
  '<circle cx="6.5" cy="6" r="2.5"/><path d="M2 15c0-2.5 2-4 4.5-4S11 12.5 11 15"/><circle cx="12.5" cy="7" r="2"/><path d="M12 11.5c2 0 4 1.3 4 3.5"/>',
  '<path d="M9 2 16 6 9 10 2 6Z"/><path d="M2 10l7 4 7-4"/><path d="M2 13.5l7 4 7-4"/>',
  '<path d="M9 1.5 15 4v4.5c0 3.5-2.5 6.5-6 7.5-3.5-1-6-4-6-7.5V4Z"/><path d="M6.2 8.6l2 2 3.6-3.7"/>',
  '<path d="M2 15h14"/><path d="M3.5 12l3.5-4 3 2.5L14.5 5"/><circle cx="14.5" cy="5" r="1.3"/>',
];
---

<section class="platform" id="platform" data-section="platform" data-on-dark>
  <div class="shell">
    <div class="platform-heading">
      <div class="reveal">
        <p class="eyebrow">{platform.eyebrow}</p>
        <h2>{platform.heading}</h2>
      </div>
      <p class="platform-description reveal reveal-delay">{platform.description}</p>
    </div>
    <div class="platform-grid">
      {
        platform.features.map((feature, index) => (
          <div class="reveal card-slot" style={`--reveal-delay: ${index * 80}ms; --reveal-distance: 14px`}>
            <article class="feature-card">
              <svg class="feature-icon" viewBox="0 0 18 18" aria-hidden="true" set:html={ICONS[index]} />
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .platform {
    position: relative;
    padding: var(--space-9) 0;
    color: var(--color-text-on-dark);
    background: linear-gradient(135deg, var(--color-bg-navy), var(--color-bg-navy-alt));
  }

  /* 明暗接缝：与 hero 过渡线同语言的发光缝（裸 1px border 在白底上不可见） */
  .platform::before,
  .platform::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 8%, rgba(var(--color-accent-bright-rgb), 0.7), transparent 92%);
    box-shadow: 0 0 24px rgba(var(--color-accent-bright-rgb), 0.35);
  }

  .platform::before {
    top: 0;
  }

  .platform::after {
    bottom: 0;
    opacity: 0.6;
  }

  .platform-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-9);
    align-items: end;
  }

  .platform-heading h2 {
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    margin: 0;
    max-width: 580px;
  }

  .platform-description {
    color: var(--color-text-muted-on-dark);
    font-size: var(--text-body-l);
    margin: 0;
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .card-slot,
  .feature-card {
    height: 100%;
  }

  /* 浮起感 = 上亮下暗表层 + 顶缘高光；纯展示卡不做位移（不承诺可点） */
  .feature-card {
    padding: 28px 24px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.015));
    transition:
      border-color var(--duration-base) var(--ease-out),
      background var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .feature-card:hover {
    border-color: rgba(var(--color-accent-bright-rgb), 0.45);
    background: linear-gradient(180deg, rgba(52, 99, 235, 0.12), rgba(37, 99, 235, 0.04));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 16px 40px -16px rgba(var(--color-accent-rgb), 0.45);
  }

  .feature-icon {
    display: block;
    width: 20px;
    height: 20px;
    margin-bottom: var(--space-5);
    color: var(--color-accent-bright);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px rgba(var(--color-accent-bright-rgb), 0.6));
  }

  .feature-card h3 {
    font-size: 16px;
    margin: 0 0 var(--space-3);
  }

  .feature-card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-text-soft-on-dark);
    margin: 0;
  }

  @media (max-width: 1120px) {
    .platform-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .platform-heading {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      align-items: start;
    }
    .platform-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
