---
// Industries — 行业 2×2 卡片矩阵（Stripe use-cases 版位模式）
// 原型的选择器交互已废：四条描述均为一句话，藏起 3/4 逼用户点击属过度交互；全平铺更可扫读（该偏离已报备）
import { industries } from '../../data/home';

// icon 顺序与 industries.items 对应：AI 芯片 / 店面 / 地图钉 / 货箱（16 网格 / 1.5 stroke）
const ICONS = [
  '<rect x="5" y="5" width="8" height="8" rx="1.5"/><path d="M7 1.5V5M11 1.5V5M7 13v3.5M11 13v3.5M1.5 7H5M1.5 11H5M13 7h3.5M13 11h3.5"/>',
  '<path d="M3 7.5V15h12V7.5"/><path d="M1.5 7 3.2 2.5h11.6L16.5 7Z"/><path d="M7 15v-4.5h4V15"/>',
  '<path d="M9 16.5S3.5 11.5 3.5 7.5a5.5 5.5 0 0 1 11 0c0 4-5.5 9-5.5 9Z"/><circle cx="9" cy="7.5" r="2"/>',
  '<path d="M2.5 5.5 9 2l6.5 3.5v7L9 16l-6.5-3.5Z"/><path d="M2.5 5.5 9 9l6.5-3.5M9 9v7"/>',
];
---

<section class="industries" id="industries" data-section="industries">
  <div class="shell industries-grid">
    <div class="industries-intro reveal">
      <p class="eyebrow">{industries.eyebrow}</p>
      <h2>{industries.heading}</h2>
    </div>
    <div class="industry-grid">
      {
        industries.items.map((item, index) => (
          <article
            class="industry-card reveal"
            style={`--reveal-delay: ${index * 70}ms; --reveal-distance: 14px`}
          >
            <svg class="industry-icon" viewBox="0 0 18 18" aria-hidden="true" set:html={ICONS[index]} />
            <h3>{item.label}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .industries {
    padding: var(--space-9) 0;
    background: var(--color-surface);
    color: var(--color-text-on-light);
  }

  .industries-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    align-items: center;
    gap: var(--space-8);
  }

  h2 {
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .industry-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  /* 纯展示卡：hairline 轮廓 + 静态光影，不做位移/点击暗示 */
  .industry-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border-on-light);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgba(10, 29, 51, 0.03);
  }

  .industry-icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
    display: block;
  }

  .industry-card h3 {
    font-size: 16px;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-2);
  }

  .industry-card p {
    font-size: var(--text-body-s);
    line-height: 1.65;
    color: var(--color-text-muted-on-light);
    margin: 0;
  }

  @media (max-width: 1120px) {
    .industries-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      align-items: start;
    }
  }

  @media (max-width: 760px) {
    .industries {
      padding: var(--space-8) 0;
    }
    .industry-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
