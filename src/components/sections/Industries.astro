---
// Industries — 行业切换器（白底）；首项默认激活
// 描述紧贴 tab 行正下方（视线不跨屏）；激活态用底色+左边线+变色表达，不做持久位移
import { industries } from '../../data/home';
---

<section class="industries" id="industries" data-section="industries">
  <div class="shell industries-grid">
    <div class="industries-intro reveal">
      <p class="eyebrow">{industries.eyebrow}</p>
      <h2>{industries.heading}</h2>
    </div>
    <div class="industries-panel">
      <div class="industry-list">
        {
          industries.items.map((item, index) => (
            <button
              type="button"
              class:list={['industry-item', 'reveal', index === 0 && 'active']}
              style={`--reveal-delay: ${index * 70}ms; --reveal-distance: 14px`}
              data-industry={item.key}
              data-description={item.description}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span class="industry-index mono-caption" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <strong>{item.label}</strong>
            </button>
          ))
        }
      </div>
      <p class="industry-description reveal reveal-delay" id="industryDescription" aria-live="polite">
        {industries.items[0].description}
      </p>
    </div>
  </div>
</section>

<style>
  .industries {
    padding: var(--space-9) 0;
    background: var(--color-surface);
    color: var(--color-text-on-light);
  }

  .industries-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    align-items: start;
    gap: var(--space-8);
  }

  h2 {
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .industry-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .industry-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-3);
    background: none;
    border: 0;
    border-left: 1px solid var(--color-border-on-light);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font: inherit;
    color: var(--color-text-on-light);
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .industry-index {
    color: var(--color-text-muted-on-light);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .industry-item strong {
    font-weight: 650;
    color: var(--color-text-muted-on-light);
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* 三态分层：默认（muted）→ hover（半档预示）→ active（accent + 底色 + 边线 + 下缘线） */
  .industry-item:hover {
    background: rgba(var(--color-accent-rgb), 0.04);
    border-left-color: rgba(var(--color-accent-rgb), 0.45);
  }

  .industry-item:hover strong {
    color: var(--color-text-on-light);
  }

  .industry-item.active {
    background: var(--color-surface-tint);
    border-left-color: var(--color-accent);
    box-shadow: inset 0 -2px 0 var(--color-accent); /* 与 /join tab 的下缘线同语言 */
  }

  .industry-item.active strong,
  .industry-item.active .industry-index {
    color: var(--color-accent);
  }

  /* 描述紧贴 tab 行下方，与激活项同栏；切换时 JS 淡出淡入 */
  .industry-description {
    min-height: 60px;
    max-width: 62ch;
    margin: var(--space-5) 0 0;
    font-size: 19px;
    line-height: 1.7;
    color: var(--color-text-on-light);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .industry-description.is-fading {
    opacity: 0;
  }

  @media (max-width: 1120px) {
    .industry-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .industries {
      padding: var(--space-8) 0;
    }
    .industries-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .industry-list {
      grid-template-columns: repeat(2, 1fr);
    }
    .industry-description {
      font-size: 17px;
    }
  }
</style>

<script>
  // 行业切换：active 状态 + 描述淡出/替换/淡入（挂 transitionend，200ms 兜底；reduced-motion 直接替换）
  const section = document.querySelector('[data-section="industries"]');
  if (section) {
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('.industry-item'));
    const description = section.querySelector<HTMLElement>('#industryDescription');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        if (button.classList.contains('active')) return;
        buttons.forEach((other) => {
          other.classList.toggle('active', other === button);
          other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
        });
        if (!description) return;
        const swap = () => {
          description.textContent = button.dataset.description ?? '';
          description.classList.remove('is-fading');
        };
        if (reduced) {
          swap();
          return;
        }
        let done = false;
        const once = () => {
          if (done) return;
          done = true;
          swap();
        };
        description.addEventListener('transitionend', once, { once: true });
        window.setTimeout(once, 200);
        description.classList.add('is-fading');
      });
    });
  }
</script>
