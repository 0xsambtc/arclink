---
// NetworkCta — 加入网络 CTA 区（浅蓝底）；文案来自 data/home.ts 的 network 导出
// 右侧图形：与 hero 同语言的浅底 mini 网络（真实城市近似投影：新加坡枢纽放射 + 跨区干线），非随机装饰点
import Button from '../ui/Button.astro';
import { network } from '../../data/home';

// 城市节点（等距圆柱近似投影到 560×300 视箱；tier: 0=枢纽 1=干线 2=节点）
const nodes = [
  { key: 'sf', x: 16, y: 67, tier: 2 },
  { key: 'nyc', x: 110, y: 58, tier: 1 },
  { key: 'sao', x: 164, y: 250, tier: 2 },
  { key: 'lon', x: 255, y: 26, tier: 1 },
  { key: 'nbo', x: 328, y: 184, tier: 2 },
  { key: 'dxb', x: 364, y: 104, tier: 1 },
  { key: 'bom', x: 399, y: 123, tier: 2 },
  { key: 'bkk', x: 453, y: 139, tier: 2 },
  { key: 'sin', x: 459, y: 176, tier: 0 },
  { key: 'jkt', x: 465, y: 199, tier: 2 },
  { key: 'tyo', x: 530, y: 73, tier: 1 },
  { key: 'syd', x: 553, y: 282, tier: 2 },
];
const byKey = Object.fromEntries(nodes.map((n) => [n.key, n]));
const links = [
  ['sin', 'jkt'], ['sin', 'bkk'], ['sin', 'tyo'], ['sin', 'syd'], ['sin', 'bom'], ['sin', 'dxb'],
  ['dxb', 'lon'], ['dxb', 'nbo'], ['lon', 'nyc'], ['nyc', 'sf'], ['nyc', 'sao'], ['tyo', 'sf'],
] as const;
const RADII = [7, 5, 3];
// 与 hero 同语言：连线为上拱弧（二次贝塞尔，弧高 ∝ 距离）
const arc = (a: (typeof nodes)[number], b: (typeof nodes)[number]) => {
  const dist = Math.hypot(b.x - a.x, b.y - a.y);
  const mx = (a.x + b.x) / 2;
  const my = Math.min(a.y, b.y) - dist * 0.18;
  return `M ${a.x} ${a.y} Q ${mx} ${my} ${b.x} ${b.y}`;
};
---

<section class="network" id={network.id} data-section="network">
  <div class="shell network-grid">
    <div class="network-copy reveal">
      <p class="eyebrow">{network.eyebrow}</p>
      <h2>{network.heading}</h2>
      <p class="network-description">{network.description}</p>
      <div class="network-actions">
        <Button variant="primary" href={network.ctaPrimary.href}>
          {network.ctaPrimary.label} <span aria-hidden="true">→</span>
        </Button>
        <Button variant="outline-dark" href={network.ctaSecondary.href}>{network.ctaSecondary.label}</Button>
      </div>
    </div>
    <div class="network-map reveal reveal-delay" aria-hidden="true">
      <canvas id="netMap" class="net-canvas"></canvas>
      <svg class="net-fallback" viewBox="0 0 560 300">
        <g class="net-links">
          {links.map(([a, b]) => <path d={arc(byKey[a], byKey[b])} />)}
        </g>
        <circle class="hub-ripple" cx={byKey.sin.x} cy={byKey.sin.y} r={RADII[0] + 4} />
        <g class="net-rings">
          {nodes.map((n) => <circle cx={n.x} cy={n.y} r={RADII[n.tier] + 3.5} data-tier={n.tier} />)}
        </g>
        <g class="net-nodes">
          {nodes.map((n) => <circle cx={n.x} cy={n.y} r={RADII[n.tier]} data-tier={n.tier} />)}
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .network {
    padding: var(--space-9) 0;
    background: var(--color-surface-tint);
  }

  .network-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-9);
  }

  h2 {
    font-size: var(--text-h2);
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-5);
  }

  .network-description {
    font-size: var(--text-body-l);
    line-height: 1.8;
    color: var(--color-text-muted-on-light);
    margin: 0;
  }

  .network-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  /* 给图群一个"场"：极淡径向底光把点群从背景托出 */
  .network-map {
    background: radial-gradient(closest-side, rgba(var(--color-accent-rgb), 0.07), transparent 75%);
  }

  .network-map svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* 浅底细节：hairline 虚线弧 + 实色描边环代替 box-shadow 光晕 */
  .net-links path {
    fill: none;
    stroke: rgba(var(--color-accent-rgb), 0.4);
    stroke-width: 1;
    stroke-dasharray: 5 6;
  }

  .net-rings circle {
    fill: none;
    stroke: rgba(var(--color-accent-bright-rgb), 0.45);
    stroke-width: 2;
  }

  .net-rings circle[data-tier='0'] {
    stroke-width: 2.5;
    stroke: rgba(var(--color-accent-bright-rgb), 0.55);
  }

  /* 新加坡枢纽扩散环（真实数据锚点做视觉锚） */
  .hub-ripple {
    fill: none;
    stroke: var(--color-accent-bright);
    animation: hub-ripple 3s ease-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }

  @keyframes hub-ripple {
    0% {
      opacity: 0.6;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  .net-nodes circle {
    fill: var(--color-accent-bright);
    animation: node-pulse 2.8s ease-in-out infinite;
  }

  .net-nodes circle[data-tier='0'] {
    fill: var(--color-accent);
  }

  /* 错相位呼吸（避免机械齐闪） */
  .net-nodes circle:nth-child(2n) {
    animation-delay: 0.9s;
  }

  .net-nodes circle:nth-child(3n) {
    animation-delay: 1.8s;
  }

  @keyframes node-pulse {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 1120px) {
    .network-grid {
      gap: var(--space-7);
    }
  }

  @media (max-width: 760px) {
    .network {
      padding: var(--space-8) 0;
    }
    .network-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .network-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<style>
  /* canvas 同源网络图（浅色）；SVG 仅作无 JS 兜底 */
  .network-map {
    position: relative;
    aspect-ratio: 560 / 300;
  }
  .net-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-reveal) var(--ease-out);
  }
  .network-map.has-map .net-canvas {
    opacity: 1;
  }
  .network-map.has-map .net-fallback {
    visibility: hidden;
  }
</style>

<script>
  // 与 hero 同一份地理点阵数据（dotted-map 构建期预计算）的浅色版：同一网络的深浅两面
  import { DOT_MAP } from '../../data/world-dots';

  const wrap = document.querySelector<HTMLElement>('.network-map');
  const canvas = document.getElementById('netMap') as HTMLCanvasElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 与 hero 的 CITIES 同序索引；连线为 hero 弧网子集（新加坡枢纽 + 洲际干线）
  const PAIRS: [number, number][] = [
    [0, 2], [0, 3], [0, 7], [0, 9], [0, 10], [0, 11],
    [11, 12], [11, 17], [12, 15], [14, 15], [15, 16], [7, 14],
  ];
  const HUBS = new Set([0]);
  const MIDS = new Set([7, 11, 12, 15]);

  function init() {
    if (!wrap || !canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let W = 0;
    let H = 0;
    let mapW = 0;
    let mapH = 0;
    let x0 = 0;
    let y0 = 0;
    let arcs: { pts: [number, number][]; grads: CanvasGradient[]; born: number; dur: number; delay: number }[] = [];
    let seed = 11;
    const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    const at = (nx: number, ny: number) => [x0 + nx * mapW, y0 + ny * mapH] as [number, number];
    const cityPt = (i: number) => at(DOT_MAP.cityXY[i][0], DOT_MAP.cityXY[i][1]);

    const off = document.createElement('canvas');
    const octx = off.getContext('2d')!;
    const N = 56;
    // 浅底两层描边：宽软晕 + 主色芯（浅色背景不用加色混合与白芯）
    const LAYERS = [
      { w: 3.6, a: 0.1 },
      { w: 1.15, a: 0.52 },
    ];
    const rebuild = () => {
      W = wrap.offsetWidth;
      H = wrap.offsetHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      mapW = W * 1.02;
      mapH = mapW / DOT_MAP.aspect;
      x0 = -W * 0.01;
      y0 = (H - mapH) * 0.55;
      // 底图点阵：静态离屏（浅蓝、低对比，让位于前景弧网）
      off.width = W * dpr;
      off.height = H * dpr;
      octx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed = 11;
      const d = DOT_MAP.dots;
      for (let i = 0; i < d.length; i += 2) {
        const [x, y] = at(d[i], d[i + 1]);
        octx.fillStyle = `rgba(37, 99, 235, ${(0.1 + rand() * 0.1).toFixed(3)})`;
        octx.beginPath();
        octx.arc(x, y, 1.1, 0, Math.PI * 2);
        octx.fill();
      }
      // 上下缘渐隐，嵌进浅底不生硬
      octx.globalCompositeOperation = 'destination-in';
      const vg = octx.createLinearGradient(0, 0, 0, H);
      vg.addColorStop(0, 'rgba(0,0,0,0)');
      vg.addColorStop(0.14, 'rgba(0,0,0,1)');
      vg.addColorStop(0.9, 'rgba(0,0,0,1)');
      vg.addColorStop(1, 'rgba(0,0,0,0)');
      octx.fillStyle = vg;
      octx.fillRect(0, 0, W, H);
      octx.globalCompositeOperation = 'source-over';
      arcs = PAIRS.map(([a, b], i) => {
        const [ax, ay] = cityPt(a);
        const [bx, by] = cityPt(b);
        const mx = (ax + bx) / 2;
        const dist = Math.hypot(bx - ax, by - ay);
        const peak = Math.min(ay, by) - (dist * 0.24 + 18);
        const pts: [number, number][] = [];
        for (let k = 0; k <= N; k++) {
          const t = k / N;
          pts.push([
            (1 - t) * (1 - t) * ax + 2 * (1 - t) * t * mx + t * t * bx,
            (1 - t) * (1 - t) * ay + 2 * (1 - t) * t * peak + t * t * by,
          ]);
        }
        const grads = LAYERS.map((L) => {
          const g = ctx.createLinearGradient(ax, ay, bx, by);
          g.addColorStop(0, 'rgba(37, 99, 235, 0)');
          g.addColorStop(0.1, `rgba(37, 99, 235, ${L.a})`);
          g.addColorStop(0.9, `rgba(37, 99, 235, ${L.a})`);
          g.addColorStop(1, 'rgba(37, 99, 235, 0)');
          return g;
        });
        return { pts, grads, born: 200 + i * 110, dur: 3000 + rand() * 2000, delay: rand() * 4000 };
      });
    };
    rebuild();

    let t0 = 0;
    const draw = (now: number) => {
      if (ctx.getTransform().a !== dpr) rebuild();
      const t = now - t0;
      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(off, 0, 0, W, H);
      ctx.lineCap = 'round';
      for (const arc of arcs) {
        const grow = reduced ? 1 : Math.min(1, Math.max(0, (t - arc.born) / 900));
        if (grow <= 0) continue;
        const eased = 1 - Math.pow(1 - grow, 3);
        const last = Math.max(1, Math.floor(eased * N));
        for (let L = 0; L < LAYERS.length; L++) {
          ctx.strokeStyle = arc.grads[L];
          ctx.lineWidth = LAYERS[L].w;
          ctx.beginPath();
          ctx.moveTo(arc.pts[0][0], arc.pts[0][1]);
          for (let k = 1; k <= last; k++) ctx.lineTo(arc.pts[k][0], arc.pts[k][1]);
          ctx.stroke();
        }
        // 流光（浅色版更含蓄）：深蓝光束窗口错峰巡航
        if (!reduced && eased >= 1) {
          const cyc = arc.dur * 2.1;
          const pos = (((t - arc.delay) % cyc) + cyc) % cyc / arc.dur;
          if (pos <= 1) {
            const ease = 1 - Math.pow(1 - pos, 2.2);
            const head = Math.floor(ease * N);
            const tail = Math.max(0, head - Math.floor(N * 0.14));
            if (head > tail) {
              const g = ctx.createLinearGradient(arc.pts[tail][0], arc.pts[tail][1], arc.pts[head][0], arc.pts[head][1]);
              g.addColorStop(0, 'rgba(37, 99, 235, 0)');
              g.addColorStop(1, 'rgba(29, 78, 216, 0.75)');
              ctx.strokeStyle = g;
              ctx.lineWidth = 1.6;
              ctx.beginPath();
              ctx.moveTo(arc.pts[tail][0], arc.pts[tail][1]);
              for (let k = tail + 1; k <= head; k++) ctx.lineTo(arc.pts[k][0], arc.pts[k][1]);
              ctx.stroke();
            }
          }
        }
      }
      // 节点：主色实心 + 错峰脉冲环（与 hero 同语言，浅色克制版）
      for (let i = 0; i < DOT_MAP.cityXY.length; i++) {
        const [x, y] = cityPt(i);
        const r = HUBS.has(i) ? 5 : MIDS.has(i) ? 3.6 : 2.4;
        ctx.fillStyle = 'rgba(37, 99, 235, 0.95)';
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
        if (!reduced) {
          const p = (t / 2400 + i * 0.13) % 1;
          ctx.strokeStyle = `rgba(37, 99, 235, ${((1 - p) * 0.3).toFixed(3)})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(x, y, r + 2 + p * (HUBS.has(i) ? 16 : 9), 0, Math.PI * 2);
          ctx.stroke();
        }
      }
    };

    let raf = 0;
    const loop = () => {
      draw(performance.now());
      raf = requestAnimationFrame(loop);
    };
    let resizeTimer = 0;
    new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (wrap.offsetWidth === W && wrap.offsetHeight === H) return;
        rebuild();
        if (reduced) draw(t0 + 60000);
      }, 200);
    }).observe(wrap);

    wrap.classList.add('has-map');
    if (reduced) {
      t0 = performance.now();
      draw(t0 + 60000);
      return;
    }
    // 入场生长从首次进入视口起算；离屏暂停
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        if (!t0) t0 = performance.now();
        if (!raf) raf = requestAnimationFrame(loop);
      } else if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }).observe(wrap);
  }

  init();
</script>
