---
// Footer — 深色页脚（logo + tagline / 4 链接栏 / legal 行）
// 数据全部来自 home.ts footerData；footer-bottom 右侧留空 span 槽位（后续语言切换/社交链接）
import { footerData } from '../../data/home';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand reveal">
      <a class="footer-logo" href="#home" aria-label="Arclink — back to top">
        <span class="logo-symbol" aria-hidden="true">
          <span class="node node-left"></span>
          <span class="node node-right"></span>
          <span class="arc"></span>
        </span>
        <span class="wordmark">ARCLINK</span>
      </a>
      <p class="footer-tagline">{footerData.tagline}</p>
    </div>
    {
      footerData.columns.map((column) => (
        <div class="footer-column reveal reveal-delay">
          <h3>{column.title}</h3>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="shell footer-bottom">
    <span>{footerData.legal}</span>
    <!-- 槽位：后续放语言切换 / 社交链接 -->
    <span class="footer-bottom-slot"></span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg);
    color: var(--color-text-soft-on-dark);
    padding: var(--space-8) 0 var(--space-5);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: var(--space-7);
    padding-bottom: var(--space-7);
  }

  /* Logo（结构照搬原型：双节点 + 弧线） */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text-on-dark);
  }

  .logo-symbol {
    position: relative;
    width: 43px;
    height: 26px;
    display: inline-block;
  }

  .node {
    position: absolute;
    bottom: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-bright);
  }

  .node-left {
    left: 0;
  }

  .node-right {
    right: 0;
  }

  .arc {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 5px;
    height: 20px;
    border-top: 3px solid var(--color-accent-bright);
    border-radius: 50%;
  }

  .wordmark {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .footer-tagline {
    margin: var(--space-5) 0 0;
    font-size: 14px;
    line-height: 1.75;
    color: var(--color-text-muted-on-dark);
    max-width: 320px;
  }

  .footer-column h3 {
    margin: 0 0 var(--space-4);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text-on-dark);
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-column a {
    font-size: 13px;
    color: var(--color-text-soft-on-dark);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-column a:hover {
    color: var(--color-text-on-dark);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-on-dark);
    font-size: 13px;
    color: var(--color-text-muted-on-dark);
  }

  @media (max-width: 1120px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
