---
// Footer — 极简单行页脚（原型 minimal-footer）：法律主体 + support 邮箱 + 隐私/条款链接
import { site } from '../../data/site';
import { footerData } from '../../data/home';
---

<footer class="site-footer">
  <div class="shell footer-line">
    <span class="footer-legal">{site.copyright}</span>
    <nav class="footer-links" aria-label="Legal">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {footerData.legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg);
    color: var(--color-text-muted-on-dark);
    padding: var(--space-6) 0;
  }

  .footer-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: 13px;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .footer-links a {
    color: var(--color-text-soft-on-dark);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--color-text-on-dark);
  }

  @media (max-width: 760px) {
    .footer-line {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .footer-links {
      flex-wrap: wrap;
      gap: var(--space-4);
    }
  }
</style>
