---
// Footer — 极简单行页脚（原型 minimal-footer）：法律主体 + support 邮箱 + 隐私/条款链接
import { site } from '../../data/site';
import { footerData } from '../../data/home';
---

<footer class="site-footer">
  <div class="shell footer-line">
    <div class="footer-identity">
      <span class="footer-legal">{site.copyright}</span>
      <span class="footer-address">{site.addressLines[0]} {site.addressLines[1]}</span>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href="/contact">Talk to Sales</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {footerData.legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg);
    color: var(--color-text-muted-on-dark);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--hairline); /* 与上一区分界，页脚有独立身份 */
  }

  .footer-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: 13px;
  }

  .footer-identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* 注册地址：尽调习惯先翻页脚看法律实体 */
  .footer-address {
    color: var(--color-text-soft-on-dark);
    font-size: 12px;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .footer-links a {
    color: var(--color-text-soft-on-dark);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* 联系组（Talk to Sales + 邮箱）与法律组之间用 hairline 分组 */
  .footer-links a:nth-child(2) {
    padding-right: var(--space-5);
    border-right: 1px solid var(--hairline);
  }

  .footer-links a:hover {
    color: var(--color-text-on-dark);
  }

  @media (max-width: 760px) {
    .footer-line {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .footer-links {
      flex-wrap: wrap;
      gap: var(--space-4);
    }
  }
</style>
