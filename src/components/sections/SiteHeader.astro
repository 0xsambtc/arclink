---
// 固定导航 — 透明起步，滚动后毛玻璃深色底；Solutions 悬停下拉；移动端汉堡菜单
// solid：子页（无深色 hero）常驻深色底
import Button from '../ui/Button.astro';
import { nav } from '../../data/home';

interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;
---

<header class:list={['site-header', solid && 'solid']} id="siteHeader">
  <div class="shell nav-shell">
    <a class="logo" href="/" aria-label="ARCLINK Home">
      <span class="logo-symbol" aria-hidden="true">
        <span class="node node-left"></span>
        <span class="arc"></span>
        <span class="node node-right"></span>
      </span>
      <span class="logo-word">ARCLINK</span>
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label="Open navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="main-nav" id="mainNav" aria-label="Primary navigation">
      <div class="nav-dropdown" id="navDropdown">
        <button class="drop-trigger" type="button" aria-expanded="false" aria-haspopup="true">
          {nav.solutions.label} <span class="caret" aria-hidden="true">▾</span>
        </button>
        <div class="solution-menu">
          {nav.solutions.items.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>
      {nav.links.map((link) => <a href={link.href} data-nav={link.key}>{link.label}</a>)}
    </nav>
    <div class="nav-actions">
      <Button variant="outline" href={nav.ctaSales.href}>{nav.ctaSales.label}</Button>
      <Button variant="primary" href={nav.ctaNetwork.href}>{nav.ctaNetwork.label} <span aria-hidden="true">→</span></Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent;
    transition: background var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .site-header.scrolled,
  .site-header.solid {
    background: rgba(3, 10, 25, 0.88);
    backdrop-filter: blur(18px);
    border-bottom-color: var(--color-border-on-dark);
  }

  .nav-shell {
    height: 88px;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-on-dark);
    text-decoration: none;
    min-width: 220px;
  }

  .logo-word {
    font-weight: 700;
    letter-spacing: 0.16em;
    font-size: 19px;
  }

  .logo-symbol {
    position: relative;
    width: 43px;
    height: 26px;
    display: inline-block;
  }

  .logo-symbol .node {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    top: 17px;
    background: var(--color-accent);
  }

  .node-left {
    left: 1px;
  }

  .node-right {
    right: 1px;
  }

  .logo-symbol .arc {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 5px;
    height: 20px;
    border-top: 3px solid var(--color-accent);
    border-radius: 50%;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 42px;
    margin-left: auto;
  }

  .main-nav a,
  .drop-trigger {
    color: var(--color-text-muted-on-dark);
    text-decoration: none;
    font: inherit;
    font-size: 14px;
    background: none;
    border: 0;
    cursor: pointer;
    position: relative;
    padding: 34px 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .main-nav > a::after {
    content: '';
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: 20px;
    height: 2px;
    background: var(--color-accent-bright);
    transition: left var(--duration-fast) var(--ease-out), right var(--duration-fast) var(--ease-out);
  }

  .main-nav > a:hover,
  .main-nav > a.active,
  .drop-trigger.active,
  .nav-dropdown:hover .drop-trigger,
  .nav-dropdown:focus-within .drop-trigger {
    color: var(--color-text-on-dark);
  }

  .main-nav > a:hover::after,
  .main-nav > a.active::after {
    left: 0;
    right: 0;
  }

  .caret {
    font-size: 10px;
    display: inline-block;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown:hover .caret,
  .nav-dropdown:focus-within .caret {
    transform: translateY(2px);
  }

  .solution-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 218px;
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: rgba(5, 14, 32, 0.97);
    border: 1px solid var(--color-border-on-dark);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .nav-dropdown:hover .solution-menu,
  .nav-dropdown:focus-within .solution-menu,
  .nav-dropdown.open .solution-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .solution-menu a {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: 14px;
  }

  .solution-menu a:hover {
    color: var(--color-text-on-dark);
    background: rgba(37, 99, 235, 0.14);
  }

  .nav-actions {
    display: flex;
    gap: var(--space-4);
  }

  .menu-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    cursor: pointer;
    padding: var(--space-2);
  }

  .menu-toggle span {
    display: block;
    width: 25px;
    height: 2px;
    background: var(--color-text-on-dark);
    margin: 5px 0;
  }

  @media (max-width: 1120px) {
    .nav-actions {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .nav-shell {
      height: 72px;
    }
    .menu-toggle {
      display: block;
    }
    .logo {
      min-width: 0;
    }
    .main-nav {
      position: absolute;
      top: 72px;
      left: 15px;
      right: 15px;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-4);
      border-radius: var(--radius-md);
      background: var(--color-bg-navy);
    }
    .main-nav.open {
      display: flex;
    }
    .main-nav a,
    .drop-trigger {
      padding: var(--space-4);
      text-align: left;
    }
    .main-nav > a::after {
      display: none;
    }
    /* 移动端下拉改为内联展开列表 */
    .solution-menu {
      position: static;
      transform: none;
      min-width: 0;
      display: none;
      opacity: 1;
      visibility: visible;
      border: 0;
      box-shadow: none;
      background: rgba(255, 255, 255, 0.04);
    }
    .nav-dropdown.open .solution-menu {
      display: flex;
      transform: none;
    }
  }
</style>

<script>
  const header = document.getElementById('siteHeader')!;
  const menuToggle = document.getElementById('menuToggle')!;
  const mainNav = document.getElementById('mainNav')!;
  const dropdown = document.getElementById('navDropdown')!;
  const dropTrigger = dropdown.querySelector<HTMLButtonElement>('.drop-trigger')!;
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];

  window.addEventListener('scroll', () => header.classList.toggle('scrolled', window.scrollY > 20), {
    passive: true,
  });

  menuToggle.addEventListener('click', () => {
    const open = mainNav.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', String(open));
  });

  // 点击切换下拉（触屏/键盘）；桌面 hover 由 CSS 负责
  dropTrigger.addEventListener('click', () => {
    const open = dropdown.classList.toggle('open');
    dropTrigger.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (event) => {
    if (!dropdown.contains(event.target as Node)) {
      dropdown.classList.remove('open');
      dropTrigger.setAttribute('aria-expanded', 'false');
    }
  });

  mainNav.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      mainNav.classList.remove('open');
      dropdown.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
    })
  );

  // 当前 section 高亮（仅首页锚点区生效）；Solutions 下拉覆盖 platform/industries/infrastructure 三区
  const SOLUTION_SECTIONS = ['platform', 'industries', 'infrastructure'];
  const sectionObserver = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const key = (entry.target as HTMLElement).dataset.section ?? '';
        navLinks.forEach((link) => link.classList.toggle('active', link.dataset.nav === key));
        dropTrigger.classList.toggle('active', SOLUTION_SECTIONS.includes(key));
      }),
    { rootMargin: '-35% 0px -55% 0px' }
  );
  document.querySelectorAll('[data-section]').forEach((section) => sectionObserver.observe(section));
</script>
