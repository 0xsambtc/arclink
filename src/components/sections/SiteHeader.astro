---
// 固定导航 — 透明起步，滚动后毛玻璃深色底；Solutions 悬停下拉；移动端汉堡菜单
// solid：子页（无深色 hero）常驻深色底
import Button from '../ui/Button.astro';
import { nav } from '../../data/home';

interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href.replace(/\/$/, '') || '/') === path;
---

<header class:list={['site-header', solid && 'solid']} id="siteHeader">
  <div class="shell nav-shell">
    <a class="logo" href="/" aria-label="Arclink — Home">
      <img class="logo-img" src="/brand/arclink-logo-reversed.png" alt="Arclink" width="381" height="96" />
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label="Open navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="main-nav" id="mainNav" aria-label="Primary navigation">
      <div class="nav-dropdown" id="navDropdown">
        <button class="drop-trigger" type="button" aria-expanded="false" aria-haspopup="true">
          {nav.solutions.label}
          <svg class="caret" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" /></svg>
        </button>
        <div class="solution-menu">
          {nav.solutions.items.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>
      {nav.links.map((link) => (
        <a href={link.href} data-nav={link.key} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <div class="menu-ctas">
        <a class="button button-outline" href={nav.ctaSales.href}>{nav.ctaSales.label}</a>
        <a class="button button-primary" href={nav.ctaNetwork.href}>{nav.ctaNetwork.label} <span aria-hidden="true">→</span></a>
      </div>
    </nav>
    <div class="nav-actions">
      <Button variant="outline" href={nav.ctaSales.href}>{nav.ctaSales.label}</Button>
      <Button variant="primary" href={nav.ctaNetwork.href}>{nav.ctaNetwork.label} <span aria-hidden="true">→</span></Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    background: transparent;
    transition:
      background var(--duration-base) var(--ease-out),
      backdrop-filter var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .site-header.scrolled,
  .site-header.solid {
    background: rgba(var(--color-bg-rgb), 0.88);
    backdrop-filter: blur(18px);
    border-bottom-color: var(--color-border-on-dark);
  }

  .nav-shell {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-width: 220px;
  }

  /* 正式 logo（位图过渡版，矢量源到位后替换）；固高 30px 保持字重清晰 */
  .logo-img {
    height: 30px;
    width: auto;
    display: block;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 40px;
    margin-left: auto;
  }

  .main-nav > a,
  .solution-menu a,
  .drop-trigger {
    color: var(--color-text-muted-on-dark);
    text-decoration: none;
    font: inherit;
    font-size: 14px;
    background: none;
    border: 0;
    cursor: pointer;
    position: relative;
    padding: 34px 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* 下划线用 transform 驱动（合成层，不触发 layout） */
  .main-nav > a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    height: 2px;
    background: var(--color-accent-bright);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .main-nav > a:hover,
  .main-nav > a.active,
  .main-nav > a[aria-current='page'],
  .drop-trigger.active,
  .nav-dropdown:hover .drop-trigger,
  .nav-dropdown:focus-within .drop-trigger,
  .nav-dropdown.open .drop-trigger {
    color: var(--color-text-on-dark);
  }

  .main-nav > a:hover::after,
  .main-nav > a.active::after,
  .main-nav > a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .caret {
    width: 10px;
    height: 7px;
    margin-left: 2px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .nav-dropdown {
    position: relative;
  }

  /* 展开 = 旋转 180°（hover / 键盘 / 点击开三条路径同态） */
  .nav-dropdown:hover .caret,
  .nav-dropdown:focus-within .caret,
  .nav-dropdown.open .caret {
    transform: rotate(180deg);
  }

  .solution-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 218px;
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: rgba(var(--color-bg-rgb), 0.97);
    border: 1px solid var(--color-border-on-dark);
    box-shadow:
      inset 0 1px 0 rgba(var(--color-accent-bright-rgb), 0.25),
      0 18px 45px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  /* hover 桥：面板与触发器之间的 8px 间隙不脱手 */
  .solution-menu::before {
    content: '';
    position: absolute;
    top: -9px;
    left: 0;
    right: 0;
    height: 9px;
  }

  .nav-dropdown:hover .solution-menu,
  .nav-dropdown:focus-within .solution-menu,
  .nav-dropdown.open .solution-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .solution-menu a {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: 14px;
  }

  .solution-menu a:hover,
  .solution-menu a.active {
    color: var(--color-text-on-dark);
    background: rgba(var(--color-accent-rgb), 0.14);
  }

  .nav-actions {
    display: flex;
    gap: var(--space-4);
    margin-left: var(--space-4); /* 链接组与 CTA 组的组间距 > 组内距 */
  }

  .menu-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    cursor: pointer;
    padding: var(--space-2);
  }

  /* 汉堡 → 关闭态变形（aria-expanded 驱动） */
  .menu-toggle span {
    display: block;
    width: 25px;
    height: 2px;
    background: var(--color-text-on-dark);
    margin: 5px 0;
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .menu-ctas {
    display: none;
  }

  /* ≤1120：文字导航收进汉堡面板，转化 CTA 保留在条上（不留转化断层区间） */
  @media (max-width: 1120px) {
    .menu-toggle {
      display: block;
    }
    .logo {
      min-width: 0;
    }
    .main-nav {
      position: absolute;
      top: var(--header-h);
      left: 15px;
      right: 15px;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-4);
      border-radius: var(--radius-md);
      background: var(--color-bg-navy);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    }
    .main-nav.open {
      display: flex;
      animation: menu-in var(--duration-panel) var(--ease-out);
    }
    .main-nav > a,
    .solution-menu a,
    .drop-trigger {
      padding: var(--space-4);
      text-align: left;
    }
    .main-nav > a::after {
      display: none;
    }
    /* 面板内下拉改为内联展开列表 */
    .solution-menu {
      position: static;
      transform: none;
      min-width: 0;
      display: none;
      opacity: 1;
      visibility: visible;
      border: 0;
      box-shadow: none;
      background: rgba(255, 255, 255, 0.04);
    }
    .nav-dropdown.open .solution-menu {
      display: flex;
      transform: none;
    }
  }

  /* ≤760：CTA 也收进面板（条上放不下两颗按钮） */
  @media (max-width: 760px) {
    .nav-actions {
      display: none;
    }
    .menu-ctas {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin-top: var(--space-2);
      padding: var(--space-4);
      border-top: 1px solid var(--color-border-on-dark);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>

<script>
  const header = document.getElementById('siteHeader')!;
  const menuToggle = document.getElementById('menuToggle')!;
  const mainNav = document.getElementById('mainNav')!;
  const dropdown = document.getElementById('navDropdown')!;
  const dropTrigger = dropdown.querySelector<HTMLButtonElement>('.drop-trigger')!;
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];

  window.addEventListener('scroll', () => header.classList.toggle('scrolled', window.scrollY > 20), {
    passive: true,
  });

  menuToggle.addEventListener('click', () => {
    const open = mainNav.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', String(open));
  });

  // 点击切换下拉（触屏/键盘）；桌面 hover 由 CSS 负责
  dropTrigger.addEventListener('click', () => {
    const open = dropdown.classList.toggle('open');
    dropTrigger.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (event) => {
    if (!dropdown.contains(event.target as Node)) {
      dropdown.classList.remove('open');
      dropTrigger.setAttribute('aria-expanded', 'false');
    }
  });

  mainNav.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      mainNav.classList.remove('open');
      dropdown.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
    })
  );

  // 当前 section 高亮（仅首页锚点区生效）；Solutions 下拉覆盖 platform/industries/infrastructure 三区
  const SOLUTION_SECTIONS = ['platform', 'industries', 'infrastructure'];
  const sectionObserver = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const key = (entry.target as HTMLElement).dataset.section ?? '';
        navLinks.forEach((link) => link.classList.toggle('active', link.dataset.nav === key));
        dropTrigger.classList.toggle('active', SOLUTION_SECTIONS.includes(key));
        dropdown.querySelectorAll<HTMLAnchorElement>('.solution-menu a').forEach((item) => {
          item.classList.toggle('active', item.getAttribute('href') === `/#${key}`);
        });
      }),
    { rootMargin: '-35% 0px -55% 0px' }
  );
  document.querySelectorAll('[data-section]').forEach((section) => sectionObserver.observe(section));
</script>
