---
// 固定导航 — 透明起步，滚动后毛玻璃深色底；移动端汉堡菜单；当前 section 高亮
import Button from '../ui/Button.astro';
import { nav } from '../../data/home';
---

<header class="site-header" id="siteHeader">
  <div class="shell nav-shell">
    <a class="logo" href="#home" aria-label="ARCLINK Home">
      <span class="logo-symbol" aria-hidden="true">
        <span class="node node-left"></span>
        <span class="arc"></span>
        <span class="node node-right"></span>
      </span>
      <span class="logo-word">ARCLINK</span>
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label="Open navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="main-nav" id="mainNav" aria-label="Primary navigation">
      {nav.links.map((link) => <a href={link.href} data-nav={link.key}>{link.label}</a>)}
    </nav>
    <div class="nav-actions">
      <Button variant="primary" data-open-modal={nav.ctaPrimary.modal}>{nav.ctaPrimary.label} <span aria-hidden="true">→</span></Button>
      <Button variant="outline" data-open-modal={nav.ctaSecondary.modal}>{nav.ctaSecondary.label} <span aria-hidden="true">→</span></Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent;
    transition: background var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .site-header.scrolled {
    background: rgba(3, 10, 25, 0.88);
    backdrop-filter: blur(18px);
    border-bottom-color: var(--color-border-on-dark);
  }

  .nav-shell {
    height: 88px;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-on-dark);
    text-decoration: none;
    min-width: 220px;
  }

  .logo-word {
    font-weight: 700;
    letter-spacing: 0.16em;
    font-size: 19px;
  }

  .logo-symbol {
    position: relative;
    width: 43px;
    height: 26px;
    display: inline-block;
  }

  .logo-symbol .node {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    top: 17px;
    background: var(--color-accent);
  }

  .node-left {
    left: 1px;
  }

  .node-right {
    right: 1px;
  }

  .logo-symbol .arc {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 5px;
    height: 20px;
    border-top: 3px solid var(--color-accent);
    border-radius: 50%;
  }

  .main-nav {
    display: flex;
    gap: 42px;
    margin-left: auto;
  }

  .main-nav a {
    color: var(--color-text-muted-on-dark);
    text-decoration: none;
    font-size: 14px;
    position: relative;
    padding: 34px 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .main-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: 20px;
    height: 2px;
    background: var(--color-accent-bright);
    transition: left var(--duration-fast) var(--ease-out), right var(--duration-fast) var(--ease-out);
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--color-text-on-dark);
  }

  .main-nav a:hover::after,
  .main-nav a.active::after {
    left: 0;
    right: 0;
  }

  .nav-actions {
    display: flex;
    gap: var(--space-4);
  }

  .menu-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    cursor: pointer;
    padding: var(--space-2);
  }

  .menu-toggle span {
    display: block;
    width: 25px;
    height: 2px;
    background: var(--color-text-on-dark);
    margin: 5px 0;
  }

  @media (max-width: 1120px) {
    .nav-actions {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .nav-shell {
      height: 72px;
    }
    .menu-toggle {
      display: block;
    }
    .logo {
      min-width: 0;
    }
    .main-nav {
      position: absolute;
      top: 72px;
      left: 15px;
      right: 15px;
      display: none;
      flex-direction: column;
      gap: 0;
      padding: var(--space-4);
      border-radius: var(--radius-md);
      background: var(--color-bg-navy);
    }
    .main-nav.open {
      display: flex;
    }
    .main-nav a {
      padding: var(--space-4);
    }
    .main-nav a::after {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById('siteHeader')!;
  const menuToggle = document.getElementById('menuToggle')!;
  const mainNav = document.getElementById('mainNav')!;
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];

  window.addEventListener('scroll', () => header.classList.toggle('scrolled', window.scrollY > 20), {
    passive: true,
  });

  menuToggle.addEventListener('click', () => {
    const open = mainNav.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', String(open));
  });

  navLinks.forEach((link) =>
    link.addEventListener('click', () => {
      mainNav.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
    })
  );

  // 当前 section 高亮
  const sectionObserver = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const key = (entry.target as HTMLElement).dataset.section;
        navLinks.forEach((link) => link.classList.toggle('active', link.dataset.nav === key));
      }),
    { rootMargin: '-35% 0px -55% 0px' }
  );
  document.querySelectorAll('[data-section]').forEach((section) => sectionObserver.observe(section));
</script>
