---
// Process — 四步执行流程横排（浅色渐变底）
// 圆形图标内放 mono 步骤号；步与步之间用可伸缩虚线连接；滚动进入按 90ms 级差依次点亮（线性叙事）
import { process } from '../../data/home';
---

<section class="process" id={process.id} data-section={process.id}>
  <div class="shell">
    <div class="section-heading reveal">
      <p class="eyebrow">{process.eyebrow}</p>
      <h2>{process.heading}</h2>
    </div>
    <div class="process-track">
      {
        process.steps.map((step, index) => (
          <>
            {index > 0 && <span class="process-line reveal" style={`--reveal-delay: ${index * 90}ms`} aria-hidden="true" />}
            <article class="process-step reveal" style={`--reveal-delay: ${index * 90}ms; --reveal-distance: 14px`}>
              <span class="step-icon">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .process {
    padding: var(--space-9) 0;
    background: linear-gradient(180deg, var(--color-surface), var(--color-surface-alt));
  }

  .section-heading {
    text-align: center;
    margin-bottom: var(--space-7);
  }

  .section-heading h2 {
    font-size: var(--text-h2);
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .process-track {
    max-width: 1160px;
    margin-inline: auto;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .process-step {
    flex: 0 1 236px;
    text-align: center;
  }

  /* 圆形图标：mono 步骤号 */
  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 74px;
    height: 74px;
    border-radius: 50%;
    border: 1px solid var(--color-border-on-light);
    background: var(--color-surface);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .process-step:hover .step-icon {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.08);
  }

  .process-step h3 {
    font-size: 17px;
    letter-spacing: var(--tracking-tight);
    margin: var(--space-5) 0 var(--space-2);
  }

  .process-step p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-text-muted-on-light);
    margin: 0;
  }

  /* 步间连接线：可伸缩虚线，与 74px 圆心对齐 */
  .process-line {
    flex: 1;
    height: 1px;
    margin-top: 37px;
    background: repeating-linear-gradient(90deg, var(--color-accent) 0 6px, transparent 6px 12px);
    opacity: 0.55;
  }

  @media (max-width: 760px) {
    .process {
      padding: var(--space-8) 0;
    }
    /* 横向滚动，保持流程的线性叙事 */
    .process-track {
      justify-content: flex-start;
      gap: var(--space-4);
      overflow-x: auto;
      padding-bottom: var(--space-4);
      -webkit-overflow-scrolling: touch;
    }
    .process-step {
      flex: 0 0 168px;
    }
    .process-line {
      flex: 0 0 30px;
    }
  }
</style>
