---
// Process — 四步流程"进度轨"：贯通细线 + 依次点亮的节点 + mono 编号 + 左对齐文字
// （大空心圆样式已废：与标题量级不配且居中文字过时；序列语义由轨道+编号承担）
import { process } from '../../data/home';
---

<section class="process" id={process.id} data-section={process.id}>
  <div class="shell">
    <div class="section-heading reveal">
      <p class="eyebrow">{process.eyebrow}</p>
      <h2>{process.heading}</h2>
    </div>
    <ol class="process-rail">
      {
        process.steps.map((step, index) => (
          <li class="pstep reveal" style={`--reveal-delay: ${index * 110}ms; --reveal-distance: 14px`}>
            <span class="pstep-node" aria-hidden="true"></span>
            <span class="pstep-num mono-caption">{`0${step.number}`}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    padding: var(--space-9) 0;
    /* 渐变终点直接接下一区底色（surface-tint = Network 区同源），消除"两种近白"接缝 */
    background: linear-gradient(180deg, var(--color-surface), var(--color-surface-tint));
  }

  .section-heading {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .section-heading h2 {
    font-size: var(--text-h2);
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  /* —— 进度轨：一条贯通细线，四颗节点骑于其上 —— */
  .process-rail {
    position: relative;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-7);
  }

  .process-rail::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 6px;
    right: 6px;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--color-border-on-light),
      rgba(var(--color-accent-rgb), var(--alpha-line)),
      var(--color-border-on-light)
    );
  }

  .pstep {
    position: relative;
    padding-top: var(--space-6);
  }

  /* 节点：环 → 随 reveal 级差点亮为实心（序列叙事） */
  .pstep-node {
    position: absolute;
    top: 0;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2px solid rgba(var(--color-accent-rgb), 0.35);
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .pstep.reveal.visible .pstep-node {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 0 5px rgba(var(--color-accent-rgb), 0.1);
    transition-delay: var(--reveal-delay, 0s);
  }

  .pstep-num {
    display: block;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .pstep h3 {
    font-size: 17px;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-2);
  }

  .pstep p {
    font-size: var(--text-body-s);
    line-height: 1.65;
    color: var(--color-text-muted-on-light);
    margin: 0;
  }

  @media (max-width: 1120px) {
    .process-rail {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-7) var(--space-6);
    }
    .process-rail::before {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .process {
      padding: var(--space-8) 0;
    }
    /* 移动端：竖排时间线（左缘细线，节点骑线） */
    .process-rail {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .pstep {
      padding: 0 0 0 var(--space-6);
      border-left: 1px solid var(--color-border-on-light);
    }
    .pstep-node {
      top: 2px;
      left: -6px;
    }
  }
</style>
