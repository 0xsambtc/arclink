---
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
  /** 防白闪底色（首帧即着色）：dark=首页深底，light=子页浅底 */
  bg?: 'dark' | 'light';
}

const {
  title = 'ARCLINK — Execution Infrastructure for the Real World',
  description = 'Arclink helps enterprises plan, deploy, and verify on-the-ground operations—from data collection to field verification and outreach—at scale through a trusted network of operators.',
  lang = 'en',
  noindex = false,
  bg = 'dark',
} = Astro.props;

// 与 tokens.css 的 --color-bg / --color-surface-alt 同值（CSS 未加载前的首帧读不到变量，此处为唯一允许的字面量）
const BG_HEX = { dark: '#030b1d', light: '#f3f7ff' } as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 预览期全站 noindex（workers.dev 阶段）；M5 正式域名上线时移除，见 docs/TODO.md -->
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={BG_HEX[bg]} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    {/* 分享卡片：B2B 链接必经 Slack/邮件/LinkedIn 转发，无 OG 即裸链 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arclink" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/brand/og-card.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    {/* 防白/防黑闪：CSS 加载前首帧即着页面底色（docs/02 性能要点） */}
    <style is:inline set:html={`html{background:${BG_HEX[bg]}}`}></style>
    {/* 无 JS（含多数爬虫）时 reveal 内容直出，不永久隐藏 */}
    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      // Scroll reveal 观察器（配合 global.css 的 .reveal）
      const revealObserver = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          }),
        { threshold: 0.15 }
      );
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
    </script>
  </body>
</html>
