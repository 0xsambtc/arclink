---
// 法律文档布局（隐私政策 / 服务条款）— markdown 页面经 frontmatter layout 使用；正文原文来自 PM，勿改写
import Base from './Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Footer from '../components/sections/Footer.astro';
import { site } from '../data/site';

interface Props {
  frontmatter: { title: string; description?: string };
}

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} — ${site.name}`} description={frontmatter.description ?? site.description} bg="light">
  <SiteHeader solid />
  <main id="main" class="legal-main">
    <article class="shell legal-article">
      <slot />
    </article>
  </main>
  <Footer />
</Base>

<style>
  .legal-main {
    background: var(--color-surface-alt);
    color: var(--color-text-on-light);
    padding: calc(var(--header-h) + var(--space-7)) 0 var(--space-9);
  }

  /* 行长约束在 68ch（≈80 字符/行），长文阅读舒适区 */
  .legal-article {
    max-width: 68ch;
  }

  .legal-article :global(h1) {
    font-size: clamp(32px, 3.2vw, 44px);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-3);
  }

  .legal-article :global(h2) {
    font-size: 22px;
    letter-spacing: var(--tracking-tight);
    margin: var(--space-7) 0 var(--space-3);
  }

  /* 法律正文是尽调必读内容：用正文主色，muted 留给表格与 meta 行 */
  .legal-article :global(p),
  .legal-article :global(li) {
    font-size: 16px;
    line-height: 1.8;
    color: var(--color-text-on-light);
  }

  .legal-article :global(ul) {
    padding-left: 22px;
  }

  .legal-article :global(a) {
    color: var(--color-accent);
  }

  .legal-article :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-size: 14px;
  }

  .legal-article :global(th),
  .legal-article :global(td) {
    text-align: left;
    min-width: 140px;
    padding: 10px 14px;
    border: 1px solid var(--color-border-on-light);
    color: var(--color-text-muted-on-light);
    line-height: 1.6;
  }

  .legal-article :global(th) {
    background: var(--color-surface-tint);
    color: var(--color-text-on-light);
  }
</style>
