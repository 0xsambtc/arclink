---
// 404 — wrangler not_found_handling 指向的页面；文案走 geo 隐喻保持品牌感
// 带完整导航骨架：拿错链接的高意向访客（邮件/口传 URL）应能直达转化页
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Footer from '../components/sections/Footer.astro';
---

<Base title="404 — Page not found | ARCLINK" description="The page you are looking for could not be found.">
  <SiteHeader solid />
  <main id="main" class="not-found">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1>This location isn't mapped yet.</h1>
      <p class="copy">The page you're looking for doesn't exist or has moved.</p>
      <a class="home-link" href="/">← Back to home</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .not-found {
    min-height: calc(100vh - 180px);
    display: grid;
    align-items: center;
    padding-top: var(--header-h);
    color: var(--color-text-on-dark);
    background: radial-gradient(
      circle at 50% 30%,
      var(--color-glow) 0,
      var(--color-bg) 45%,
      var(--color-bg-deep) 100%
    );
    text-align: center;
  }

  h1 {
    font-size: clamp(36px, 4vw, 56px);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-4);
  }

  .copy {
    color: var(--color-text-muted-on-dark);
    margin: 0 0 var(--space-6);
  }

  .home-link {
    color: var(--color-accent-bright);
    font-weight: 700;
    text-decoration: none;
  }

  .home-link:hover {
    text-decoration: underline;
  }
</style>
