---
// M2 变体 A —「勘测年鉴」融合版（docs/10 裁决：甲·年鉴主调 + 乙·地面站两个 signature）
// 自包含调性变体页：仅本文件。数据唯一来源 = src/data/coverage.ts；图形唯一来源 = src/lib/arcfield.ts
// 宣言（提案首行）：页面上的任何元素，要么是排版系统本身（字、网格、编号、细线），
// 要么是带真实出处（城市·坐标·时间戳·口径）的编号图版（FIG.）；两者都不是——删。
import Base from '../../layouts/Base.astro';
import { cities, events, metrics, cityByCode } from '../../data/coverage';
import { arcBetween, hashString, mulberry32, project } from '../../lib/arcfield';

const MAP_W = 1000;
const MAP_H = 500;

const fmtNum = (n: number) => n.toLocaleString('en-US');
const fmtLat = (lat: number) => `${Math.abs(lat).toFixed(4)}°${lat >= 0 ? 'N' : 'S'}`;
const fmtLng = (lng: number) => `${Math.abs(lng).toFixed(4)}°${lng >= 0 ? 'E' : 'W'}`;
const shortUtc = (utc: string) => `${utc.slice(5, 16).replace('T', ' ')}Z`; // 2026-07-14T09:32Z → 07-14 09:32Z

// —— 区域划分（可操作覆盖台，地面站 signature 2）——
const regionOf: Record<string, string> = {
  ID: 'sea', SG: 'sea', TH: 'sea', VN: 'sea', PH: 'sea', MY: 'sea',
  AE: 'me', SA: 'me',
  KE: 'africa', NG: 'africa',
  BR: 'latam', MX: 'latam',
};
const regionDefs = [
  { id: 'all', label: 'ALL REGIONS' },
  { id: 'sea', label: 'SOUTHEAST ASIA' },
  { id: 'me', label: 'MIDDLE EAST' },
  { id: 'africa', label: 'AFRICA' },
  { id: 'latam', label: 'LATIN AMERICA' },
];

// —— 城市 → 平面投影点（arcfield.project，等距圆柱）——
const cityPts = cities.map((c) => {
  const [x, y] = project(c.lat, c.lng, MAP_W, MAP_H);
  return {
    ...c,
    x,
    y,
    region: regionOf[c.country],
    record: `${c.name.toUpperCase()} — ${c.code} · ${fmtLat(c.lat)} ${fmtLng(c.lng)} · ${c.country}`,
  };
});
const ptByCode = Object.fromEntries(cityPts.map((p) => [p.code, p]));

// —— 交付事件 → 弧线（arcBetween，lift 由记录种子确定，同种子同输出）——
const eventArcs = events.map((e, i) => {
  const a = ptByCode[e.from];
  const b = ptByCode[e.to];
  const r = mulberry32(hashString(`${e.from}-${e.to}-${e.utc}`))();
  const d = arcBetween(a.x, a.y, b.x, b.y, -(0.12 + r * 0.12));
  return {
    ...e,
    i,
    d,
    regions: [...new Set([a.region, b.region])].join(' '),
    caption: `${e.from} ↔ ${e.to} · ${fmtNum(e.km)} KM · ${e.utc}`,
    short: `${e.from} ↔ ${e.to} · ${fmtNum(e.km)} KM · ${shortUtc(e.utc)}`,
  };
});

const totalKm = events.reduce((s, e) => s + e.km, 0);
const maxKm = Math.max(...events.map((e) => e.km));
const lastUtc = events.map((e) => e.utc).sort().at(-1) ?? '';

// —— 区域读数（覆盖台侧栏，构建时预计算）——
const regionStats = Object.fromEntries(
  regionDefs.map((rg) => {
    const evs = rg.id === 'all' ? eventArcs : eventArcs.filter((e) => e.regions.split(' ').includes(rg.id));
    const nodes = rg.id === 'all' ? cityPts : cityPts.filter((p) => p.region === rg.id);
    return [
      rg.id,
      {
        label: rg.label,
        nodes: String(nodes.length),
        records: String(evs.length),
        km: `${fmtNum(evs.reduce((s, e) => s + e.km, 0))} KM`,
        last: evs.map((e) => e.utc).sort().at(-1) ?? '—',
      },
    ];
  })
);

// —— 图版裁切（全图 1000×500 → 覆盖区域 + 图边留白）——
const xs = cityPts.map((p) => p.x);
const ys = cityPts.map((p) => p.y);
const vb = {
  x: Math.min(...xs) - 70,
  y: Math.min(...ys) - 70,
  w: Math.max(...xs) - Math.min(...xs) + 140,
  h: Math.max(...ys) - Math.min(...ys) + 125,
};
const viewBox = `${vb.x.toFixed(0)} ${vb.y.toFixed(0)} ${vb.w.toFixed(0)} ${vb.h.toFixed(0)}`;
const gratLng = [-120, -90, -60, -30, 0, 30, 60, 90, 120, 150]
  .map((lng) => ({ lng, x: ((lng + 180) / 360) * MAP_W }))
  .filter((g) => g.x > vb.x && g.x < vb.x + vb.w);
const gratLat = [30, 0, -30]
  .map((lat) => ({ lat, y: ((90 - lat) / 180) * MAP_H }))
  .filter((g) => g.y > vb.y && g.y < vb.y + vb.h);
const lngLabel = (lng: number) => (lng === 0 ? '0°' : `${Math.abs(lng)}°${lng > 0 ? 'E' : 'W'}`);
const labeledMeridians = [-90, 0, 60, 120];

// 城市代码标签的手动避让（SEA 簇密集）
const labelPos: Record<string, { dx: number; dy: number; anchor: 'start' | 'end' }> = {
  JKT: { dx: 7, dy: 12, anchor: 'start' },
  SIN: { dx: 8, dy: 5, anchor: 'start' },
  BKK: { dx: -3, dy: -9, anchor: 'end' },
  SGN: { dx: 8, dy: -5, anchor: 'start' },
  MNL: { dx: 8, dy: 2, anchor: 'start' },
  KUL: { dx: -8, dy: 2, anchor: 'end' },
  DXB: { dx: 8, dy: -5, anchor: 'start' },
  RUH: { dx: -8, dy: 5, anchor: 'end' },
  NBO: { dx: 8, dy: 9, anchor: 'start' },
  LOS: { dx: -8, dy: 5, anchor: 'end' },
  SAO: { dx: 8, dy: 7, anchor: 'start' },
  MEX: { dx: -8, dy: -7, anchor: 'end' },
};

// —— SEC.01 规格表（specimen）——
const specimenRows = [
  { idx: 'IDX.01', label: 'Node cities', value: metrics.citiesCovered, note: 'DISTINCT METROS WITH ACTIVE FIELD TEAMS' },
  { idx: 'IDX.02', label: 'Countries', value: metrics.countries, note: 'OPERATING JURISDICTIONS, CURRENT EDITION' },
  { idx: 'IDX.03', label: 'Tasks completed', value: metrics.tasksCompleted, note: 'CUMULATIVE VERIFIED CLOSE-OUTS' },
  { idx: 'IDX.04', label: 'Record kilometres', value: totalKm, note: `SUM OF ${events.length} PUBLISHED DELIVERY RECORDS` },
];

// —— SEC.02 工程图版（采集 → 验证 → 交付）——
const methodY = 150;
const phases = [
  { n: 'PH.01', name: 'COLLECT', x: 110, note: 'FIELD CAPTURE · GNSS + UTC TIMESTAMP', body: 'Local field teams capture ground truth on-site — position, evidence and timestamps bound into a single trace.' },
  { n: 'PH.02', name: 'VERIFY', x: 450, note: 'DUAL-SOURCE MATCH · CHECKSUM', body: 'Every trace is cross-checked against a second source before it is allowed to enter the atlas. No match, no record.' },
  { n: 'PH.03', name: 'DELIVER', x: 790, note: 'SIGNED MANIFEST · SLA HANDOFF', body: 'Verified packets are handed over with a signed manifest — the same record you can audit on this page.' },
];
const methodArcs = [
  { d: arcBetween(110, methodY, 450, methodY, -0.26), label: 'RAW TRACE', lx: 280, ly: 96 },
  { d: arcBetween(450, methodY, 790, methodY, -0.26), label: 'VERIFIED PACKET', lx: 620, ly: 96 },
];
const exemplar = eventArcs[0];

const buildDate = new Date().toISOString().slice(0, 10);
const globePayload = { cities: cities.map((c) => ({ lat: c.lat, lng: c.lng })) };
const heroStatus = `ARCLINK ANNUAL — SEC.00 / FRONTISPIECE · INIT ${fmtLat(cityByCode.SIN.lat)} ${fmtLng(cityByCode.SIN.lng)} · LINK UP · ${metrics.citiesCovered} NODES`;
const defaultRecord = eventArcs.find((e) => e.utc === lastUtc)?.caption ?? eventArcs[0].caption;
---

<Base noindex title="M2 · Atlas — ARCLINK">
  <main id="main" class="atlas">
    <!-- ============ SEC.00 / FRONTISPIECE — 会归档的封面（并入地面站开机序列） ============ -->
    <section class="sec sec-hero" data-folio="00">
      <div class="shell hero-shell">
        <p class="hero-status mono-caption"><span class="js-status">{heroStatus}</span></p>

        <figure class="hero-figure">
          <div class="fig-frame-border" aria-hidden="true"></div>
          <div class="fig-body-hero">
            <div class="globe-wrap">
              <canvas id="hero-globe" role="img" aria-label={`Rotating globe plotting ${metrics.citiesCovered} Arclink node cities`}></canvas>
            </div>
            <svg class="hero-map-fallback" viewBox={viewBox} role="img" aria-label={`Map of ${metrics.citiesCovered} Arclink node cities`}>
              <g aria-hidden="true">
                {gratLng.map((g) => (
                  <line class="grat-line-dark" x1={g.x} y1={vb.y} x2={g.x} y2={vb.y + vb.h} />
                ))}
                {gratLat.map((g) => (
                  <line class="grat-line-dark" x1={vb.x} y1={g.y} x2={vb.x + vb.w} y2={g.y} />
                ))}
              </g>
              {cityPts.map((p) => (
                <g transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
                  <circle class="fb-dot" r="3" />
                  <text
                    class="fb-label"
                    x={labelPos[p.code].dx}
                    y={labelPos[p.code].dy}
                    text-anchor={labelPos[p.code].anchor}
                  >
                    {p.code}
                  </text>
                </g>
              ))}
            </svg>
          </div>
          <figcaption class="hero-figcaption mono-caption">
            <span>FIG.01 — NETWORK FRONTISPIECE · {metrics.citiesCovered} NODES</span>
            <span>AS OF {metrics.asOf}</span>
          </figcaption>
        </figure>

        <div class="hero-title-block">
          <h1 class="hero-title" aria-label="ARCLINK">
            {'ARCLINK'.split('').map((ch) => (
              <span class="hero-letter-mask" aria-hidden="true"><span class="hero-letter">{ch}</span></span>
            ))}
          </h1>
        </div>

        <div class="hero-bottom">
          <div class="hero-intro">
            <p class="hero-deck">
              Execution infrastructure for the physical world. Every figure in this annual is a published
              record — city, kilometre, UTC timestamp — collected in the field, verified twice, delivered signed.
            </p>
            <div class="hero-links">
              <a class="hero-jump mono-caption" href="#coverage">SEC.03 — OPEN THE COVERAGE PLATE ↓</a>
            </div>
          </div>
          <aside class="hero-log" aria-label="Published delivery records">
            <p class="hero-log-title mono-caption">LOG — DELIVERY RECORDS ({events.length})</p>
            <ol class="log-lines">
              {eventArcs.map((e) => (
                <li class="log-line mono-caption" title={e.caption}>
                  <span class="log-idx">R.{String(e.i + 1).padStart(2, '0')}</span>
                  <span>{e.short}</span>
                </li>
              ))}
            </ol>
          </aside>
        </div>
      </div>
    </section>

    <!-- ============ SEC.01 / INDEX — 信任数字规格表（specimen） ============ -->
    <section class="sec sec-index" data-folio="01">
      <div class="shell">
        <header class="sec-head mono-caption" data-reveal>
          <span>SEC.01 / INDEX — ARCLINK ANNUAL</span>
          <span>EDITION 2026</span>
        </header>

        <div class="index-head">
          <div>
            <h2 class="sec-title" data-reveal>The network, counted.</h2>
            <p class="sec-lede" data-reveal>
              No projections, no rounded-up market claims. The index below is the network as it stands —
              each count traceable to the records published in this edition.
            </p>
          </div>
          <figure class="fig fig-ticks" data-reveal>
            <div class="ticks" role="img" aria-label={`Kilometres per delivery record, ${events.length} records, maximum ${fmtNum(maxKm)} kilometres`}>
              {eventArcs.map((e) => (
                <span
                  class="tick"
                  style={`height:${Math.round(10 + (e.km / maxKm) * 78)}px`}
                  title={`R.${String(e.i + 1).padStart(2, '0')} · ${e.caption}`}
                ></span>
              ))}
            </div>
            <figcaption class="fig-cap mono-caption">
              <span>FIG.02 — KM PER RECORD · R.01–R.{String(events.length).padStart(2, '0')}</span>
              <span>MAX {fmtNum(maxKm)} KM</span>
            </figcaption>
          </figure>
        </div>

        <ol class="spec-list">
          {specimenRows.map((row) => (
            <li class="spec-row" data-reveal>
              <span class="spec-idx mono-caption">{row.idx}</span>
              <span class="spec-label">{row.label}</span>
              <span class="spec-value"><span class="spec-num" data-count={row.value}>{fmtNum(row.value)}</span></span>
              <span class="spec-note mono-caption">{row.note}</span>
            </li>
          ))}
        </ol>
        <p class="spec-footnote mono-caption" data-reveal>
          AS OF {metrics.asOf} UTC — COUNTS ARE PUBLISHED RECORDS, NOT PROJECTIONS · METHODOLOGY: SEC.02
        </p>
      </div>
    </section>

    <!-- ============ SEC.02 / METHOD — 工程图版：采集 → 验证 → 交付 ============ -->
    <section class="sec sec-method" data-folio="02">
      <div class="shell">
        <header class="sec-head mono-caption" data-reveal>
          <span>SEC.02 / METHOD — ARCLINK ANNUAL</span>
          <span>EDITION 2026</span>
        </header>
        <h2 class="sec-title" data-reveal>Collected. Verified. Delivered.</h2>
        <p class="sec-lede" data-reveal>
          Three phases, one contract: nothing enters the atlas that cannot be traced back to a field capture.
        </p>

        <figure class="fig fig-method" data-reveal>
          <div class="fig-body-method">
            <svg viewBox="0 0 900 250" role="img" aria-label="Method diagram: collect, verify, deliver — connected by two arcs labelled raw trace and verified packet">
              <line class="method-base" x1="60" y1={methodY} x2="840" y2={methodY} aria-hidden="true" />
              {methodArcs.map((a) => (
                <g aria-hidden="true">
                  <path class="method-arc" d={a.d} />
                  <text class="m-flow" x={a.lx} y={a.ly} text-anchor="middle">{a.label}</text>
                </g>
              ))}
              {phases.map((ph) => (
                <g>
                  <circle class="method-ring" cx={ph.x} cy={methodY} r="16" />
                  <circle class="method-dot" cx={ph.x} cy={methodY} r="6" />
                  <text class="m-label" x={ph.x} y={methodY + 38} text-anchor="middle">{ph.n} — {ph.name}</text>
                  <text class="m-note" x={ph.x} y={methodY + 56} text-anchor="middle">{ph.note}</text>
                </g>
              ))}
            </svg>
          </div>
          <figcaption class="fig-cap mono-caption">
            <span>FIG.03 — METHOD DIAGRAM</span>
            <span>EXEMPLAR RECORD: {exemplar.caption}</span>
          </figcaption>
        </figure>

        <div class="method-cols">
          {phases.map((ph) => (
            <div class="phase" data-reveal>
              <p class="phase-tag mono-caption">{ph.n} — {ph.name}</p>
              <p class="phase-body">{ph.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ SEC.03 / COVERAGE — 图版页（全站唯一浅色纸面）+ 可操作覆盖台 ============ -->
    <section class="sec sec-coverage" id="coverage" data-folio="03">
      <div class="shell">
        <header class="sec-head mono-caption" data-reveal>
          <span>SEC.03 / COVERAGE — ARCLINK ANNUAL</span>
          <span>PLATE · EDITION 2026</span>
        </header>
        <h2 class="sec-title" data-reveal>One plate, operable.</h2>
        <p class="sec-lede" data-reveal>
          Select a region to re-read the plate. Every point is a node city, every arc is one published
          delivery record — hover or focus any primitive for its source.
        </p>

        <div class="console-grid">
          <figure class="fig fig-plate" data-reveal>
            <div class="fig-body-plate">
              <svg id="fig04" viewBox={viewBox} role="img" aria-label={`Operable coverage plate: ${metrics.citiesCovered} node cities and ${events.length} delivery records on an equirectangular graticule`}>
                <g aria-hidden="true">
                  {gratLng.map((g) => (
                    <line class="grat-line" x1={g.x} y1={vb.y} x2={g.x} y2={vb.y + vb.h} />
                  ))}
                  {gratLat.map((g) => (
                    <line class="grat-line" x1={vb.x} y1={g.y} x2={vb.x + vb.w} y2={g.y} />
                  ))}
                  {gratLng.filter((g) => labeledMeridians.includes(g.lng)).map((g) => (
                    <text class="grat-label" x={g.x + 5} y={vb.y + vb.h - 8}>{lngLabel(g.lng)}</text>
                  ))}
                  <text class="grat-label" x={vb.x + 6} y={((90 - 0) / 180) * MAP_H - 5}>0°</text>
                </g>
                <g>
                  {eventArcs.map((e) => (
                    <g class="cov-arc-g" data-regions={e.regions} data-record={e.caption} tabindex="0" role="img" aria-label={`Delivery record: ${e.caption}`}>
                      <path class="cov-arc" d={e.d} />
                      <path class="cov-hit" d={e.d} />
                      <title>{e.caption}</title>
                    </g>
                  ))}
                </g>
                <g>
                  {cityPts.map((p) => (
                    <g
                      class="cov-dot-g"
                      data-regions={p.region}
                      data-record={p.record}
                      tabindex="0"
                      role="img"
                      aria-label={`Node city: ${p.record}`}
                      transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}
                    >
                      <g class="cov-dot-inner">
                        <circle class="cov-ring" r="7.5" />
                        <circle class="cov-dot" r="3.4" />
                        <text
                          class="cov-label"
                          x={labelPos[p.code].dx}
                          y={labelPos[p.code].dy}
                          text-anchor={labelPos[p.code].anchor}
                        >
                          {p.code}
                        </text>
                      </g>
                      <title>{p.record}</title>
                    </g>
                  ))}
                </g>
              </svg>
            </div>
            <figcaption class="fig-cap mono-caption">
              <span>FIG.04 — OPERABLE COVERAGE PLATE · EQUIRECTANGULAR · GRATICULE 30°</span>
              <span>AS OF {metrics.asOf}</span>
            </figcaption>
          </figure>

          <aside class="console" data-reveal aria-label="Coverage console">
            <p class="console-title mono-caption">COVERAGE CONSOLE — SELECT REGION</p>
            <div class="region-btns" role="group" aria-label="Filter coverage by region">
              {regionDefs.map((r) => (
                <button type="button" class="region-btn mono-caption" data-region={r.id} aria-pressed={r.id === 'all' ? 'true' : 'false'}>
                  {r.label}
                </button>
              ))}
            </div>
            <dl class="readouts mono-caption">
              <div><dt>REGION</dt><dd id="ro-region">{regionStats.all.label}</dd></div>
              <div><dt>NODES</dt><dd id="ro-nodes">{regionStats.all.nodes}</dd></div>
              <div><dt>RECORDS</dt><dd id="ro-records">{regionStats.all.records}</dd></div>
              <div><dt>DISTANCE</dt><dd id="ro-km">{regionStats.all.km}</dd></div>
              <div><dt>LAST RECORD</dt><dd id="ro-last">{regionStats.all.last}</dd></div>
            </dl>
            <p class="readout-record">
              <span class="readout-record-label mono-caption">POINTER READOUT</span>
              <span id="record-line" class="mono-caption" aria-live="polite">{defaultRecord}</span>
            </p>
          </aside>
        </div>

        <div class="cta-band" data-reveal>
          <div>
            <h3 class="cta-title">The atlas grows every day.</h3>
            <p class="cta-sub">Add your city to the next edition — coverage begins with a single brief.</p>
          </div>
          <div class="cta-col">
            <a class="cta-btn" href="/">Request coverage</a>
            <span class="cta-note mono-caption">SEC.03 / COVERAGE — EDITION 2026</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ COLOPHON — 版权页（一行 mono） ============ -->
    <footer class="colophon" data-folio="04">
      <div class="shell colophon-row">
        <p class="mono-caption colophon-line">
          ARCLINK ANNUAL · EDITION 2026 — M2 VARIANT A «FIELD ATLAS» · DATA AS OF {metrics.asOf} UTC ·
          {cities.length} NODES / {events.length} RECORDS / {fmtNum(totalKm)} KM · SET IN INTER + MONO · BUILT {buildDate}
        </p>
        <p class="mono-caption colophon-end">END — SEC.04 / COLOPHON</p>
      </div>
    </footer>

    <!-- Folio 页码（年鉴翻页锚点，随滚动更新） -->
    <div class="folio mono-caption" aria-hidden="true"><span id="folio-num">00</span>&nbsp;/&nbsp;04</div>
  </main>

  <script type="application/json" id="atlas-data" set:html={JSON.stringify(globePayload)} />

  <!-- 可操作覆盖台（功能而非动效：不依赖 motion 偏好；无 JS 时默认 ALL 全量可见） -->
  <script is:inline define:vars={{ regionStats }}>
    const plate = document.getElementById('fig04');
    const buttons = Array.from(document.querySelectorAll('.region-btn'));
    if (plate && buttons.length) {
      const setRegion = (id) => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.region === id)));
        plate.querySelectorAll('[data-regions]').forEach((el) => {
          const match = id === 'all' || el.dataset.regions.split(' ').includes(id);
          el.classList.toggle('is-dim', !match);
        });
        const s = regionStats[id];
        document.getElementById('ro-region').textContent = s.label;
        document.getElementById('ro-nodes').textContent = s.nodes;
        document.getElementById('ro-records').textContent = s.records;
        document.getElementById('ro-km').textContent = s.km;
        document.getElementById('ro-last').textContent = s.last;
      };
      buttons.forEach((b) => b.addEventListener('click', () => setRegion(b.dataset.region)));

      // Proof of life：hover / focus 任一图元 → 侧栏读出真实记录（城市/km/UTC）
      const line = document.getElementById('record-line');
      plate.querySelectorAll('[data-record]').forEach((el) => {
        const show = () => { line.textContent = el.dataset.record; };
        el.addEventListener('mouseenter', show);
        el.addEventListener('focus', show);
      });
    }
  </script>

  <script>
    // Folio 页码更新（非动效，reduced-motion 下同样工作）
    const folioNum = document.getElementById('folio-num');
    const folioSecs = document.querySelectorAll('[data-folio]');
    if (folioNum && folioSecs.length) {
      const folioObs = new IntersectionObserver(
        (entries) =>
          entries.forEach((en) => {
            if (en.isIntersecting) folioNum.textContent = (en.target as HTMLElement).dataset.folio ?? '00';
          }),
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );
      folioSecs.forEach((s) => folioObs.observe(s));
    }
  </script>

  <script>
    // cobe globe：IntersectionObserver 懒初始化；移动端不初始化（CSS 显示静态 SVG 点阵）；
    // reduced-motion：不旋转、markers 全量直接呈现。
    import createGlobe from 'cobe';

    const figure = document.querySelector('.hero-figure');
    const canvas = document.getElementById('hero-globe') as HTMLCanvasElement | null;
    const dataEl = document.getElementById('atlas-data');

    if (figure && canvas && dataEl && !window.matchMedia('(max-width: 760px)').matches) {
      const payload = JSON.parse(dataEl.textContent || '{"cities":[]}');
      const markers = (payload.cities || []).map((c: { lat: number; lng: number }) => ({
        location: [c.lat, c.lng] as [number, number],
        size: 0.06,
      }));
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          figure.classList.add('globe-on');
          const size = canvas.offsetWidth || 520;
          let phi = 4.4;
          const t0 = performance.now();
          const globe = createGlobe(canvas, {
            devicePixelRatio: 2,
            width: size * 2,
            height: size * 2,
            phi,
            theta: 0.2,
            dark: 1,
            diffuse: 1.2,
            mapSamples: 16000,
            mapBrightness: 4,
            baseColor: [0.05, 0.09, 0.16],
            markerColor: [0.2, 0.47, 1],
            glowColor: [0.08, 0.16, 0.33],
            markers: reduced ? markers : [],
          });
          // cobe v2 无 onRender：自建 rAF 循环驱动旋转 + 开机序列逐城点亮（地面站 signature 1）
          if (!reduced) {
            const tick = () => {
              phi += 0.003;
              const shown = Math.floor((performance.now() - t0 - 900) / 260);
              globe.update({
                phi,
                markers: markers.slice(0, Math.max(0, Math.min(markers.length, shown))),
              });
              requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        },
        { rootMargin: '160px' }
      );
      io.observe(figure);
    }
  </script>

  <script>
    // GSAP 编排 — 全部包在 prefers-reduced-motion: no-preference 内；
    // 初始隐藏态一律由 gsap.set 从 JS 设置（无 JS / reduced-motion 时内容直接可见）。
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const cleanups: Array<() => void> = [];

      // SEC.00 开机序列：mono 状态行 type-on（仅一次）
      const status = document.querySelector('.js-status');
      if (status) {
        const full = status.textContent ?? '';
        const st = { n: 0 };
        status.textContent = '';
        gsap.to(st, {
          n: full.length,
          duration: Math.min(2.4, full.length * 0.022),
          ease: 'none',
          delay: 0.05,
          onUpdate: () => {
            status.textContent = full.slice(0, Math.round(st.n));
          },
        });
      }

      // 巨型字标逐字升起（clip 由 mask 容器完成）
      const letters = gsap.utils.toArray<HTMLElement>('.hero-letter');
      if (letters.length) {
        gsap.set(letters, { yPercent: 112 });
        gsap.to(letters, { yPercent: 0, duration: 0.9, ease: 'power3.out', stagger: 0.06, delay: 0.3 });
      }

      // globe 图版浮现
      gsap.set('.fig-body-hero', { opacity: 0, scale: 0.92 });
      gsap.to('.fig-body-hero', { opacity: 1, scale: 1, duration: 1.1, ease: 'power2.out', delay: 0.8 });

      // 标语与跳转
      gsap.set(['.hero-deck', '.hero-links'], { opacity: 0, y: 18 });
      gsap.to(['.hero-deck', '.hero-links'], { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.12, delay: 1.5 });

      // 右侧 log 逐行追加 + 每 4s 轮转高亮（唯一不停的元素：ticker 本体是数据）
      const logTitle = document.querySelector('.hero-log-title');
      const lines = gsap.utils.toArray<HTMLElement>('.log-line');
      if (logTitle && lines.length) {
        gsap.set(logTitle, { opacity: 0 });
        gsap.to(logTitle, { opacity: 1, duration: 0.4, delay: 1.3 });
        gsap.set(lines, { opacity: 0, x: 14 });
        gsap.to(lines, { opacity: 1, x: 0, duration: 0.45, ease: 'power2.out', stagger: 0.28, delay: 1.4 });
        let live = 0;
        lines[0].classList.add('is-live');
        const cycle = window.setInterval(() => {
          lines[live].classList.remove('is-live');
          live = (live + 1) % lines.length;
          lines[live].classList.add('is-live');
        }, 4000);
        cleanups.push(() => window.clearInterval(cycle));
      }

      // 通用排版入场
      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
        gsap.set(el, { opacity: 0, y: 24 });
        gsap.to(el, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 86%' },
        });
      });

      // 规格表 countUp
      document.querySelectorAll<HTMLElement>('.spec-num').forEach((el) => {
        const end = Number(el.dataset.count || '0');
        const st = { v: 0 };
        el.textContent = '0';
        gsap.to(st, {
          v: end,
          duration: 1.4,
          ease: 'power2.out',
          onUpdate: () => {
            el.textContent = Math.round(st.v).toLocaleString('en-US');
          },
          scrollTrigger: { trigger: el, start: 'top 85%' },
        });
      });

      // FIG.02 刻度条
      const ticks = gsap.utils.toArray<HTMLElement>('.tick');
      if (ticks.length) {
        gsap.set(ticks, { scaleY: 0, transformOrigin: '50% 100%' });
        gsap.to(ticks, {
          scaleY: 1,
          duration: 0.6,
          ease: 'power2.out',
          stagger: 0.04,
          scrollTrigger: { trigger: '.fig-ticks', start: 'top 82%' },
        });
      }

      // 描画：工程图版弧线 + 覆盖台弧线（stroke-dashoffset）
      gsap.utils.toArray<SVGPathElement>('.method-arc, .cov-arc').forEach((p) => {
        const len = p.getTotalLength();
        gsap.set(p, { strokeDasharray: len, strokeDashoffset: len });
        gsap.to(p, {
          strokeDashoffset: 0,
          duration: 1.2,
          ease: 'power2.inOut',
          scrollTrigger: { trigger: p.closest('.fig'), start: 'top 78%' },
        });
      });

      // 覆盖台节点点亮（内层 g，不占用外层 is-dim 的 opacity）
      const dotInners = gsap.utils.toArray<SVGGElement>('.cov-dot-inner');
      if (dotInners.length) {
        gsap.set(dotInners, { opacity: 0, scale: 0.5, transformOrigin: '50% 50%' });
        gsap.to(dotInners, {
          opacity: 1,
          scale: 1,
          duration: 0.5,
          ease: 'power2.out',
          stagger: 0.05,
          scrollTrigger: { trigger: '#fig04', start: 'top 80%' },
        });
      }

      return () => cleanups.forEach((fn) => fn());
    });

    // Signature「归档转场」：滚动离开时封面缩进图框成为 FIG.01（桌面 + 允许动效时）
    mm.add('(prefers-reduced-motion: no-preference) and (min-width: 761px)', () => {
      gsap.set(['.fig-frame-border', '.hero-figcaption'], { opacity: 0 });
      const tl = gsap.timeline({
        scrollTrigger: { trigger: '.sec-hero', start: 'top top', end: 'bottom 38%', scrub: true },
      });
      tl.to('.hero-figure', { scale: 0.74, transformOrigin: '80% 4%', ease: 'none' }, 0)
        .to(['.fig-frame-border', '.hero-figcaption'], { opacity: 1, ease: 'none' }, 0.15)
        .to(['.hero-title-block', '.hero-bottom'], { opacity: 0.16, ease: 'none' }, 0.1);
    });
  </script>
</Base>

