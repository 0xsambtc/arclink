---
// Careers — 页头 + How we work 三原则 + Open Roles 手风琴岗位卡（内容：src/data/careers.ts）
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Footer from '../components/sections/Footer.astro';
import { site } from '../data/site';
import { careers } from '../data/careers';
import '../styles/subpage.css';
---

<Base title={`Careers — ${site.name}`} description={careers.head.description} bg="light">
  <SiteHeader solid />
  <main id="main" class="journey-main">
    <div class="shell">
      <a class="journey-back" href="/"><span class="back-arrow" aria-hidden="true">←</span> Back to home</a>
      <div class="career-head">
        <p class="eyebrow">{careers.head.eyebrow}</p>
        <h1>{careers.head.heading}</h1>
        <p class="career-description">{careers.head.description}</p>
      </div>

      <div class="career-content">
        <section class="career-intro">
          <h2>{careers.howWeWork.heading}</h2>
          <div class="career-principles">
            {
              careers.howWeWork.principles.map((principle) => (
                <article>
                  <strong>{principle.title}</strong>
                  <span>{principle.description}</span>
                </article>
              ))
            }
          </div>
        </section>

        <section class="career-roles">
          <h2 class="eyebrow roles-heading">{careers.openRoles.eyebrow}</h2>
          <div class="roles-list">
            {
              careers.openRoles.roles.map((role, index) => (
                <article class:list={['job-card', index === 0 && 'open']}>
                  <button
                    class="job-head"
                    type="button"
                    aria-expanded={index === 0 ? 'true' : 'false'}
                    aria-controls={`job-body-${index}`}
                  >
                    <span class="job-title">
                      <h3>{role.title}</h3>
                      <span>{role.location}</span>
                    </span>
                    <span class="job-toggle" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 2.5v11M2.5 8h11" /></svg></span>
                  </button>
                  <div class="job-body" id={`job-body-${index}`}>
                    <div class="job-body-inner">
                      <p class="job-overview">{role.overview}</p>
                      <div class="job-cols">
                        <div>
                          <h4>{careers.openRoles.doHeading}</h4>
                          <ul>{role.youWillDo.map((item) => <li>{item}</li>)}</ul>
                        </div>
                        <div>
                          <h4>{careers.openRoles.lookForHeading}</h4>
                          <ul>{role.weLookFor.map((item) => <li>{item}</li>)}</ul>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .career-head {
    max-width: 760px;
  }

  .career-head h1 {
    font-size: var(--text-h1-sub);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-4);
  }

  .career-description {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-text-muted-on-light);
    margin: 0;
  }

  .career-content {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: var(--space-8);
    margin-top: var(--space-8);
    align-items: start;
  }

  .career-intro h2 {
    font-size: var(--text-heading-card);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-5);
  }

  .career-principles {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .career-principles article {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
  }

  .career-principles strong {
    font-size: 16px;
  }

  .career-principles span {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-muted-on-light);
  }

  .roles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .job-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-on-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .job-card:not(.open):hover {
    border-color: rgba(37, 99, 235, 0.45);
  }

  .job-card.open {
    border-color: var(--color-accent);
  }

  .job-head:focus-visible {
    outline-offset: -2px;
  }

  .job-head {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    background: none;
    border: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .job-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .roles-heading {
    margin-bottom: var(--space-5);
  }

  .job-title h3 {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .job-title > span {
    font-size: 13px;
    color: var(--color-text-muted-on-light);
  }

  /* SVG plus 于 32px 圆容器光学居中；开态旋转 45° 成关闭语义（与弹窗关闭钮同语言） */
  .job-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--color-accent);
    transition:
      transform var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .job-toggle svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  .job-head:hover .job-toggle {
    background: rgba(var(--color-accent-rgb), 0.08);
  }

  .job-card.open .job-toggle {
    transform: rotate(45deg);
  }

  /* 展开：grid-template-rows 0fr→1fr 平滑高度过渡 */
  .job-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-panel) var(--ease-out);
  }

  .job-card.open .job-body {
    grid-template-rows: 1fr;
  }

  /* 闭合真正归零：padding-bottom 会成为 0fr 行的最小高度（漏出裁切正文），
     底部空间改由内容自身 margin 承担（margin 可被裁掉） */
  .job-body-inner {
    min-height: 0;
    overflow: hidden;
    padding: 0 var(--space-6);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out) 0.1s;
  }

  .job-card.open .job-body-inner {
    opacity: 1;
  }

  .job-cols {
    margin-bottom: var(--space-6);
  }

  .job-overview {
    font-size: 14px;
    line-height: 1.75;
    color: var(--color-text-muted-on-light);
    margin: 0 0 var(--space-5);
  }

  .job-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }


  .job-cols h4 {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted-on-light);
    margin: 0 0 var(--space-3);
  }

  .job-cols ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .job-cols li {
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-text-muted-on-light);
  }

  @media (max-width: 1120px) {
    .career-content {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  @media (max-width: 760px) {
    .job-cols {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .job-head {
      padding: var(--space-4) var(--space-5);
    }
    .job-body-inner {
      padding: 0 var(--space-5);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.job-card').forEach((card) => {
    const head = card.querySelector<HTMLButtonElement>('.job-head')!;
    const body = card.querySelector<HTMLElement>('.job-body')!;
    // 收起内容对读屏/Tab 真隐藏（视觉隐藏靠 0fr+overflow，语义隐藏靠 inert）
    body.inert = !card.classList.contains('open');
    head.addEventListener('click', () => {
      const open = card.classList.toggle('open');
      // 单开：比较岗位时上下文不散
      if (open) {
        document.querySelectorAll<HTMLElement>('.job-card.open').forEach((other) => {
          if (other === card) return;
          other.classList.remove('open');
          other.querySelector('.job-head')?.setAttribute('aria-expanded', 'false');
          const otherBody = other.querySelector<HTMLElement>('.job-body');
          if (otherBody) otherBody.inert = true;
        });
      }
      head.setAttribute('aria-expanded', String(open));
      body.inert = !open;
    });
  });
</script>
