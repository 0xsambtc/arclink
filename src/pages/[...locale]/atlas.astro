---
// 勘测年鉴（设计候选）—— 单一源文件产出双语两个静态 URL：/atlas 与 /zh/atlas
// 每语言独立 URL 是 SEO 与 AI 搜索的硬要求（见 docs/08）；纸样（PAPER/NIGHT）为运行时切换，不占路由
import Base from '../../layouts/Base.astro';
import AtlasPage from '../../components/m2/AtlasPage.astro';
import { atlasCopy } from '../../data/m2-atlas.copy';

export function getStaticPaths() {
  return [
    { params: { locale: undefined }, props: { locale: 'en' as const } },
    { params: { locale: 'zh' }, props: { locale: 'zh' as const } },
  ];
}

const { locale } = Astro.props;
const t = atlasCopy[locale];
---

<Base
  noindex
  stock="paper"
  bg="#f3f5f9"
  lang={locale}
  title={t.meta.title}
  description={t.meta.description}
>
  <AtlasPage locale={locale} />
</Base>
