---
// 地面站（对照参照）—— 单一源文件产出双语两个静态 URL：/station 与 /zh/station
// Base/noindex/title 由 StationPage 依 locale 内部设置
import StationPage from '../../components/m2/StationPage.astro';

export function getStaticPaths() {
  return [
    { params: { locale: undefined }, props: { locale: 'en' as const } },
    { params: { locale: 'zh' }, props: { locale: 'zh' as const } },
  ];
}

const { locale } = Astro.props;
---

<StationPage locale={locale} />
